   "type": "functionalsafety_Assumption",
   "spdxId": "zephyr:assumptions/AOU-1",
   "creationInfo": "zephyr:fs-creationinfo",
   "name": "AoU-1: Memory isolation configured by integrator",
   "functionalsafety_assumptionStatement": "The application integrator configures the MPU/MMU so that safety-critical threads are isolated from non-safety-critical ones.",
   "functionalsafety_rationale": "Documented as an assumption of use for the Zephyr safety element out of context (SEooC).",
