          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-13"
        }
      ],
      "name": "ZEP-SRS-9-13: Memory slab initialization at run time",
      "summary": "Memory slab initialization at run time"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-14",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to allocate a fixed-size block from a memory slab, accepting a timeout that specifies the maximum time to wait for a free block.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-14"
        }
      ],
      "name": "ZEP-SRS-9-14: Memory slab block allocation",
      "summary": "Memory slab block allocation"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-15",
      "requirementStatement": "When no block becomes available in a memory slab within the specified time, the Zephyr RTOS shall return an error indicating that no block was allocated.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-15"
        }
      ],
      "name": "ZEP-SRS-9-15: Memory slab allocation timeout expiry",
      "summary": "Memory slab allocation timeout expiry"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-16",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to release a previously allocated block back to its memory slab.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-16"
        }
      ],
      "name": "ZEP-SRS-9-16: Memory slab block free",
      "summary": "Memory slab block free"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-3",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to define and initialize a memory heap at compile time.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-3"
        }
      ],
      "name": "ZEP-SRS-9-3: Heap definition at compile time",
      "summary": "Heap definition at compile time"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-4",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to initialize a memory heap at run time over a caller-provided memory region.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-4"
        }
      ],
      "name": "ZEP-SRS-9-4: Heap initialization at run time",
      "summary": "Heap initialization at run time"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-5",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to allocate a block of memory of a requested size from a heap.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-5"
        }
      ],
      "name": "ZEP-SRS-9-5: Heap allocation",
      "summary": "Heap allocation"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-6",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to allocate a block of memory from a heap with a requested alignment.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-6"
        }
      ],
      "name": "ZEP-SRS-9-6: Heap aligned allocation",
      "summary": "Heap aligned allocation"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-7",
      "requirementStatement": "When allocating memory from a heap, the Zephyr RTOS shall accept a timeout that specifies the maximum time to wait for sufficient memory to become available.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-7"
        }
      ],
      "name": "ZEP-SRS-9-7: Heap allocation timeout",
      "summary": "Heap allocation timeout"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-9-9",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to resize a previously allocated heap block while preserving its contents up to the smaller of the old and new sizes.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-9-9"
        }
      ],
      "name": "ZEP-SRS-9-9: Heap reallocation",
      "summary": "Heap reallocation"
    },
