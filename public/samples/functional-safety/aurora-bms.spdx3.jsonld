  {
   "type": "Requirement",
   "spdxId": "bms:requirements/SG-01",
   "name": "SG-01: Overcharge protection",
   "summary": "Overcharge protection",
   "requirementStatement": "The Aurora BMS shall prevent any battery cell voltage from exceeding the maximum safe charging voltage.",
   "externalIdentifier": [
    {
     "type": "ExternalIdentifier",
     "externalIdentifierType": "other",
     "comment": "Requirement management UID",
     "identifier": "NW-SG-01"
    }
   ],
   "rationale": "Safety goal derived from the hazard analysis and risk assessment; classified ASIL D with a fault-tolerant time interval of 200 ms.",
   "creationInfo": "bms:creationinfo"
  },
  {
   "type": "Requirement",
   "spdxId": "bms:requirements/SG-02",
   "name": "SG-02: Over-temperature protection",
   "summary": "Over-temperature protection",
   "requirementStatement": "The Aurora BMS shall prevent any battery module temperature from exceeding its safe operating limit.",
   "externalIdentifier": [
    {
     "type": "ExternalIdentifier",
     "externalIdentifierType": "other",
     "comment": "Requirement management UID",
     "identifier": "NW-SG-02"
    }
   ],
   "rationale": "Safety goal derived from the hazard analysis and risk assessment; classified ASIL D with a fault-tolerant time interval of 500 ms.",
   "creationInfo": "bms:creationinfo"
  },
  {
   "type": "Requirement",
   "spdxId": "bms:requirements/SG-03",
   "name": "SG-03: Over-current protection",
   "summary": "Over-current protection",
   "requirementStatement": "The Aurora BMS shall prevent the traction-battery pack current from exceeding its safe operating limit.",
   "externalIdentifier": [
    {
     "type": "ExternalIdentifier",
     "externalIdentifierType": "other",
     "comment": "Requirement management UID",
     "identifier": "NW-SG-03"
    }
   ],
   "rationale": "Safety goal derived from the hazard analysis and risk assessment; classified ASIL C with a fault-tolerant time interval of 100 ms.",
   "creationInfo": "bms:creationinfo"
  },
  {
   "type": "Requirement",
   "spdxId": "bms:requirements/SG-04",
   "name": "SG-04: Safe high-voltage disconnection",
   "summary": "Safe high-voltage disconnection",
   "requirementStatement": "The Aurora BMS shall isolate the traction battery by opening the main contactors upon detection of a critical fault within the fault-tolerant time interval.",
   "externalIdentifier": [
    {
     "type": "ExternalIdentifier",
     "externalIdentifierType": "other",
     "comment": "Requirement management UID",
     "identifier": "NW-SG-04"
    }
   ],
   "rationale": "Safety goal derived from the hazard analysis and risk assessment; classified ASIL D with a fault-tolerant time interval of 100 ms.",
   "creationInfo": "bms:creationinfo"
  },
  {
   "type": "Requirement",
   "spdxId": "bms:requirements/SG-05",
   "name": "SG-05: Isolation monitoring",
   "summary": "Isolation monitoring",
   "requirementStatement": "The Aurora BMS shall detect a loss of electrical isolation between the high-voltage system and the vehicle chassis.",
   "externalIdentifier": [
    {
     "type": "ExternalIdentifier",
     "externalIdentifierType": "other",
     "comment": "Requirement management UID",
     "identifier": "NW-SG-05"
    }
   ],
   "rationale": "Safety goal derived from the hazard analysis and risk assessment; classified ASIL C with a fault-tolerant time interval of 1000 ms.",
   "creationInfo": "bms:creationinfo"
  },
  {
   "type": "Requirement",
   "spdxId": "bms:requirements/FSR-01-1",
   "name": "FSR-01-1: Cyclic cell-voltage acquisition",
   "summary": "Cyclic cell-voltage acquisition",
   "requirementStatement": "The BMS shall acquire the voltage of every battery cell at least once every 100 ms.",
   "externalIdentifier": [
    {
     "type": "ExternalIdentifier",
     "externalIdentifierType": "other",
     "comment": "Requirement management UID",
     "identifier": "NW-FSR-01-1"
    }
   ],
   "rationale": "Functional safety requirement decomposed from safety goal SG-01.",
   "creationInfo": "bms:creationinfo"
  },
