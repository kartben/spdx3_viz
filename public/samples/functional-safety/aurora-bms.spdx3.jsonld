   "spdxId": "bms:assumptions/AOU-4",
   "name": "AOU-4: Lockstep enabled and wired",
   "functionalsafety_assumptionStatement": "The microcontroller lockstep core pair is enabled and its error output is wired to the vehicle safe-state circuit.",
   "rationale": "Documented as an assumption of use for the Aurora BMS safety element.",
