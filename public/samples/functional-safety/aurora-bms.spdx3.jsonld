  {
   "type": "Requirement",
   "spdxId": "bms:requirements/FSR-01-3",
   "name": "FSR-01-3: Charge-current limiting",
   "summary": "Charge-current limiting",
   "requirementStatement": "The BMS shall request a charging current of zero when any cell voltage exceeds 4.20 V.",
   "externalIdentifier": [
    {
     "type": "ExternalIdentifier",
     "externalIdentifierType": "other",
     "comment": "Requirement management UID",
     "identifier": "NW-FSR-01-3"
