   ]
  },
  {
   "type": "Requirement",
   "spdxId": "bms:requirements/FSR-01-2",
   "name": "FSR-01-2: Over-voltage safe state",
   "summary": "Over-voltage safe state",
   "requirementStatement": "The BMS shall transition to the safe state when any cell voltage exceeds 4.25 V.",
   "externalIdentifier": [
    {
     "type": "ExternalIdentifier",
     "externalIdentifierType": "other",
     "comment": "Requirement management UID",
     "identifier": "NW-FSR-01-2"
    }
   ],
   "rationale": "Functional safety requirement decomposed from safety goal SG-01.",
   "creationInfo": "bms:creationinfo"
  },
  {
