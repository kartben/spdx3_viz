    {
      "type": "security_VexFixedVulnAssessmentRelationship",
      "spdxId": "zephyr:relationships/307",
      "security_statusNotes": "mount_volume() caps the FAT size at the FAT32 maximum, so the FAT-area multiply can no longer overflow a DWORD. Fixed by upstream R0.16 patch-2, applied verbatim in this tree.\n",
      "security_assessedElement": "zephyr:packages/fatfs-deps",
      "from": "zephyr:vulnerabilities/CVE-2026-6682",
      "relationshipType": "fixedIn",
      "to": [
        "zephyr:packages/fatfs-deps"
      ],
      "creationInfo": "zephyr:creationinfo",
      "externalRef": [
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://www.runzero.com/advisories/fatfs-fat32-int-of-mnt-cve-2026-6682/"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://github.com/advisories/GHSA-c25x-vcg6-4ccx"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://elm-chan.org/fsw/ff/patches.html"
          ]
        }
      ]
    },
    {
      "type": "security_VexFixedVulnAssessmentRelationship",
      "spdxId": "zephyr:relationships/308",
      "security_statusNotes": "mount_volume() rejects an exFAT volume claiming fewer than MIN_EXFAT clusters, which is what drove sync_fs() into a divide-by-zero. Fixed by upstream R0.16 patch-2, applied verbatim in this tree. Reachable only with exFAT, which is off by default.\n",
      "security_assessedElement": "zephyr:packages/fatfs-deps",
      "from": "zephyr:vulnerabilities/CVE-2026-6683",
      "relationshipType": "fixedIn",
      "to": [
        "zephyr:packages/fatfs-deps"
      ],
      "creationInfo": "zephyr:creationinfo",
      "externalRef": [
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://www.runzero.com/advisories/fatfs-exfat-divide-by-zero-cve-2026-6683"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://github.com/advisories/GHSA-74cg-p8q3-4c3q"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://elm-chan.org/fsw/ff/patches.html"
          ]
        }
      ]
    },
    {
      "type": "security_VexNotAffectedVulnAssessmentRelationship",
      "spdxId": "zephyr:relationships/309",
      "security_impactStatement": "The GPT partition scan loop is already bounded in R0.16, which is the release this tree vendors. NVD scopes the flaw to versions before R0.16, so no code matching the report is present here.\n",
      "security_justificationType": "vulnerableCodeNotPresent",
      "security_assessedElement": "zephyr:packages/fatfs-deps",
      "from": "zephyr:vulnerabilities/CVE-2026-6684",
      "relationshipType": "doesNotAffect",
      "to": [
        "zephyr:packages/fatfs-deps"
      ],
      "creationInfo": "zephyr:creationinfo",
      "externalRef": [
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://www.runzero.com/advisories/fatfs-gpt-scan-loop-dos-cve-2026-6684/"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://github.com/advisories/GHSA-vhc7-qgwj-vx6v"
          ]
        }
      ]
    },
    {
      "type": "security_VexNotAffectedVulnAssessmentRelationship",
      "spdxId": "zephyr:relationships/310",
      "security_impactStatement": "The reported unsigned underflow in the dirty sector-cache range check (cached_sect - sect < cc) is the usual single-comparison range check: a cached sector before the run wraps to a value that is not less than cc, so the branch correctly does not fire, for both the 32-bit and 64-bit LBA_t. The CVE was subsequently rejected by its CNA as an erroneous finding, but is kept here because vulnerability databases still carry it.\n",
      "security_justificationType": "vulnerableCodeNotPresent",
      "security_assessedElement": "zephyr:packages/fatfs-deps",
      "from": "zephyr:vulnerabilities/CVE-2026-6685",
      "relationshipType": "doesNotAffect",
      "to": [
        "zephyr:packages/fatfs-deps"
      ],
      "creationInfo": "zephyr:creationinfo",
      "externalRef": [
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://github.com/advisories/GHSA-rggj-rv54-4gvx"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://nvd.nist.gov/vuln/detail/CVE-2026-6685"
          ]
        }
      ]
    },
    {
      "type": "security_VexFixedVulnAssessmentRelationship",
      "spdxId": "zephyr:relationships/311",
      "security_statusNotes": "f_lseek() zeroes the region exposed when a file is extended past EOF, so a later f_read() cannot disclose residual on-disk data. Fixed by a local delta: upstream documents the expanded area as undefined and has not treated this as a defect, so the fix is expected to stay local.\n",
      "security_assessedElement": "zephyr:packages/fatfs-deps",
      "from": "zephyr:vulnerabilities/CVE-2026-6686",
      "relationshipType": "fixedIn",
      "to": [
        "zephyr:packages/fatfs-deps"
      ],
      "creationInfo": "zephyr:creationinfo",
      "externalRef": [
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://www.runzero.com/advisories/fatfs-uninit-cluster-exposure-cve-2026-6686/"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://github.com/advisories/GHSA-h94p-vjqx-v7rr"
          ]
        }
      ]
    },
    {
      "type": "security_VexFixedVulnAssessmentRelationship",
      "spdxId": "zephyr:relationships/312",
      "security_statusNotes": "f_getlabel() clamps the exFAT volume label to the 11-character maximum instead of trusting XDIR_NumLabel. Fixed by upstream R0.16 patch-2, applied verbatim in this tree. Reachable only with exFAT, which is off by default.\n",
      "security_assessedElement": "zephyr:packages/fatfs-deps",
      "from": "zephyr:vulnerabilities/CVE-2026-6687",
      "relationshipType": "fixedIn",
      "to": [
        "zephyr:packages/fatfs-deps"
      ],
      "creationInfo": "zephyr:creationinfo",
      "externalRef": [
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://www.runzero.com/advisories/fatfs-exfat-label-len-of-cve-2026-6687/"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://github.com/advisories/GHSA-wghw-hg6m-7rh3"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://elm-chan.org/fsw/ff/patches.html"
          ]
        }
      ]
    },
    {
      "type": "security_VexNotAffectedVulnAssessmentRelationship",
      "spdxId": "zephyr:relationships/313",
      "security_impactStatement": "The unbounded copy this CVE describes is in FatFs callers, not in ff.c. Zephyr's FAT front-end sizes its destination from the same Kconfig that bounds the source: FF_MAX_LFN comes from CONFIG_FS_FATFS_MAX_LFN and fs_dirent.name is CONFIG_FS_FATFS_MAX_LFN + 1 bytes, with FF_LFN_UNICODE left at 0 so one character is one byte. A build-time check additionally rejects a CONFIG_FILE_SYSTEM_MAX_FILE_NAME that disagrees with that bound. Integrators that copy FILINFO.fname into their own buffers must make the equivalent check.\n",
      "security_justificationType": "inlineMitigationsAlreadyExist",
      "security_assessedElement": "zephyr:packages/fatfs-deps",
      "from": "zephyr:vulnerabilities/CVE-2026-6688",
      "relationshipType": "doesNotAffect",
      "to": [
        "zephyr:packages/fatfs-deps"
      ],
      "creationInfo": "zephyr:creationinfo",
      "externalRef": [
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://www.runzero.com/advisories/fatfs-long-fn-of-downstream-cve-2026-6688/"
          ]
        },
        {
          "type": "ExternalRef",
          "externalRefType": "securityAdvisory",
          "locator": [
            "https://github.com/advisories/GHSA-8vm2-mjff-2gg2"
          ]
        }
      ]
    },
