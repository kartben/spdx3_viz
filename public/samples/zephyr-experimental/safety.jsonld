    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-sleep-abs",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Verify that k_sleep() with an absolute timeout (K_TIMEOUT_ABS_TICKS) wakes the thread at the requested tick-aligned point in time.\n\n*See also:* k_sleep()\n\n*See also:* K_TIMEOUT_ABS_TICKS",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_sleep_abs"
        }
      ],
      "name": "timer_api__test_sleep_abs",
      "summary": "Test sleeping until an absolute deadline."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-time-conversions",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Exercise the kernel time-unit conversion routines over a large set of source/target frequencies, bit widths and rounding modes, converting values between milliseconds, microseconds, nanoseconds, system ticks and hardware cycles and verifying each result is within the rounding-mode bound.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_time_conversions"
        }
      ],
      "name": "timer_api__test_time_conversions",
      "summary": "Test conversion between time units."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timeout-abs",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Where 64-bit timeouts are enabled, verify that a timeout specified as an absolute point in time (via K_TIMEOUT_ABS_*) yields the expected remaining time until expiry.\n\n*See also:* K_TIMEOUT_ABS_TICKS\n\n*See also:* k_timer_remaining_ticks()",
      "externalIdentifier": [
