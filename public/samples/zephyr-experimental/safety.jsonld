        }
      ],
      "name": "mem_protect_kobj__test_kobject_access_all_grant",
      "summary": "Test supervisor thread grants kernel objects all access public status."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-access-all-grant-error",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Call function with a NULL parameter, an expected fault happened.\n\n*See also:* k_thread_access_all_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_access_all_grant_error"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_access_all_grant_error",
      "summary": "Test grant access to all the kobject for thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-access-grant",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_thread_access_grant() records permission per object, but permission alone is not enough: the object must also be a valid, initialized kernel object of the right type. The granted set here includes a semaphore pointer of the wrong provenance; using it from user mode must fault even though it was granted alongside two genuine objects.\n\nTest steps:\n\n- Grant the current thread a semaphore, a mutex and the bogus semaphore pointer.\n- Drop to user mode and take the bogus semaphore.\n\nExpected result:\n\n- The take faults rather than operating on the invalid object.\n\n*See also:* k_thread_access_grant()\n\n*See also:* k_thread_user_mode_enter()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_access_grant"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_access_grant",
      "summary": "Verify that a grant covers only properly initialized objects."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-access-grant-error-user",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Call function with NULL parameter, an expected fault happened.\n\n*See also:* k_thread_access_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_access_grant_error_user"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_access_grant_error_user",
      "summary": "Test grant access of given NULL thread in usermode."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-access-grant-error-user-null",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Call function with a NULL parameter, an expected fault happened.\n\n*See also:* k_thread_access_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_access_grant_error_user_null"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_access_grant_error_user_null",
      "summary": "Test grant access of given NULL kobject in usermode."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-access-grant-to-invalid-thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Granting or revoking an object for a thread structure that was never initialized as a thread must not blow up, and must not turn that structure into a valid thread object either: validating it afterwards still fails.\n\nTest steps:\n\n- Grant and then revoke the semaphore for an uninitialized k_thread.\n- Validate the structure as a thread object with K_SYSCALL_OBJ().\n\nExpected result:\n\n- The calls complete without side effects and the structure still fails validation.\n\n*See also:* k_object_access_grant()\n\n*See also:* k_object_access_revoke()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_access_grant_to_invalid_thread"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_access_grant_to_invalid_thread",
      "summary": "Verify that grants to an uninitialized thread object are inert."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-access-invalid-kobject",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Test syscall on a kobject which is not present in the hash table.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_access_invalid_kobject"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_access_invalid_kobject",
      "summary": "Object validation checks."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-free-error",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Spawn a thread free a NULL, an expected fault happened.\n\n*See also:* k_object_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_free_error"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_free_error",
      "summary": "Test free an invalid kernel object."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-grant-access-kobj",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A user thread holding permission on an object and on another thread may pass the object on: the child grants the semaphore to a second thread, which must then be able to use it. Granting requires permission on both the object and the receiving thread, so a pass shows the user-mode grant path checks and propagates correctly.\n\nTest steps:\n\n- Grant the parent the semaphore and the extra thread object.\n- Spawn a child that grants the semaphore to the extra thread.\n- Spawn the extra thread and have it use the semaphore.\n\nExpected result:\n\n- The extra thread uses the semaphore granted to it by the child.\n\n*See also:* k_object_access_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_grant_access_kobj"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_grant_access_kobj",
      "summary": "Verify that one user thread can grant an object to another."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-grant-access-kobj-invalid",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Test access grant to thread B from thread A which doesn't have required permissions.\n\n*See also:* k_thread_access_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_grant_access_kobj_invalid"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_grant_access_kobj_invalid",
      "summary": "Test access grant between threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-init-error",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Allocate invalid kernel objects, then no allocation will be returned.\n\n*See also:* k_object_alloc()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_init_error"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_init_error",
      "summary": "Test alloc an invalid kernel object."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-perm-error",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Before grant access of static kobject to user thread, any grant access to this thread, will trigger an expected thread permission error.\n\n*See also:* k_thread_access_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_perm_error"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_perm_error",
      "summary": "Test grant access failed in user mode."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-reinitialize-thread-kobj",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_thread_create() on a thread object that is already alive would rewrite live kernel state. From user mode the syscall boundary must refuse it: the child attempts to create a thread over an object that is currently running and has to fault.\n\nTest steps:\n\n- Spawn a child user thread.\n- Have it call k_thread_create() on an in-use thread object.\n\nExpected result:\n\n- The attempt faults instead of reinitializing the live thread.\n\n*See also:* k_thread_create()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_reinitialize_thread_kobj"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_reinitialize_thread_kobj",
      "summary": "Verify that a user thread cannot reinitialize a running thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-release-from-user",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_object_release() is the user-mode self-revocation: after the child drops its permission on the semaphore, its next use of the object must fault, within the same thread that just used it successfully.\n\nTest steps:\n\n- Grant the semaphore and spawn a child that uses it.\n- Have the child release the semaphore and try to use it again.\n\nExpected result:\n\n- The use before the release succeeds and the one after it faults.\n\n*See also:* k_object_release()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_release_from_user"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_release_from_user",
      "summary": "Verify that a user thread can release its own object permission."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-revoke-access",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A child created with K_INHERIT_PERMS receives the parent's grants at creation time. After the parent revokes its own access to the semaphore, a second child created the same way must no longer receive it: the same operation that succeeded in the first child has to fault in the second.\n\nTest steps:\n\n- Grant the semaphore and spawn a child that uses it successfully.\n- Revoke the parent's access with k_object_access_revoke().\n- Spawn a second child that attempts the same use.\n\nExpected result:\n\n- The first child succeeds; the second faults on the revoked object.\n\n*See also:* k_object_access_revoke()\n\n*See also:* k_thread_access_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_revoke_access"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_revoke_access",
      "summary": "Verify that revoking an object stops inheriting threads using it."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-kobject-revoke-others",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "System grants access to kernel object kobject_sem_extra to first child thread and tests that only that has access but not the second one, then makes it public and tests that both child threads have access, then revokes access from all others and tests that no child thread has access anymore.\n\n*See also:* k_object_access_revoke_others()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_kobject_revoke_others"
        }
      ],
      "name": "mem_protect_kobj__test_kobject_revoke_others",
      "summary": "Test supervisor thread revokes access from all other threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-mark-thread-exit-uninitialized",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When thread exits, the kernel upon thread exit, should mark the exiting thread and thread stack object as uninitialized",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_mark_thread_exit_uninitialized"
        }
      ],
      "name": "mem_protect_kobj__test_mark_thread_exit_uninitialized",
      "summary": "Test when thread exits, kernel marks stack objects uninitialized."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-new-user-thread-with-in-use-stack-obj",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The kernel must prevent new user threads to use initialized (in-use) stack objects. In that case extra_thread is going to be create with in-use stack object child_stack. That will generate error, showing that kernel memory protection is working correctly.",
      "externalIdentifier": [
