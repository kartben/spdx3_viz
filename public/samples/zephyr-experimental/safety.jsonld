    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-25-11",
      "requirementStatement": "When a receiving thread requests a message via a mailbox object and no message is available, the Zephyr RTOS shall block the receiving thread until a message is available or the timeout expires.",
