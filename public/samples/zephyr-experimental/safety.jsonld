    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-lifecycle--test-thread-current-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_current_get() must return the thread id of the caller: the id is stable across repeated calls within one thread, a spawned child observes its own (different) id from inside its entry function, and the parent still reads its own id after the child has run.\nTest steps:\n- Read k_current_get() twice in the current thread and compare.\n- Spawn a child, passing the child's thread id as its argument.\n- The child asserts k_current_get() equals that id.\n- Join the child and verify the parent's id is unchanged and different from the child's.\nExpected result:\n- Each thread sees its own thread id from k_current_get().\nSee also: k_current_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "threads_lifecycle__test_thread_current_get"
        }
      ],
      "name": "threads_lifecycle__test_thread_current_get",
      "summary": "Verify k_current_get() identifies the currently executing thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-lifecycle--test-thread-join",
