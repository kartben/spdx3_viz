    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-access-kobject-without-init-with-access",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The counterpart of the without-access case: here the child holds a valid grant on the semaphore, but the object was never initialized. The syscall boundary checks initialization separately from permission, so the use must still fault.\n\nTest steps:\n\n- Grant the never-initialized semaphore to the current thread.\n- Spawn a child that inherits the grant and takes the semaphore.\n\nExpected result:\n\n- The take faults on the uninitialized object despite the valid grant.\n\n*See also:* k_thread_access_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_access_kobject_without_init_with_access"
        }
      ],
      "name": "mem_protect_kobj__test_access_kobject_without_init_with_access",
      "summary": "Verify that permission does not substitute for initialization."
    },
