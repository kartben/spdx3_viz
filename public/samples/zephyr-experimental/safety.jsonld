      "summary": "Cancellation of a delayable work item"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-25",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to query the time remaining until a scheduled delayable work item is submitted to its work queue.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-26-25"
        }
      ],
      "name": "ZEP-SRS-26-25: Querying the remaining delay of a delayable work item",
