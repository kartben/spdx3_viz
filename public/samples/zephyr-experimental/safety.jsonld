        }
      ],
      "name": "semaphore_1cpu__test_sem_queue_mutual_exclusion",
      "summary": "Test thread mutual exclusion by semaphore."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/semaphore-1cpu--test-sem-take-timeout-isr",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A thread blocks on k_sem_take() with a finite timeout while a helper gives the semaphore from interrupt context before the timeout elapses, so the take must succeed.\nTest steps:\n- Reset the semaphore so its count is zero.\n- Start a helper that gives the semaphore from an ISR.\n- Call k_sem_take() with a finite timeout.\nExpected result:\n- k_sem_take() returns 0 (acquired before the timeout expires).\nSee also: k_sem_take()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "semaphore_1cpu__test_sem_take_timeout_isr"
        }
      ],
      "name": "semaphore_1cpu__test_sem_take_timeout_isr",
      "summary": "Verify k_sem_take() with a timeout is satisfied by an ISR give."
    },
