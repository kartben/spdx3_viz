      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Verify work items are processed in submission order.\n\n*See also:* k_work_queue_start()\n\n*See also:* k_work_init()\n\n*See also:* k_work_submit_to_queue()\n\n*See also:* k_work_queue_drain()",
