    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-scheduling--test-bad-priorities",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The kernel's priority-validity check must accept legal application priorities (and the idle priority only for the idle entry) and reject out-of-range values. The test runs a table of priority/entry combinations through both validity checks and confirms each expected accept/reject result.\nTest steps:\n- Iterate a table of {priority, entry, expected-valid} cases.\n- For each, check the internal validity predicate and the Z_VALID_PRIO macro.\nExpected result:\n- Every case returns its expected validity verdict.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "threads_scheduling__test_bad_priorities"
        }
      ],
      "name": "threads_scheduling__test_bad_priorities",
      "summary": "Verify thread priority validation accepts/rejects the right values."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-scheduling--test-busy-wait-cooperative",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_busy_wait() spins without yielding the CPU. From a cooperative thread (which is never preempted), no other ready thread may run for the whole busy-wait duration, unlike k_sleep() which would let them execute.\nTest steps:\n- Set the current thread to a cooperative priority and spawn worker threads.\n- Call k_busy_wait() for 100 ms.\n- Verify none of the workers executed during the busy-wait.\nExpected result:\n- No other thread runs while the cooperative thread busy-waits.\nSee also: k_busy_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "threads_scheduling__test_busy_wait_cooperative"
        }
      ],
      "name": "threads_scheduling__test_busy_wait_cooperative",
      "summary": "Verify k_busy_wait() in a cooperative thread blocks other threads."
    },
