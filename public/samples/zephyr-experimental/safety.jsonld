      "spdxId": "zephyr:verifications/timer-api--test-timer-expiry-in-isr",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Start a one-shot timer whose expiry callback records, via k_is_in_isr(), whether it executes in interrupt context. After the timer has expired, verify the callback ran and that it observed itself running in interrupt context.\nSee also: k_timer_start(), k_is_in_isr()",
