    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-kobj--test-create-new-essential-thread-from-user",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Aborting an essential thread panics the kernel, so minting one from user mode would let unprivileged code plant a landmine. The child's attempt to create a thread with K_ESSENTIAL must fault at the syscall boundary.\n\nTest steps:\n\n- Spawn a child user thread granted a spare thread object and stack.\n- Have it call k_thread_create() with the K_ESSENTIAL option.\n\nExpected result:\n\n- The attempt faults instead of creating an essential thread.\n\n*See also:* k_thread_create()\n\n*See also:* K_ESSENTIAL",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_create_new_essential_thread_from_user"
        }
      ],
      "name": "mem_protect_kobj__test_create_new_essential_thread_from_user",
      "summary": "Verify that a user thread cannot create an essential thread."
    },
