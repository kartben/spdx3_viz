      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-26-28"
        }
      ],
      "name": "ZEP-SRS-26-28: Cancelling a triggered work item",
      "summary": "Cancelling a triggered work item"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-3",
      "requirementStatement": "The work queue thread shall process the queued work items in the order in which they were submitted.",
