    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-4",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism for a thread to lock a mutex and become its owner.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-4"
        }
      ],
      "name": "ZEP-SRS-6-4: Locking a mutex",
      "summary": "Locking a mutex"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-5",
      "requirementStatement": "While a mutex is not owned by any thread, a thread that locks it shall acquire ownership of the mutex.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-5"
        }
      ],
      "name": "ZEP-SRS-6-5: Locking an unowned mutex",
      "summary": "Locking an unowned mutex"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-6",
      "requirementStatement": "While a mutex is owned by another thread, a thread that attempts to lock it shall be blocked until the mutex becomes available or the specified timeout elapses.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-6"
        }
      ],
      "name": "ZEP-SRS-6-6: Locking a mutex owned by another thread",
      "summary": "Locking a mutex owned by another thread"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-7",
      "requirementStatement": "When locking a mutex, the Zephyr RTOS shall accept a timeout that specifies the maximum time to wait for the mutex to become available.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-7"
        }
      ],
      "name": "ZEP-SRS-6-7: Mutex lock timeout",
      "summary": "Mutex lock timeout"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-8",
      "requirementStatement": "When a mutex does not become available within the specified time, the Zephyr RTOS shall return an error indicating that the mutex was not locked.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-8"
        }
      ],
      "name": "ZEP-SRS-6-8: Mutex lock timeout expiry",
      "summary": "Mutex lock timeout expiry"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-9",
      "requirementStatement": "While a thread owns a mutex, the Zephyr RTOS shall allow that thread to lock the same mutex again, and shall require the thread to unlock it the same number of times before it is released.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-9"
        }
      ],
      "name": "ZEP-SRS-6-9: Recursive mutex locking",
      "summary": "Recursive mutex locking"
    },
