    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-ramp--test-timer-ramp",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Schedules timers in a ramp of delays to verify that within a reasonable range of timeouts are schedulable correctly.\nIt could be that some timer drivers might have difficulty in scheduling some time periods but not others due to implementation details. This test should catch those.\nThe ramp is logrithmic up to what amounts to approximately 10 seconds of ticks.\nSee also: k_timer_start()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_ramp__test_timer_ramp"
        }
      ],
      "name": "timer_ramp__test_timer_ramp",
      "summary": "Test timers can be scheduled in a ramp."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-tick-train--test-one-tick-timer-train",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Schedules timers with absolute scheduling with a 1 tick period. Measures the total time elapsed and tries to run some fake busy work while doing so. If the print outs don't show up or the timer train is late to the station, the test fails.\nSee also: k_timer_start(), K_TIMEOUT_ABS_TICKS",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_tick_train__test_one_tick_timer_train"
        }
      ],
      "name": "timer_tick_train__test_one_tick_timer_train",
      "summary": "Test timers can be scheduled 1 tick apart without issues."
    },
