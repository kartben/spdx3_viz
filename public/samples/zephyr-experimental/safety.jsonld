        }
      ],
      "name": "ZEP-SRS-27-11: Waiting for all of a set of events",
      "summary": "Waiting for all of a set of events"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-27-12",
      "requirementStatement": "When a thread waits on an event object, the Zephyr RTOS shall accept a timeout that specifies the maximum time to wait for the desired set of events.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-27-12"
        }
      ],
      "name": "ZEP-SRS-27-12: Event wait timeout",
      "summary": "Event wait timeout"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-27-13",
      "requirementStatement": "When the timeout of a thread waiting on an event object elapses before the desired set of events is satisfied, the Zephyr RTOS shall report that no matching events were delivered.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-27-13"
        }
      ],
      "name": "ZEP-SRS-27-13: Event wait timeout expiry",
      "summary": "Event wait timeout expiry"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-27-14",
      "requirementStatement": "When a thread waiting on an event object completes its wait successfully, the Zephyr RTOS shall report the set of events that matched the waiting condition.",
