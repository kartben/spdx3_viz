    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-scheduling--test-user-k-is-preempt",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_is_preempt_thread() must report false for a cooperative-priority thread and true for a preemptible-priority thread, when queried from user mode. The test spawns a worker at each priority class and checks the reported value.\nTest steps:\n- Spawn a user worker at the (cooperative) caller priority; expect false.\n- Spawn a user worker at a preemptible priority; expect true.\nExpected result:\n- k_is_preempt_thread() is false for the cooperative thread and true for the preemptible one.\nSee also: k_is_preempt_thread()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "threads_scheduling__test_user_k_is_preempt"
        }
      ],
      "name": "threads_scheduling__test_user_k_is_preempt",
      "summary": "Verify k_is_preempt_thread() reflects priority from user mode."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-scheduling--test-user-k-wakeup",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A user-mode thread must be able to wake another thread that is blocked in k_sleep(K_FOREVER) by calling k_wakeup(). The woken thread proceeds and signals completion.\nTest steps:\n- From a user thread, spawn a user thread that sleeps forever.\n- Call k_wakeup() on it and wait for it to signal it resumed.\nExpected result:\n- The sleeping thread is woken and runs to completion.\nSee also: k_wakeup()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "threads_scheduling__test_user_k_wakeup"
        }
      ],
      "name": "threads_scheduling__test_user_k_wakeup",
      "summary": "Verify k_wakeup() wakes a sleeping thread from user mode."
    },
