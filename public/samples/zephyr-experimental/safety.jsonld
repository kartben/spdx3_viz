      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validates timer without any expiry_fn(set to NULL). expiry_fn() is a function that is invoked each time the timer expires.\nIt initializes the timer with k_timer_init(), then starts the timer using k_timer_start(). Stops the timer using k_timer_stop() and checks for expire_cnt to zero, as expiry_fn was not defined at all.\nSee also: k_timer_init(), k_timer_start(), k_timer_stop(), k_uptime_get(), k_busy_wait()",
      "externalIdentifier": [
        {
