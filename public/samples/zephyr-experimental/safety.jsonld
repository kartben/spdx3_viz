    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api-1cpu--test-mutex-priority-inheritance",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "To verify mutex provide priority inheritance to prevent priority inversion, and there are 3 cases need to run. The thread T1 hold the mutex first and cases list as below:\n\n- case 1. When priority T2 > T1, priority inheritance happened.\n- case 2. When priority T1 > T2, priority inheritance won't happened.\n- case 3. When priority T2 > T3 > T1, priority inheritance happened but T2 wait for timeout and T3 got the mutex.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api_1cpu__test_mutex_priority_inheritance"
        }
      ],
      "name": "mutex_api_1cpu__test_mutex_priority_inheritance",
      "summary": "Test mutex's priority inheritance mechanism."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api-1cpu--test-mutex-reent-lock-forever",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A thread holds the mutex while a second thread blocks on it with K_FOREVER; the waiter acquires the mutex once it is released. Exercised on both a run-time initialized mutex and a compile-time K_MUTEX_DEFINE() mutex.\n\n*See also:* k_mutex_init()\n\n*See also:* k_mutex_lock()\n\n*See also:* k_mutex_unlock()",
      "externalIdentifier": [
