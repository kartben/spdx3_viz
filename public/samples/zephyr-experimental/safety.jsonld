      "summary": "Work item handler invocation"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-14",
      "requirementStatement": "If a work item is submitted while it is already queued and has not yet started running, then the Zephyr RTOS shall retain the work item at its current position in the queue.",
      "creationInfo": "zephyr:creationinfo",
