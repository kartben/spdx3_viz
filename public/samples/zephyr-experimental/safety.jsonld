      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The memory slab can be accessed outside the module where it is defined using: externstructk_mem_slab<name>;",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_api__test_mslab_kdefine_extern"
        }
      ],
      "name": "mslab_api__test_mslab_kdefine_extern",
      "summary": "Test mem_slab access outside the module."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-api--test-mslab-kdefine-type",
