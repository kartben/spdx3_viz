          "identifier": "k_heap_api__test_k_heap_realloc_zero"
        }
      ],
      "name": "k_heap_api__test_k_heap_realloc_zero",
      "summary": "Test k_heap_realloc() with size 0."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-kheap-alloc-in-isr-nowait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test validates k_heap_alloc() in isr context, the timeout param should be K_NO_WAIT, because this situation isn't allow to wait.\n\n*See also:* k_heap_alloc()\n\n*See also:* k_heap_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_kheap_alloc_in_isr_nowait"
        }
      ],
      "name": "k_heap_api__test_kheap_alloc_in_isr_nowait",
      "summary": "Validate allocation and free heap memory in isr context."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-z-k-heap-double-free",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test validates that double-freeing a pointer asserts\n\n*See also:* k_heap_alloc, k_heap_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_z_k_heap_double_free"
        }
      ],
      "name": "k_heap_api__test_z_k_heap_double_free",
      "summary": "Test k_heap_free() API double free edge case."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-close",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "After k_pipe_close(), new writes must fail with -EPIPE, but data already buffered must still be readable; once that data is exhausted, reads also return -EPIPE.\n\nTest steps:\n\n- Write data into the pipe, then close it.\n- Verify a further write returns -EPIPE.\n- Read the buffered bytes back (in two reads) and verify their values.\n- Verify a read on the now-empty closed pipe returns -EPIPE.\n\nExpected result:\n\n- Writes fail with -EPIPE; buffered data is drained; empty closed reads return -EPIPE.\n\n*See also:* k_pipe_close()\n\n*See also:* k_pipe_read()\n\n*See also:* k_pipe_write()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_close"
        }
      ],
      "name": "k_pipe_basic__test_pipe_close",
      "summary": "Verify close blocks writes but lets buffered data drain."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-init",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "After k_pipe_init() a pipe must be in the open state, ready for reads and writes. The test initializes a pipe over a stack buffer and checks the open flag is set.\n\nTest steps:\n\n- Initialize a pipe with a backing buffer.\n- Verify the pipe's flags indicate it is open.\n\nExpected result:\n\n- The pipe reports PIPE_FLAG_OPEN.\n\n*See also:* k_pipe_init()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_init"
        }
      ],
      "name": "k_pipe_basic__test_pipe_init",
      "summary": "Verify k_pipe_init() opens a pipe for use."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-read-empty",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "With no data buffered and no writer, a read with a finite timeout must block for the timeout and then fail with -EAGAIN.\n\nTest steps:\n\n- Read from an empty pipe with a finite timeout.\n\nExpected result:\n\n- k_pipe_read() returns -EAGAIN.\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_read_empty"
        }
      ],
      "name": "k_pipe_basic__test_pipe_read_empty",
      "summary": "Verify reading from an empty pipe times out with -EAGAIN."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-read-write-full",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Writing a buffer that exactly fills the pipe and reading it all back must return the identical byte sequence.\n\nTest steps:\n\n- Write a buffer of random bytes that fills the pipe.\n- Read the same number of bytes back and compare with memcmp.\n\nExpected result:\n\n- The read buffer is byte-for-byte identical to what was written.\n\n*See also:* k_pipe_write()\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_read_write_full"
        }
      ],
      "name": "k_pipe_basic__test_pipe_read_write_full",
      "summary": "Verify a full-buffer write/read round trip preserves the data."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-read-write-wrap-around",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The pipe's backing storage is a ring buffer. Partially draining and then writing more than the remaining contiguous space forces the write/read to wrap past the end of the buffer; the byte stream must stay correct and in order.\n\nTest steps:\n\n- Write 8 bytes into a 12-byte pipe and read 5 back.\n- Write 8 more bytes (forcing a wrap) and read the remaining 11.\n- Verify the byte sequence across the wrap matches what was written.\n\nExpected result:\n\n- All bytes are returned in order despite the buffer wrap.\n\n*See also:* k_pipe_write()\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_read_write_wrap_around"
        }
      ],
      "name": "k_pipe_basic__test_pipe_read_write_wrap_around",
      "summary": "Verify data integrity across a ring-buffer wrap-around."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-reset",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_pipe_reset() on an empty pipe with no waiters must leave the pipe usable; subsequent writes and reads must still work normally.\n\nTest steps:\n\n- Reset a freshly initialized, empty pipe.\n- Write a byte and read it back.\n\nExpected result:\n\n- The pipe remains functional after the reset.\n\n*See also:* k_pipe_reset()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_reset"
        }
      ],
      "name": "k_pipe_basic__test_pipe_reset",
      "summary": "Verify resetting an idle pipe has no side effects."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-write-full",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Once the pipe buffer is full, a write with a finite timeout and no reader must block for the timeout and then fail with -EAGAIN rather than overrun.\n\nTest steps:\n\n- Fill the pipe to capacity with a non-blocking write.\n- Attempt another write with a finite timeout.\n\nExpected result:\n\n- The first write stores all bytes; the second returns -EAGAIN.\n\n*See also:* k_pipe_write()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_write_full"
        }
      ],
      "name": "k_pipe_basic__test_pipe_write_full",
      "summary": "Verify writing to a full pipe times out with -EAGAIN."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-write-read-multiple",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A pipe is a byte stream: multiple bytes written must be read back in the same order they were written.\n\nTest steps:\n\n- Write two bytes to the pipe.\n- Read two bytes back and verify each matches in order.\n\nExpected result:\n\n- Bytes are returned in FIFO order.\n\n*See also:* k_pipe_write()\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_write_read_multiple"
        }
      ],
      "name": "k_pipe_basic__test_pipe_write_read_multiple",
      "summary": "Verify bytes are read back from a pipe in write (FIFO) order."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-basic--test-pipe-write-read-one",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The most basic stream round trip: one byte written with k_pipe_write() must be returned by k_pipe_read() with the same value.\n\nTest steps:\n\n- Write one byte to an empty pipe (K_NO_WAIT).\n- Read one byte back and compare.\n\nExpected result:\n\n- The byte read equals the byte written.\n\n*See also:* k_pipe_write()\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_basic__test_pipe_write_read_one"
        }
      ],
      "name": "k_pipe_basic__test_pipe_write_read_one",
      "summary": "Verify a single byte written to a pipe is read back unchanged."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-concurrency--test-pipe-close-on-read",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A reader blocked on an empty pipe must be woken and returned -EPIPE when another thread closes the pipe, and the pipe must remain closed afterwards.\n\nTest steps:\n\n- Start a thread that closes the pipe after a short delay.\n- Block in k_pipe_read() on the empty pipe.\n- Verify the read returns -EPIPE and the open flag is cleared.\n\nExpected result:\n\n- The blocked read returns -EPIPE and the pipe stays closed.\n\n*See also:* k_pipe_close()\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_concurrency__test_pipe_close_on_read"
        }
      ],
      "name": "k_pipe_concurrency__test_pipe_close_on_read",
      "summary": "Verify closing a pipe releases a blocked reader with -EPIPE."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-concurrency--test-pipe-close-on-write",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A writer blocked on a full pipe must be woken and returned -EPIPE when another thread closes the pipe, and the pipe must remain closed afterwards.\n\nTest steps:\n\n- Fill the pipe, then start a thread that closes it after a short delay.\n- Block in k_pipe_write() on the full pipe.\n- Verify the write returns -EPIPE and the open flag is cleared.\n\nExpected result:\n\n- The blocked write returns -EPIPE and the pipe stays closed.\n\n*See also:* k_pipe_close()\n\n*See also:* k_pipe_write()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_concurrency__test_pipe_close_on_write"
        }
      ],
      "name": "k_pipe_concurrency__test_pipe_close_on_write",
      "summary": "Verify closing a pipe releases a blocked writer with -EPIPE."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-concurrency--test-pipe-partial-read",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A reader requesting a full buffer blocks until enough bytes arrive. The test supplies the data in two partial writes and confirms the reader completes once the requested amount is available.\n\nTest steps:\n\n- Start a reader thread requesting DUMMY_DATA_SIZE bytes.\n- Write half the bytes, wait, then write the other half.\n- Join the reader and confirm it received the full amount.\n\nExpected result:\n\n- The reader completes after the data is provided across multiple writes.\n\n*See also:* k_pipe_read()\n\n*See also:* k_pipe_write()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_concurrency__test_pipe_partial_read"
        }
      ],
      "name": "k_pipe_concurrency__test_pipe_partial_read",
      "summary": "Verify a reader waiting for more data is satisfied by later writes."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-concurrency--test-pipe-partial-write",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A writer blocked because the pipe is full must complete once a reader drains enough space. The test fills the pipe, starts a writer, then frees space with partial reads and confirms the writer completes.\n\nTest steps:\n\n- Fill the pipe, then start a writer thread.\n- Read half the bytes, wait, then read more to free space.\n- Join the writer and confirm it completed.\n\nExpected result:\n\n- The writer completes once space becomes available.\n\n*See also:* k_pipe_write()\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_concurrency__test_pipe_partial_write"
        }
      ],
      "name": "k_pipe_concurrency__test_pipe_partial_write",
      "summary": "Verify a writer waiting for space is satisfied by later reads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-concurrency--test-pipe-reset-on-read",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Unlike close, k_pipe_reset() cancels in-flight waiters but leaves the pipe open: a reader blocked on an empty pipe must return -ECANCELED, and afterwards the reset flag is cleared and the pipe is still open.\n\nTest steps:\n\n- Start a thread that resets the pipe after a short delay.\n- Block in k_pipe_read() on the empty pipe.\n- Verify the read returns -ECANCELED and the pipe is still open.\n\nExpected result:\n\n- The blocked read returns -ECANCELED; the pipe remains open.\n\n*See also:* k_pipe_reset()\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_concurrency__test_pipe_reset_on_read"
        }
      ],
      "name": "k_pipe_concurrency__test_pipe_reset_on_read",
      "summary": "Verify resetting a pipe releases a blocked reader with -ECANCELED."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-concurrency--test-pipe-reset-on-write",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_pipe_reset() cancels a writer blocked on a full pipe with -ECANCELED while leaving the pipe open for reuse.\n\nTest steps:\n\n- Fill the pipe, then start a thread that resets it after a short delay.\n- Block in k_pipe_write() on the full pipe.\n- Verify the write returns -ECANCELED and the pipe is still open.\n\nExpected result:\n\n- The blocked write returns -ECANCELED; the pipe remains open.\n\n*See also:* k_pipe_reset()\n\n*See also:* k_pipe_write()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_concurrency__test_pipe_reset_on_write"
        }
      ],
      "name": "k_pipe_concurrency__test_pipe_reset_on_write",
      "summary": "Verify resetting a pipe releases a blocked writer with -ECANCELED."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-concurrency--test-pipe-zero-size-read-write",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A pipe initialized with no backing buffer has no storage, so a write must block until a reader is present and copy data directly between threads. The test wires a worker that reads from one zero-size pipe and writes to another, and confirms data passes intact in both directions. Skipped when CONFIG_KERNEL_COHERENCE is set, where unbuffered pipes are unsupported.\n\nTest steps:\n\n- Initialize two zero-size pipes and start a worker that reads then writes.\n- Write into the input pipe and read from the output pipe (both K_FOREVER).\n- Verify the data round-trips unchanged and the worker ran both operations.\n\nExpected result:\n\n- Data is transferred directly between threads and matches end to end.\n\n*See also:* k_pipe_init()\n\n*See also:* k_pipe_read()\n\n*See also:* k_pipe_write()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_concurrency__test_pipe_zero_size_read_write"
        }
      ],
      "name": "k_pipe_concurrency__test_pipe_zero_size_read_write",
      "summary": "Verify an unbuffered (zero-size) pipe transfers data thread-to-thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-stress--test-pipe-read",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Runs many iterations of filling the pipe and draining it, exercising the read/write paths repeatedly to surface throughput or state-tracking issues. Elapsed time is logged for reference.\n\nTest steps:\n\n- For 100 iterations: write READ_LEN bytes (looping) then read them all back.\n\nExpected result:\n\n- Every read and write makes forward progress across all iterations.\n\n*See also:* k_pipe_write()\n\n*See also:* k_pipe_read()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_stress__test_pipe_read"
        }
      ],
      "name": "k_pipe_stress__test_pipe_read",
      "summary": "Stress alternating write/read cycles through a pipe."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-pipe-stress--test-pipe-write",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Repeatedly writes until a large payload has been pushed into the pipe, exercising the write path in bulk and confirming every write makes forward progress. Elapsed time is logged for reference.\n\nTest steps:\n\n- Initialize a pipe sized for the payload.\n- Write WRITE_LEN bytes, looping until all bytes are accepted.\n\nExpected result:\n\n- Every write returns a positive count and the full payload is written.\n\n*See also:* k_pipe_write()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_pipe_stress__test_pipe_write"
        }
      ],
      "name": "k_pipe_stress__test_pipe_write",
      "summary": "Stress k_pipe_write() with a large transfer."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/kernel-offload-wq--test-offload-workqueue",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Check whether variable value per-thread is saved during context switch. Work items are submitted to the offload work queue from an interrupt service routine.\n\n*See also:* k_work_queue_start()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "kernel_offload_wq__test_offload_workqueue"
        }
      ],
      "name": "kernel_offload_wq__test_offload_workqueue",
      "summary": "Verify thread context."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/kernel-sys-sem--test-multi-thread-sem-limit",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "- Define and initialize semaphore and thread.\n- Give sem by multiple threads.\n- Verify more than max count about semaphore can reach.\n- Take sem by multiple threads and verify if sem count is correct.\n\n*See also:* sys_sem_give()\n\n*See also:* sys_sem_take()\n\n*See also:* sys_sem_count_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "kernel_sys_sem__test_multi_thread_sem_limit"
        }
      ],
      "name": "kernel_sys_sem__test_multi_thread_sem_limit",
      "summary": "Test max semaphore can be give and take with multiple thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/kernel-sys-sem--test-multiple-thread-sem-usage",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Using semaphore with some situations\n\n- Use a uninitialized semaphore\n- Use semaphore normally\n- Use semaphore with different priority threads\n\n*See also:* sys_sem_init()\n\n*See also:* sys_sem_give()\n\n*See also:* sys_sem_take()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "kernel_sys_sem__test_multiple_thread_sem_usage"
        }
      ],
      "name": "kernel_sys_sem__test_multiple_thread_sem_usage",
      "summary": "Test semaphore usage with multiple thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lib-mem-slab-stats-test--test-mem-slab-runtime-stats",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Query the runtime statistics of a memory slab and verify that the reported free, allocated and maximum-allocated byte counts track block allocations and frees, and that resetting the maximum works.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lib_mem_slab_stats_test__test_mem_slab_runtime_stats"
        }
      ],
      "name": "lib_mem_slab_stats_test__test_mem_slab_runtime_stats",
      "summary": "Verify memory slab runtime usage statistics."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lib-mem-slab-stats-test--test-mem-slab-stats-invalid-params",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Call the memory slab runtime statistics query and reset routines with invalid parameters and verify they return -EINVAL.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lib_mem_slab_stats_test__test_mem_slab_stats_invalid_params"
        }
      ],
      "name": "lib_mem_slab_stats_test__test_mem_slab_stats_invalid_params",
      "summary": "Verify memory slab statistics routines reject invalid parameters."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-contexts--test-lifo-alloc-put",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Use k_lifo_alloc_put() to enqueue a data item that does not reserve space for the bookkeeping word, so the kernel allocates the container from the calling thread's resource pool. Verify the call succeeds and that the same data pointer is returned by a subsequent get.\n\n*See also:* k_lifo_alloc_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_contexts__test_lifo_alloc_put"
        }
      ],
      "name": "lifo_contexts__test_lifo_alloc_put",
      "summary": "Test enqueuing a data item to a LIFO with implicit memory allocation."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-contexts--test-lifo-isr2thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Items are enqueued in thread context and dequeued from interrupt context (via irq_offload()), confirming k_lifo_get() is ISR-safe and the ISR receives the items in LIFO order. Run against both an init()ed and a DEFINE()d LIFO.\n\nTest steps:\n\n- In thread context, put items onto the LIFO.\n- From an ISR, get the items and verify reverse insertion order.\n- Repeat for a statically defined LIFO.\n\nExpected result:\n\n- The ISR dequeues every thread-enqueued item newest-first.\n\n*See also:* k_lifo_put()\n\n*See also:* k_lifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_contexts__test_lifo_isr2thread"
        }
      ],
      "name": "lifo_contexts__test_lifo_isr2thread",
      "summary": "Verify LIFO data passing from a thread to an ISR."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-contexts--test-lifo-thread2isr",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Items are enqueued from interrupt context (via irq_offload()) and dequeued in thread context, confirming k_lifo_put() is ISR-safe and the thread receives the items in LIFO order. Run against both an init()ed and a DEFINE()d LIFO.\n\nTest steps:\n\n- From an ISR, put items onto the LIFO.\n- In thread context, get the items and verify reverse insertion order.\n- Repeat for a statically defined LIFO.\n\nExpected result:\n\n- The thread dequeues every ISR-enqueued item newest-first.\n\n*See also:* k_lifo_put()\n\n*See also:* k_lifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_contexts__test_lifo_thread2isr"
        }
      ],
      "name": "lifo_contexts__test_lifo_thread2isr",
      "summary": "Verify LIFO data passing from an ISR to a thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-contexts-1cpu--test-lifo-thread2thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A consumer thread blocks on k_lifo_get() while the main thread enqueues items, and must receive them newest-first (LIFO order). Run against both a k_lifo_init()ed and a K_LIFO_DEFINE()d LIFO to confirm both initialization paths behave the same.\n\nTest steps:\n\n- Start a preemptible consumer thread that drains the LIFO.\n- From the main thread, put items onto the LIFO.\n- Synchronize on a semaphore once the consumer has read all items.\n- Repeat for a statically defined LIFO.\n\nExpected result:\n\n- The consumer dequeues items in reverse insertion order.\n\n*See also:* k_lifo_put()\n\n*See also:* k_lifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_contexts_1cpu__test_lifo_thread2thread"
        }
      ],
      "name": "lifo_contexts_1cpu__test_lifo_thread2thread",
      "summary": "Verify LIFO data passing between two threads in LIFO order."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-fail--test-lifo-get-fail",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When no data is queued, k_lifo_get() must return NULL rather than block indefinitely or return stale data. The contract is checked both with K_NO_WAIT (immediate) and with a finite timeout that is allowed to expire.\n\nTest steps:\n\n- Initialize an empty LIFO.\n- Call k_lifo_get() with K_NO_WAIT and verify it returns NULL.\n- Call k_lifo_get() with a finite timeout and verify it returns NULL.\n\nExpected result:\n\n- Both k_lifo_get() calls return NULL.\n\n*See also:* k_lifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_fail__test_lifo_get_fail"
        }
      ],
      "name": "lifo_fail__test_lifo_get_fail",
      "summary": "Verify k_lifo_get() on an empty LIFO returns NULL."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-loop--test-lifo-loop",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Stresses the LIFO by cycling data through main-thread, ISR and spawned-thread contexts many times. Across every iteration the items must be passed without loss, duplication or reordering, exercising put/get stability when producers and consumers alternate between thread and interrupt context.\n\nTest steps:\n\n- For LOOPS iterations: put from the main thread, get then put from an ISR, and get from a spawned thread.\n- Verify each get returns the expected item in LIFO order.\n\nExpected result:\n\n- Data passes correctly and in LIFO order across all contexts every iteration.\n\n*See also:* k_lifo_put()\n\n*See also:* k_lifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_loop__test_lifo_loop"
        }
      ],
      "name": "lifo_loop__test_lifo_loop",
      "summary": "Verify LIFO data integrity under repeated cross-context traffic."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-usage--test-timeout-non-empty-lifo",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When an item is already on the LIFO, k_lifo_get() must return it immediately regardless of the timeout argument. The contract is checked with both K_NO_WAIT and K_FOREVER, neither of which should block when data is present.\n\nTest steps:\n\n- Put an item, then k_lifo_get() with K_NO_WAIT and verify a non-NULL return.\n- Put an item, then k_lifo_get() with K_FOREVER and verify a non-NULL return.\n\nExpected result:\n\n- Both gets return the queued item without blocking.\n\n*See also:* k_lifo_get()\n\n*See also:* k_lifo_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_usage__test_timeout_non_empty_lifo"
        }
      ],
      "name": "lifo_usage__test_timeout_non_empty_lifo",
      "summary": "Verify k_lifo_get() returns queued data without waiting."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-usage-1cpu--test-lifo-nowait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The defining property of a LIFO is that the most recently put item is retrieved first. Two items are placed on the LIFO around the creation of a reader thread, which must receive them in reverse insertion order.\n\nTest steps:\n\n- Put item 0, start a reader thread, then put item 1.\n- The reader gets two items and verifies item 1 is returned before item 0.\n\nExpected result:\n\n- Items are returned newest-first (item 1, then item 0).\n\n*See also:* k_lifo_put()\n\n*See also:* k_lifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_usage_1cpu__test_lifo_nowait"
        }
      ],
      "name": "lifo_usage_1cpu__test_lifo_nowait",
      "summary": "Verify k_lifo_get() returns items in last-in first-out order."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-usage-1cpu--test-lifo-wait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A reader blocks on an empty LIFO with K_FOREVER. A second thread then puts two items; the pending reader must be woken with the first item and retrieve the second on its next get, confirming put correctly hands data to a waiter.\n\nTest steps:\n\n- Start a thread that puts item 0 then item 1 on the LIFO.\n- In the main thread, block in k_lifo_get(K_FOREVER) and verify it returns item 0.\n- Get again and verify it returns item 1.\n\nExpected result:\n\n- The pending reader wakes and receives both items in order.\n\n*See also:* k_lifo_get()\n\n*See also:* k_lifo_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_usage_1cpu__test_lifo_wait"
        }
      ],
      "name": "lifo_usage_1cpu__test_lifo_wait",
      "summary": "Verify a thread blocked on an empty LIFO is woken by k_lifo_put()."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-usage-1cpu--test-timeout-empty-lifo",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "On an empty LIFO, k_lifo_get() with a finite timeout must block for at least the requested duration and then return NULL, while K_NO_WAIT must return NULL immediately. The elapsed time is measured to confirm the full timeout elapsed.\n\nTest steps:\n\n- Call k_lifo_get() on an empty LIFO with a 100 ms timeout; measure the wait.\n- Verify it returned NULL and that at least the timeout elapsed.\n- Call k_lifo_get() with K_NO_WAIT and verify it returns NULL.\n\nExpected result:\n\n- The timed get returns NULL after the timeout; K_NO_WAIT returns NULL at once.\n\n*See also:* k_lifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_usage_1cpu__test_timeout_empty_lifo"
        }
      ],
      "name": "lifo_usage_1cpu__test_timeout_empty_lifo",
      "summary": "Verify k_lifo_get() timeout behavior on an empty LIFO."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-usage-1cpu--test-timeout-lifo-thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A getter pending with a timeout must be woken as soon as a producer thread puts data, returning that data rather than timing out. The test also covers the K_NO_WAIT and K_FOREVER variants where a child thread conditionally supplies data based on availability on a second LIFO, exercising the interaction between blocking gets and producer timing.\n\nTest steps:\n\n- Pend on k_lifo_get() with a timeout while a child puts data in time; verify the data is returned within the timeout window.\n- With K_NO_WAIT, verify the child reports no data when the LIFO is empty and reports data when it has been pre-filled.\n- With K_FOREVER, verify the child retrieves pre-filled data.\n\nExpected result:\n\n- The getter receives data supplied in time; the reply flags reflect LIFO availability for each timeout variant.\n\n*See also:* k_lifo_get()\n\n*See also:* k_lifo_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_usage_1cpu__test_timeout_lifo_thread"
        }
      ],
      "name": "lifo_usage_1cpu__test_timeout_lifo_thread",
      "summary": "Verify k_lifo_get() wakes when a thread supplies data within timeout."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/lifo-usage-1cpu--test-timeout-threads-pend-on-lifo",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When several threads block on the same LIFO with different timeouts and no data arrives, each must time out in ascending-timeout order regardless of the order in which the threads were queued, validating the timeout queue ordering.\n\nTest steps:\n\n- Spawn several threads that pend on the same LIFO with distinct timeouts.\n- Each reports back as it times out; verify the reported order matches the ascending-timeout order.\n\nExpected result:\n\n- Threads time out strictly in increasing-timeout order.\n\n*See also:* k_lifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "lifo_usage_1cpu__test_timeout_threads_pend_on_lifo"
        }
      ],
      "name": "lifo_usage_1cpu__test_timeout_threads_pend_on_lifo",
      "summary": "Verify multiple threads pending on one LIFO time out in timeout order."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-backend-init--test-log-backends-initialization",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Two autostarted backends with different (delayed) readiness times are registered. Logging starts processing once at least one backend is ready, so a message emitted between the two readiness points reaches only the ready backend, while a later message reaches both. This validates correct routing to multiple backends as each becomes ready during startup.\n\nTest steps:\n\n- Skip if exactly two backends are not present.\n- Emit a first message before either backend is ready.\n- Wait until both backends become ready, then emit a second message.\n- Allow processing and check each backend's received message count.\n\nExpected result:\n\n- The earlier-ready backend receives both messages; the later-ready backend receives only the second message.\n\n*See also:* log_backend_enable()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_backend_init__test_log_backends_initialization"
        }
      ],
      "name": "log_backend_init__test_log_backends_initialization",
      "summary": "Verify staged auto-start initialization of multiple backends."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-backend-uart--test-log-backend-uart-multi-instance",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate that the UART logging backend can be instantiated multiple times and that a single raw log record is delivered to the UART of every backend instance. Emulated UARTs are used to capture and compare the transmitted bytes, confirming logging to multiple UART backends/system resources.\n\nTest steps:\n\n- Confirm the number of registered backends matches the number of emulated UARTs.\n- Emit one raw log record.\n- Read the TX data of each emulated UART and compare against the expected string.\n\nExpected result:\n\n- Every UART backend instance transmits exactly the logged string.\n\n*See also:* LOG_RAW()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_backend_uart__test_log_backend_uart_multi_instance"
        }
      ],
      "name": "log_backend_uart__test_log_backend_uart_multi_instance",
      "summary": "Verify the UART log backend delivers output to every instance."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-blocking--test-blocking",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "In blocking mode the logging subsystem stalls the producer when the deferred buffer is full instead of dropping messages. A high-priority producer thread logs a fixed number of messages at a configured input rate while the backend consumes at a configured output rate. The test validates that, when the rates allow forward progress, all messages are handled and none are dropped.\n\nTest steps:\n\n- Start the producer thread that logs CONFIG_TEST_NUM_LOGS messages.\n- Wait for the run window to elapse and join the producer thread.\n- Check the backend's dropped and handled counters.\n\nExpected result:\n\n- Zero messages are dropped and all messages are handled (in the stalled configuration the test is expected to fail).\n\n*See also:* LOG_INF()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_blocking__test_blocking"
        }
      ],
      "name": "log_blocking__test_blocking",
      "summary": "Verify blocking-mode logging never drops messages."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-custom-header--test-macro-prefix",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Logs at each severity level through a backend that renders the message package and confirms every rendered line is prefixed with the custom log header (CUSTOM_LOG_PREFIX) ahead of the formatted text and arguments. This validates that a custom header configured by the user is included in the formatted log message.\n\nTest steps:\n\n- Emit LOG_DBG/LOG_INF/LOG_WRN/LOG_ERR messages with format arguments.\n- Process the log after each call so the backend renders the message.\n- Assert the processed count and that each output carries the custom prefix.\n\nExpected result:\n\n- Each rendered message begins with CUSTOM_LOG_PREFIX followed by the formatted text and arguments.\n\n*See also:* log_msg_get_package()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_custom_header__test_macro_prefix"
        }
      ],
      "name": "log_custom_header__test_macro_prefix",
      "summary": "Verify a user-supplied custom log prefix is prepended to messages."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-immediate--test-log-immediate-preemption",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "In immediate mode a log message is processed in the context that generated it. This test creates several threads of different priorities that continuously log text and hexdump data and then sleep, so that lower-priority threads are frequently preempted mid-logging by higher-priority ones. It validates that the subsystem handles such interleaved in-context processing without hitting an assert or fault.\n\nTest steps:\n\n- Create NUM_THREADS threads at staggered priorities, each logging in a loop.\n- Let them run and preempt each other for a few seconds.\n- Abort all threads.\n\nExpected result:\n\n- The system survives frequent preemption during immediate logging with no assertion or fault.\n\n*See also:* LOG_INF()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_immediate__test_log_immediate_preemption"
        }
      ],
      "name": "log_immediate__test_log_immediate_preemption",
      "summary": "Verify immediate-mode logging is robust under thread preemption."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-link-order--test-log-one-remote-ordering",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When a log link has its own dedicated buffer, the processing logic selects the earliest message across the local queue and the link buffers. This test enqueues a remote message with an earlier timestamp to a dedicated-buffer link and validates that messages are reordered and claimed by ascending timestamp.\n\nTest steps:\n\n- Take an early timestamp for the remote message before committing local.\n- Commit the local message and enqueue two remote messages to a dedicated buffer link (earlier then later timestamp).\n- Claim messages and check their timestamps.\n\nExpected result:\n\n- Messages are claimed in ascending timestamp order (0, 1, 2).\n- No further messages remain.\n\n*See also:* z_log_msg_enqueue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_link_order__test_log_one_remote_ordering"
        }
      ],
      "name": "log_link_order__test_log_one_remote_ordering",
      "summary": "Verify timestamp ordering when a link has a dedicated buffer."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-link-order--test-log-only-local",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Messages may originate locally or arrive via a log link (remote domain). This test commits a local message and then enqueues a remote-link message with a later timestamp, validating that messages are claimed in timestamp order.\n\nTest steps:\n\n- Allocate and commit a local message (timestamp 0).\n- Enqueue a remote-link message (timestamp 1).\n- Claim messages and check their timestamps.\n\nExpected result:\n\n- Messages are claimed in ascending timestamp order (0, then 1).\n- No further messages remain.\n\n*See also:* z_log_msg_enqueue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_link_order__test_log_only_local"
        }
      ],
      "name": "log_link_order__test_log_only_local",
      "summary": "Verify ordering of local and remote-link messages by timestamp."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-links--test-log-compiled-level-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Sources exposed through a link carry their own compiled (build-time) severity level. This test queries the compiled level for several sources across linked domains and confirms each matches the level declared by the remote source, validating compile-time severity filtering information across a link.\n\nTest steps:\n\n- Set up logging and activate the configured links.\n- Query the compiled level for selected sources in linked domains.\n- Compare each against the source's declared compile level.\n\nExpected result:\n\n- Each compiled level matches the declared level of the link source.\n\n*See also:* log_filter_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_links__test_log_compiled_level_get"
        }
      ],
      "name": "log_links__test_log_compiled_level_get",
      "summary": "Verify compile-time severity levels are retrieved for link-registered sources."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-links--test-log-domain-count",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Two mock log links expose several remote logging domains. After activating the links, this test confirms the reported domain count equals the local domain plus the domains contributed by each link, validating that logs from multiple domains are aggregated through the link mechanism.\n\nTest steps:\n\n- Set up logging and activate the configured links.\n- Query the total domain count.\n- Compare it against the local domain plus each link's domain count.\n\nExpected result:\n\n- The domain count matches the sum of local and linked domains.\n\n*See also:* log_domains_count()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_links__test_log_domain_count"
        }
      ],
      "name": "log_links__test_log_domain_count",
      "summary": "Verify the total domain count aggregates the local domain and all linked domains."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-links--test-log-domain-name-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Each linked logging domain advertises a name that must be retrievable by domain id. This test confirms the local domain reports an empty name and each link-provided domain reports its configured name, validating identification of domains aggregated through links.\n\nTest steps:\n\n- Query the domain name for the local domain and each linked domain.\n- Compare each returned name against the expected value.\n\nExpected result:\n\n- Each domain id maps to its expected domain name.\n\n*See also:* log_domain_name_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_links__test_log_domain_name_get"
        }
      ],
      "name": "log_links__test_log_domain_name_get",
      "summary": "Verify domain names are reported correctly for the local and linked domains."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-links--test-log-runtime-level-set",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "For sources reached through a link, this test reads the initial runtime filter level per backend, sets distinct runtime levels for two backends, and confirms the link's effective level becomes the maximum of the per-backend settings. This validates per-source, per-backend runtime severity filtering and its propagation to the remote domain over the link.\n\nTest steps:\n\n- Set up logging with both backends enabled and activate the links.\n- Read and then set distinct runtime filter levels per backend per source.\n- Verify each backend's level and the link's aggregated (max) level.\n\nExpected result:\n\n- Per-backend runtime levels are applied and the link level is their maximum.\n\n*See also:* log_filter_set()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_links__test_log_runtime_level_set"
        }
      ],
      "name": "log_links__test_log_runtime_level_set",
      "summary": "Verify runtime severity filtering is set per backend and propagated across a link."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-links--test-log-source-count",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Each logging domain registers an independent set of log sources, including those contributed by remote domains over a link. This test confirms the source count reported for every domain matches the expected number of registered sources, validating source registration across multiple domains.\n\nTest steps:\n\n- Set up logging and activate the configured links.\n- For each domain query the registered source count.\n- Compare each against the expected per-domain source count.\n\nExpected result:\n\n- Each domain reports the expected number of registered sources.\n\n*See also:* log_src_cnt_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_links__test_log_source_count"
        }
      ],
      "name": "log_links__test_log_source_count",
      "summary": "Verify per-domain source counts reflect locally and link-registered sources."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-links--test-log-source-name-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Sources registered through a link expose their names by domain and source id. This test queries names for several sources across linked domains and confirms each matches the configured remote source name, validating identification of log sources registered across multiple domains.\n\nTest steps:\n\n- Set up logging and activate the configured links.\n- Query the source name for selected sources in linked domains.\n- Compare each against the expected source name.\n\nExpected result:\n\n- Each queried source reports its expected name.\n\n*See also:* log_source_name_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_links__test_log_source_name_get"
        }
      ],
      "name": "log_links__test_log_source_name_get",
      "summary": "Verify source names are reported correctly for link-registered sources."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-stress--test-stress-fast-processing",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Exercise the logging subsystem under concurrent load from multiple contexts (timer and threads) with a short backend processing delay. The test validates that, accounting for the deferred buffer dropping messages under pressure, the number of dropped messages exactly matches the number detected as missing and that the total of handled plus dropped equals the total generated.\n\nTest steps:\n\n- Run ztress with one timer and two thread contexts logging messages, using a short (10 us) processing delay.\n- Drain pending messages and log a final round per context.\n- Validate that dropped count equals missing count and totals balance.\n\nExpected result:\n\n- No message is silently lost: dropped equals missing and in-count equals handled plus dropped.\n\n*See also:* LOG_INF()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_stress__test_stress_fast_processing"
        }
      ],
      "name": "log_stress__test_stress_fast_processing",
      "summary": "Verify message integrity under stress with fast processing."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-stress--test-stress-slow-processing",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Same concurrent stress scenario as the fast-processing case but with a longer backend processing delay, which increases buffer pressure and the likelihood of deferred-mode drops. The test validates that dropped messages are precisely accounted for: dropped equals missing and handled plus dropped equals the total generated.\n\nTest steps:\n\n- Run ztress with one timer and two thread contexts logging messages, using a longer (100 us) processing delay.\n- Drain pending messages and log a final round per context.\n- Validate that dropped count equals missing count and totals balance.\n\nExpected result:\n\n- No message is silently lost: dropped equals missing and in-count equals handled plus dropped.\n\n*See also:* LOG_INF()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_stress__test_stress_slow_processing"
        }
      ],
      "name": "log_stress__test_stress_slow_processing",
      "summary": "Verify message integrity under stress with slow processing."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-switch-format--test-log-switch-format",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Drives the full format-switching flow: it toggles active backends between SyS-T and text output and confirms each emitted message is rendered in the currently selected format, validates error handling for unknown backends and out-of-range format types, confirms switching all active backends at once, and checks the format function-pointer table maps each output type to its renderer. This ensures logs can be produced in a machine-parseable format and that messages are formatted according to the selected output type.\n\nTest steps:\n\n- Switch all active backends between SyS-T and text and validate each render.\n- Exercise error returns for invalid backend and unsupported format type.\n- Switch all active backends and verify the function-pointer table entries.\n\nExpected result:\n\n- Messages render in the selected format and all format APIs behave as expected.\n\n*See also:* log_format_set_all_active_backends()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_switch_format__test_log_switch_format"
        }
      ],
      "name": "log_switch_format__test_log_switch_format",
      "summary": "Verify log output format can be switched at runtime across active backends."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-switch-format--test-log-switch-format-custom-output-called-when-set",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Selects the custom output format on the default backend and registers a custom formatting callback that emits a fixed string. Emitting messages must then produce that string, confirming the custom format renderer is invoked and its output is captured.\n\nTest steps:\n\n- Set the default backend to the custom output format.\n- Register a custom output handler and emit log messages.\n- Validate that the handler's output is rendered.\n\nExpected result:\n\n- The custom handler is invoked and its formatted output is produced.\n\n*See also:* log_custom_output_msg_set()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_switch_format__test_log_switch_format_custom_output_called_when_set"
        }
      ],
      "name": "log_switch_format__test_log_switch_format_custom_output_called_when_set",
      "summary": "Verify a registered custom output handler is invoked to format messages."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-switch-format--test-log-switch-format-custom-output-handles-null",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Selects the custom output format on the default backend but clears the custom formatting callback. Emitting messages must then produce no rendered output, confirming the custom format path safely handles a NULL handler instead of formatting messages.\n\nTest steps:\n\n- Set the default backend to the custom output format.\n- Clear the custom output handler and emit log messages.\n- Validate that no formatted output is produced.\n\nExpected result:\n\n- No output is rendered for the custom format with a NULL handler.\n\n*See also:* log_custom_output_msg_set()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_switch_format__test_log_switch_format_custom_output_handles_null"
        }
      ],
      "name": "log_switch_format__test_log_switch_format_custom_output_handles_null",
      "summary": "Verify the custom output format produces no output when no handler is set."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-switch-format--test-log-switch-format-does-not-log-when-uninit",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Selects the custom output format on the default backend without ever registering a custom formatting callback. Emitting messages must then produce no rendered output, confirming the custom format path does not log when its handler has not been initialized.\n\nTest steps:\n\n- Set the default backend to the custom output format without a handler.\n- Emit log messages.\n- Validate that no formatted output is produced.\n\nExpected result:\n\n- No output is rendered while the custom format handler is uninitialized.\n\n*See also:* log_backend_format_set()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_switch_format__test_log_switch_format_does_not_log_when_uninit"
        }
      ],
      "name": "log_switch_format__test_log_switch_format_does_not_log_when_uninit",
      "summary": "Verify the custom output format produces no output when left uninitialized."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/log-syst--test-log-syst-format-table-selection",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The log output subsystem resolves the rendering function for a given output format from an internal function-pointer table. This test confirms that when MIPI SyS-T output is enabled the SyS-T processing function is selected, and otherwise the plain text processing function is selected, ensuring log messages are rendered into the configured machine-parseable format.\n\nTest steps:\n\n- Query the format function for the active output type via log_format_func_t_get().\n- Compare the returned pointer against the expected SyS-T or text processor.\n\nExpected result:\n\n- The returned function pointer matches the processor for the active format.\n\n*See also:* log_format_func_t_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "log_syst__test_log_syst_format_table_selection"
        }
      ],
      "name": "log_syst__test_log_syst_format_table_selection",
      "summary": "Verify the correct format processing function is selected for the active output format."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-define-multi-mbox",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Several mailboxes initialized from the same code must operate independently; a message sent through each is delivered without interference between them.\n\nTest steps:\n\n- Initialize three separate mailboxes.\n- Send and receive an empty message through each in turn.\n\nExpected result:\n\n- Each mailbox independently delivers its message.\n\n*See also:* k_mbox_init()\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_define_multi_mbox"
        }
      ],
      "name": "mbox_api__test_define_multi_mbox",
      "summary": "Verify multiple independent mailboxes can be used."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-async-multiple-put",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Several k_mbox_async_put() calls with different target threads queue multiple messages; the receiver must be able to retrieve them, including selecting a message by matching source thread.\n\nTest steps:\n\n- Issue multiple async puts with varying target threads (K_ANY and specific).\n- Receiver gets the messages, including one filtered by source thread.\n\nExpected result:\n\n- All queued messages are retrieved successfully.\n\n*See also:* k_mbox_async_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_async_multiple_put"
        }
      ],
      "name": "mbox_api__test_mbox_async_multiple_put",
      "summary": "Verify multiple queued async puts are all delivered."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-async-put-get-block",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The receiver advertises in rx_msg->size the maximum it will accept. When that is smaller than the sent message, the kernel must truncate the transfer to the receiver's size, copy only that prefix, and report the negotiated size back to both the receiver (rx_msg->size) and the sender (tx_msg->size).\n\nTest steps:\n\n- Sender puts a full-length buffer message (MAIL_LEN bytes), K_FOREVER.\n- Receiver gets with rx size set to TRUNCATED_SIZE (< MAIL_LEN).\n- Check the receiver's size is TRUNCATED_SIZE and the copied prefix matches.\n- Check the sender's tx size was updated to TRUNCATED_SIZE after the put.\n\nExpected result:\n\n- Both sizes are negotiated down to TRUNCATED_SIZE and only that many bytes are transferred.\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_async_put_get_block"
        }
      ],
      "name": "mbox_api__test_mbox_async_put_get_block",
      "summary": "Verify message-size negotiation when the receiver accepts fewer bytes."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-async-put-get-buffer",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_mbox_async_put() must hand a buffer message to a receiver without the sender blocking on delivery; the receiver retrieves the payload with k_mbox_data_get() and it must match what was sent.\n\nTest steps:\n\n- Sender async-puts a buffer message and waits on the completion semaphore.\n- Receiver gets the message, copies the data via k_mbox_data_get(), compares.\n\nExpected result:\n\n- The asynchronously sent buffer is received intact.\n\n*See also:* k_mbox_async_put()\n\n*See also:* k_mbox_data_get()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_async_put_get_buffer"
        }
      ],
      "name": "mbox_api__test_mbox_async_put_get_buffer",
      "summary": "Verify asynchronous put delivers a buffered message."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-async-put-to-waiting-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When a receiver is already blocked in k_mbox_get(), a later k_mbox_async_put() must wake it and deliver the message. A helper thread releases the semaphore that gates the async put so it happens after the get is pending.\n\nTest steps:\n\n- Receiver blocks in k_mbox_get() (K_FOREVER) for a K_ANY source.\n- A helper releases the semaphore so the sender performs an async put.\n\nExpected result:\n\n- The waiting get completes successfully once the async put runs.\n\n*See also:* k_mbox_async_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_async_put_to_waiting_get"
        }
      ],
      "name": "mbox_api__test_mbox_async_put_to_waiting_get",
      "summary": "Verify an async put completes a get that is already waiting."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-dispose-size-0-msg",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A receiver may discard a message's data by performing a get with a receive size of 0, which completes the transfer without copying the payload.\n\nTest steps:\n\n- Sender puts a buffer message.\n- Receiver gets it with size 0 to dispose of the data.\n\nExpected result:\n\n- The get succeeds (returns 0) and the message is consumed without copying.\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_dispose_size_0_msg"
        }
      ],
      "name": "mbox_api__test_mbox_dispose_size_0_msg",
      "summary": "Verify a received message can be disposed by requesting size 0."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-enhanced-capabilities",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Demonstrates that an identical data buffer can be transported by both kernel messaging primitives: it is enqueued on a k_msgq and then sent through a mailbox using the asynchronous buffer path, confirming both accept the data.\n\nTest steps:\n\n- Initialize a message queue and put the data buffer on it (K_NO_WAIT).\n- Send the same buffer through the mailbox via async put and receive it.\n\nExpected result:\n\n- The message queue put succeeds and the mailbox transfers the same buffer.\n\n*See also:* k_msgq_put()\n\n*See also:* k_mbox_async_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_enhanced_capabilities"
        }
      ],
      "name": "mbox_api__test_mbox_enhanced_capabilities",
      "summary": "Verify the same buffer can be sent via a message queue and a mailbox."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-get-waiting-put-incorrect-tid",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A get blocked on a specific source thread must not be completed by an async put addressed to a different thread: the get times out with -EAGAIN, and a follow-up get for K_ANY then drains the stranded message.\n\nTest steps:\n\n- Receiver waits in k_mbox_get() filtering on a specific source with a finite timeout while an async put targets a different (random) thread.\n- Verify the get returns -EAGAIN, then clean up with a K_ANY get.\n\nExpected result:\n\n- The filtered get times out (-EAGAIN); the message is retrievable via K_ANY.\n\n*See also:* k_mbox_async_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_get_waiting_put_incorrect_tid"
        }
      ],
      "name": "mbox_api__test_mbox_get_waiting_put_incorrect_tid",
      "summary": "Verify a waiting get is not satisfied by an async put to another tid."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-incorrect-receiver-tid",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A non-blocking get that filters on a specific source thread which has no pending message must fail with -ENOMSG rather than return another thread's message.\n\nTest steps:\n\n- Receiver gets with rx_source_thread set to an unrelated thread, K_NO_WAIT.\n\nExpected result:\n\n- k_mbox_get() returns -ENOMSG.\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_incorrect_receiver_tid"
        }
      ],
      "name": "mbox_api__test_mbox_incorrect_receiver_tid",
      "summary": "Verify a get filtering on a non-matching source returns -ENOMSG."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-incorrect-transmit-tid",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A non-blocking put addressed to a specific target thread that is not waiting to receive must fail with -ENOMSG rather than queue indefinitely.\n\nTest steps:\n\n- Sender puts with tx_target_thread set to a non-waiting thread, K_NO_WAIT.\n\nExpected result:\n\n- k_mbox_put() returns -ENOMSG.\n\n*See also:* k_mbox_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_incorrect_transmit_tid"
        }
      ],
      "name": "mbox_api__test_mbox_incorrect_transmit_tid",
      "summary": "Verify a put to a non-waiting target returns -ENOMSG."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-kdefine",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A mailbox created with K_MBOX_DEFINE() must be usable without an explicit k_mbox_init(). The test exchanges an empty (size 0) message through the statically defined mailbox between a sender and a receiver thread.\n\nTest steps:\n\n- Send and receive an empty message through the K_MBOX_DEFINE()d mailbox.\n\nExpected result:\n\n- The message is delivered, confirming the static mailbox is operational.\n\n*See also:* K_MBOX_DEFINE()\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_kdefine"
        }
      ],
      "name": "mbox_api__test_mbox_kdefine",
      "summary": "Verify a statically defined mailbox can pass a message."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-kinit",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_mbox_init() must prepare a statically allocated k_mbox for use without error. This is the minimal smoke test that runtime initialization completes.\n\nTest steps:\n\n- Call k_mbox_init() on a k_mbox instance.\n\nExpected result:\n\n- The mailbox is initialized and ready for put/get operations.\n\n*See also:* k_mbox_init()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_kinit"
        }
      ],
      "name": "mbox_api__test_mbox_kinit",
      "summary": "Verify a mailbox can be initialized at runtime."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-msg-tid-mismatch",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A message addressed to one thread must not satisfy a get filtering on a different source thread: the targeted message stays queued (the put times out) and the mismatched non-blocking get returns -ENOMSG.\n\nTest steps:\n\n- Sender puts a message targeted at the sender thread with a finite timeout.\n- Receiver gets filtering on an unrelated source with K_NO_WAIT.\n\nExpected result:\n\n- The get returns -ENOMSG; the mismatched message is not delivered.\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_msg_tid_mismatch"
        }
      ],
      "name": "mbox_api__test_mbox_msg_tid_mismatch",
      "summary": "Verify a message is not delivered to a get with a mismatched tid."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-multiple-waiting-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "With several receivers blocked on the same mailbox using different source filters (K_ANY and specific threads), each put message must be delivered to a compatible waiting receiver, exercising tid-based routing under contention.\n\nTest steps:\n\n- Start five threads that each wait in k_mbox_get() with different source filters.\n- Put several messages targeted at K_ANY and specific threads.\n\nExpected result:\n\n- Every waiting receiver obtains a message matching its source filter.\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_multiple_waiting_get"
        }
      ],
      "name": "mbox_api__test_mbox_multiple_waiting_get",
      "summary": "Verify messages are routed among multiple waiting receivers by tid."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-put-get-buffer",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A message carrying a data buffer must be delivered intact: the receiver's info, size and copied payload must match what the sender provided, using synchronous put/get.\n\nTest steps:\n\n- Sender puts a buffer message targeted at K_ANY.\n- Receiver gets it into a local buffer and compares info, size and contents.\n\nExpected result:\n\n- The receiver obtains the exact buffer the sender transmitted.\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_put_get_buffer"
        }
      ],
      "name": "mbox_api__test_mbox_put_get_buffer",
      "summary": "Verify synchronous transfer of a buffered mailbox message."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-put-get-null",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A zero-length message (no data buffer) must be deliverable: the receiver observes the message with size 0 and the matching info field, using a synchronous k_mbox_put() and k_mbox_get().\n\nTest steps:\n\n- Sender puts a size-0 message targeted at K_ANY.\n- Receiver gets from K_ANY and checks the info and that size is 0.\n\nExpected result:\n\n- The empty message is delivered with size 0 and the expected info value.\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_put_get_null"
        }
      ],
      "name": "mbox_api__test_mbox_put_get_null",
      "summary": "Verify synchronous transfer of an empty mailbox message."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-target-source-thread-buffer",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A message may be addressed to a specific target thread and received by filtering on a specific source thread; the buffer must be delivered on the matching sender/receiver identities.\n\nTest steps:\n\n- Sender puts a buffer message with tx_target_thread set to the receiver.\n- Receiver gets filtering on rx_source_thread set to the sender.\n\nExpected result:\n\n- The directed message is delivered and its contents match.\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_target_source_thread_buffer"
        }
      ],
      "name": "mbox_api__test_mbox_target_source_thread_buffer",
      "summary": "Verify a buffer message directed to a specific thread pair."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-api--test-mbox-timed-out-mbox-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A get that filters on a source thread with no pending message and a finite timeout must block for the timeout and then return -EAGAIN.\n\nTest steps:\n\n- Receiver gets with a non-matching source thread and a finite timeout.\n\nExpected result:\n\n- k_mbox_get() returns -EAGAIN after the timeout.\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_api__test_mbox_timed_out_mbox_get"
        }
      ],
      "name": "mbox_api__test_mbox_timed_out_mbox_get",
      "summary": "Verify a get with no matching message times out with -EAGAIN."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-usage--test-msg-receiver-unlimited",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A receiver blocking with K_FOREVER and filtering on a specific sender thread must receive that thread's message once it is sent, exercising directed, unbounded-wait delivery.\n\nTest steps:\n\n- Start a sender thread that puts a message with K_FOREVER.\n- Receive filtering on that sender's tid with K_FOREVER.\n\nExpected result:\n\n- The receiver obtains the message from the specified sender.\n\n*See also:* k_mbox_get()\n\n*See also:* k_mbox_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_usage__test_msg_receiver_unlimited"
        }
      ],
      "name": "mbox_usage__test_msg_receiver_unlimited",
      "summary": "Verify a blocking receive from a specific source thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-usage-1cpu--test-msg-receiver",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A k_mbox_get() with K_NO_WAIT on an empty mailbox must not succeed, while a get with a finite timeout receives a message that a sender thread provides in time. Confirms the no-wait versus timed receive semantics in a usage scenario.\n\nTest steps:\n\n- Receive from K_ANY with K_NO_WAIT on an empty mailbox; expect failure.\n- Start a sender thread, then receive with a short timeout.\n\nExpected result:\n\n- The K_NO_WAIT get fails; the timed get receives the sender's message.\n\n*See also:* k_mbox_get()\n\n*See also:* k_mbox_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_usage_1cpu__test_msg_receiver"
        }
      ],
      "name": "mbox_usage_1cpu__test_msg_receiver",
      "summary": "Verify non-blocking receive fails and a timed receive gets a message."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mbox-usage-1cpu--test-multi-thread-send-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Two receiver threads of different priority block on the same mailbox, then two messages are put. Each message must be delivered to a waiting receiver, with the higher-priority thread served first, and the payloads must match.\n\nTest steps:\n\n- Start a low- and a high-priority receiver, each blocking on the mailbox.\n- Put two messages targeted at K_ANY.\n- Synchronize on a semaphore after both receivers complete.\n\nExpected result:\n\n- Both receivers obtain a message; the high-priority thread receives first and each payload matches what was sent.\n\n*See also:* k_mbox_put()\n\n*See also:* k_mbox_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mbox_usage_1cpu__test_multi_thread_send_get"
        }
      ],
      "name": "mbox_usage_1cpu__test_multi_thread_send_get",
      "summary": "Verify messages are delivered to multiple waiting receiver threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect--test-inherit-resource-pool",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "- Create a memory heap heap_mem for the parent thread.\n- Then special system call ret_resource_pool_ptr() returns pointer to the resource pool of the current thread.\n- Call it in the parent_handler() and in the child_handler()\n- Then in the main test function test_inherit_resource_pool() compare returned addresses\n- If the addresses are the same, it means that child thread inherited resource pool of the parent's thread -test passed.\n\n*See also:* k_thread_heap_assign()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect__test_inherit_resource_pool"
        }
      ],
      "name": "mem_protect__test_inherit_resource_pool",
      "summary": "Test child thread inherits parent's thread resource pool."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect--test-permission-inheritance",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "- To the parent current thread grant permissions on kernel objects.\n- Create a child thread and check that it inherited permissions on that kernel objects.\n- Then check child thread can't access to the parent thread object using API command k_thread_priority_get()\n- At the same moment that test verifies that child thread was granted permission on a kernel objects. That means child user thread caller already has permission on the thread objects being granted.\n\n*See also:* k_mem_domain_init(), k_mem_domain_add_thread(), k_thread_access_grant()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect__test_permission_inheritance"
        }
      ],
      "name": "mem_protect__test_permission_inheritance",
      "summary": "Test object permission inheritance except of the parent thread object."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-domain--test-mem-domain-api-supervisor-only",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The domain configuration calls have no syscall wrappers: they reshape the protection landscape and must be unreachable from user mode. A user thread invoking any of them has to fault on the attempt.\n\nTest steps:\n\n- From a user thread, call k_mem_domain_init(), add_partition, remove_partition and add_thread in turn.\n\nExpected result:\n\n- Each call faults before doing anything.\n\n*See also:* k_mem_domain_init()\n\n*See also:* k_mem_domain_add_partition()\n\n*See also:* k_mem_domain_remove_partition()\n\n*See also:* k_mem_domain_add_thread()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_domain__test_mem_domain_api_supervisor_only"
        }
      ],
      "name": "mem_protect_domain__test_mem_domain_api_supervisor_only",
      "summary": "Verify that the memory domain APIs are supervisor-only."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-domain--test-mem-domain-deinit-fail",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Try to de-initialize a domain with various invalid conditions.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_domain__test_mem_domain_deinit_fail"
        }
      ],
      "name": "mem_protect_domain__test_mem_domain_deinit_fail",
      "summary": "Test error case of de-initializing memory domain fail."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-domain--test-mem-domain-init-fail",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Try to initialize a domain with invalid partition. k_mem_domain_init() should return non-zero.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_domain__test_mem_domain_init_fail"
        }
      ],
      "name": "mem_protect_domain__test_mem_domain_init_fail",
      "summary": "Test error case of initializing memory domain fail."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-domain--test-mem-domain-invalid-access",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The same accesses as the valid case, made by a thread that was never added to the test domain, must fault: domain membership is what grants access, not the existence of the partition. The suite's fault hook marks the faults as expected.\n\nTest steps:\n\n- Spawn a user thread outside the test domain that touches the read-write partition.\n- Spawn another that touches the read-only partition.\n\nExpected result:\n\n- Both accesses fault.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_domain__test_mem_domain_invalid_access"
        }
      ],
      "name": "mem_protect_domain__test_mem_domain_invalid_access",
      "summary": "Verify that partitions outside a thread's domain are unreachable."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-domain--test-mem-domain-no-writes-to-ro",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Being inside the domain grants the declared permission, not more: a member thread writing data in the read-only partition must fault even though it can read it freely.\n\nTest steps:\n\n- Spawn a user thread in the test domain that writes a variable in the read-only partition.\n\nExpected result:\n\n- The write faults.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_domain__test_mem_domain_no_writes_to_ro"
        }
      ],
      "name": "mem_protect_domain__test_mem_domain_no_writes_to_ro",
      "summary": "Verify that a read-only partition rejects writes from its own domain."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-domain--test-mem-domain-remove-add-partition",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Removing a partition from a domain must revoke exactly that partition: other partitions stay reachable, the removed one faults, and adding it back restores access. All three transitions are observed from member user threads.\n\nTest steps:\n\n- Remove one read-write partition and show another is still accessible.\n- Access the removed partition and expect a fault.\n- Add the partition back and access it again.\n\nExpected result:\n\n- Access follows the domain's current partition set at each step.\n\n*See also:* k_mem_domain_remove_partition()\n\n*See also:* k_mem_domain_add_partition()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_domain__test_mem_domain_remove_add_partition"
        }
      ],
      "name": "mem_protect_domain__test_mem_domain_remove_add_partition",
      "summary": "Verify that partition removal and re-addition track access rights."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mem-protect-domain--test-mem-domain-valid-access",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A user thread that is a member of a domain must reach the data in that domain's partitions with exactly the declared permissions: read-write data is writable, read-only data is readable.\n\nTest steps:\n\n- Spawn a user thread in the test domain that reads and writes the read-write partition.\n- Spawn another that reads the read-only partition.\n\nExpected result:\n\n- Both accesses succeed with no fault.\n\n*See also:* k_mem_domain_add_thread()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_domain__test_mem_domain_valid_access"
        }
      ],
      "name": "mem_protect_domain__test_mem_domain_valid_access",
      "summary": "Verify that partitions in a thread's domain are accessible as declared."
    },
    {
      "type": "functionalsafety_RequirementVerification",
