    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-access-kernel-obj-with-priv-data",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The k_queue APIs keep bookkeeping data inside structures visible from user mode, so direct access must be gated by the kernel object permission system. A user thread without permission on the queue object that calls a k_queue API must trigger a kernel oops rather than read private kernel data.\nTest steps:\n- Initialize a queue and insert an item from supervisor mode.\n- Spawn a user thread (with no granted access) that calls k_queue_is_empty().\n- Mark the fault as expected and join the thread.\nExpected result:\n- The unprivileged access triggers the expected kernel oops.\nSee also: k_queue_is_empty()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "queue_api__test_access_kernel_obj_with_priv_data"
        }
      ],
      "name": "queue_api__test_access_kernel_obj_with_priv_data",
      "summary": "Verify a user thread faults accessing a queue it has no permission on."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-auto-free",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Elements added with the alloc APIs and the kernel objects allocated by the previous user-mode test must be released automatically (queue elements when dequeued, objects when permitted threads exit). The test confirms the whole pool is available again by reallocating all of it.\nTest steps:\n- After the preceding alloc-heavy test, allocate the entire pool in chunks.\n- Verify every allocation succeeds, then free them.\nExpected result:\n- All pool memory is reclaimable, proving prior resources were auto-freed.\nSee also: k_queue_alloc_append()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "queue_api__test_auto_free"
        }
      ],
      "name": "queue_api__test_auto_free",
      "summary": "Verify allocated queue resources are auto-freed back to the pool."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-multiple-queues",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "queue_api__test_multiple_queues"
        }
      ],
      "name": "queue_api__test_multiple_queues",
      "summary": "Operate on multiple independent queues."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-queue-alloc",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_queue_alloc_append()/k_queue_alloc_prepend() allocate a container from the calling thread's heap. With no pool (or a too-small pool) the insertion must fail and leave the queue empty; with a sufficient pool it must succeed and the item becomes retrievable.\nTest steps:\n- With no resource pool assigned, attempt an alloc append; verify it fails.\n- Assign a too-small pool, attempt an alloc prepend; verify it fails and the queue stays empty.\n- Assign a sufficient pool, alloc prepend succeeds and the item can be gotten.\nExpected result:\n- Allocation fails without enough pool memory and succeeds with it.\nSee also: k_queue_alloc_append()\nSee also: k_queue_alloc_prepend()\nSee also: k_thread_heap_assign()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "queue_api__test_queue_alloc"
        }
      ],
      "name": "queue_api__test_queue_alloc",
      "summary": "Verify alloc append/prepend honor the thread's resource pool."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-queue-alloc-append-null",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Verify that the parameter of the API is NULL, what will happen.\nSee also: k_queue_alloc_append()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
