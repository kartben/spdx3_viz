      "summary": "Work item processing order"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-4",
      "requirementStatement": "Unless configured otherwise, the work queue thread shall yield to other ready threads between processing successive work items.",
      "creationInfo": "zephyr:creationinfo",
