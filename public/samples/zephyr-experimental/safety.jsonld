    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-ramp--test-timer-ramp",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Schedules timers in a ramp of delays to verify that within a reasonable range of timeouts are schedulable correctly.\n\nIt could be that some timer drivers might have difficulty in scheduling some time periods but not others due to implementation details. This test should catch those.\n\nThe ramp is logrithmic up to what amounts to approximately 10 seconds of ticks.\n\n*See also:* k_timer_start()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_ramp__test_timer_ramp"
        }
      ],
      "name": "timer_ramp__test_timer_ramp",
      "summary": "Test timers can be scheduled in a ramp."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-tick-train--test-one-tick-timer-train",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Schedules timers with absolute scheduling with a 1 tick period. Measures the total time elapsed and tries to run some fake busy work while doing so. If the print outs don't show up or the timer train is late to the station, the test fails.\n\n*See also:* k_timer_start()\n\n*See also:* K_TIMEOUT_ABS_TICKS",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_tick_train__test_one_tick_timer_train"
        }
      ],
      "name": "timer_tick_train__test_one_tick_timer_train",
      "summary": "Test timers can be scheduled 1 tick apart without issues."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/usage-api--test-all-stats-usage",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "- Create a helper thread.\n- Busy loop for 2 ticks. Idle time should not increase.\n- Sleep for two ticks. Helper executes and busy loops. Idle time should not increase\n- Kill helper thread, and sleep for 2 ticks Idle time should increase\n- Busy loop for 3 ticks Idle time should not increase current, peak and average cycles should be different",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "usage_api__test_all_stats_usage"
        }
      ],
      "name": "usage_api__test_all_stats_usage",
      "summary": "Test the k_threads_runtime_stats_all_get() API."
    },
