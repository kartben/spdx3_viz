        }
      ],
      "name": "timer_jitter_drift__test_jitter_drift_timer_period",
      "summary": "Measure jitter and drift of a periodic timer."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-jitter-drift--test-jitter-drift-timer-startdelay",
