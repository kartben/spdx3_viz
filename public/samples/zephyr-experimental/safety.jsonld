    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-periodicity",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Timer test to check for the predictability with which the timer expires depending on the period configured.\nIt initializes the timer with k_timer_init(), then starts the timer using k_timer_start() with specific period. It resets the timer\u2019s status to zero with k_timer_status_sync and identifies the delta between each timer expiry to check for the timer expiration period correctness. Finally, stops the timer using k_timer_stop().\nSee also: k_timer_init(), k_timer_start(), k_timer_status_sync(), k_timer_stop(), k_uptime_get(), k_uptime_delta()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_periodicity"
        }
      ],
      "name": "timer_api__test_timer_periodicity",
      "summary": "Test to check timer periodicity."
    },
