      "summary": "Work item submission to a specified work queue"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-12",
      "requirementStatement": "The Zephyr RTOS shall allow a work item to be submitted from either a thread or an interrupt service routine.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
