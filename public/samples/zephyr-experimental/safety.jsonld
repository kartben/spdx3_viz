      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-27-14"
        }
      ],
      "name": "ZEP-SRS-27-14: Reporting matching events on wait completion",
      "summary": "Reporting matching events on wait completion"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-27-15",
      "requirementStatement": "When a thread waits on an event object, the Zephyr RTOS shall accept an option to clear the events tracked by the event object before the wait begins.",
