    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-api--test-mslab-kinit",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Initialize 3 memory blocks of block size 8 bytes using\n\n*See also:* k_mem_slab_init() and check if number of used blocks is 0 and free blocks is equal to number of blocks initialized.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_api__test_mslab_kinit"
        }
      ],
      "name": "mslab_api__test_mslab_kinit",
      "summary": "Initialize the memory slab using k_mem_slab_init() and allocates/frees blocks."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-api--test-mslab-object",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Initialize a memory slab over a caller-provided buffer and verify the defining properties of a memory slab object: every allocated block is a fixed-size region that lies within the provided memory range, the blocks are distinct, the slab provides exactly the configured number of blocks, and a further allocation fails once they are exhausted.\n\n*See also:* k_mem_slab_init(), k_mem_slab_alloc(), k_mem_slab_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_api__test_mslab_object"
        }
      ],
      "name": "mslab_api__test_mslab_object",
      "summary": "Verify a memory slab allocates fixed-size blocks from a memory range."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-api--test-mslab-pending",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "First, helper thread got all memory blocks, and there is no free block left. k_mem_slab_alloc() with time out will fail and return -EAGAIN. Then k_mem_slab_alloc() without timeout tries to wait for a memory block until helper thread free one.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_api__test_mslab_pending"
        }
      ],
      "name": "mslab_api__test_mslab_pending",
      "summary": "Verify pending of allocating blocks."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-api--test-mslab-used-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test case allocates 3 blocks one after the other by checking for used block and free blocks in the memory slab - mslab. Once all 3 blocks are allocated, one more block is tried to allocates, which fails with return value -ENOMEM. It also checks the allocation with timeout. Again checks for used block and free blocks number using\n\n*See also:* k_mem_slab_num_used_get() and\n\n*See also:* k_mem_slab_num_free_get().",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_api__test_mslab_used_get"
        }
      ],
      "name": "mslab_api__test_mslab_used_get",
      "summary": "Verify count of allocated blocks."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-concept--test-mslab-alloc-wait-prio",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test allocates all blocks of memory slab and then spawns 3 threads with lowest priority and 2 more with same priority higher than first thread with delay 10ms and 20ms. Checks the behavior of alloc when requested by multiple threads\n\n*See also:* k_mem_slab_alloc()\n\n*See also:* k_mem_slab_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_concept__test_mslab_alloc_wait_prio"
        }
      ],
      "name": "mslab_concept__test_mslab_alloc_wait_prio",
      "summary": "Verify alloc with multiple threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-threadsafe--test-mslab-threadsafe",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Test creates 4 preemptive threads of equal priority. Then validates the synchronization of threads by allocating and freeing up the memory blocks in memory slab.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_threadsafe__test_mslab_threadsafe"
        }
      ],
      "name": "mslab_threadsafe__test_mslab_threadsafe",
      "summary": "Verify alloc and free from multiple equal priority threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api--test-complex-inversion",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "This thread orchestrates mutex locking on other threads and verifies that the correct thread is holding mutexes at any given step.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api__test_complex_inversion"
        }
      ],
      "name": "mutex_api__test_complex_inversion",
      "summary": "Main thread to test mutex locking."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api--test-mutex-define",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A mutex created with K_MUTEX_DEFINE() must be fully initialized at boot: unowned and immediately lockable without any run-time initialization call. The mutex used here is touched by no other test, so it is exercised exactly as the macro left it.\n\nTest steps:\n\n- Lock the statically defined mutex with K_NO_WAIT.\n- Unlock it.\n\nExpected result:\n\n- Both operations succeed without any prior k_mutex_init() call.\n\n*See also:* K_MUTEX_DEFINE",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api__test_mutex_define"
        }
      ],
      "name": "mutex_api__test_mutex_define",
      "summary": "Verify a mutex defined at compile time is ready for use."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api--test-mutex-init",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_mutex_init() must succeed and yield an unowned mutex that is immediately lockable.\n\nTest steps:\n\n- Initialize a mutex at run time and check the call succeeds.\n- Lock it with K_NO_WAIT and unlock it.\n\nExpected result:\n\n- Initialization returns 0 and the mutex is immediately usable.\n\n*See also:* k_mutex_init()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api__test_mutex_init"
        }
      ],
      "name": "mutex_api__test_mutex_init",
      "summary": "Verify run-time initialization of a mutex."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api--test-mutex-recursive",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "To verify that getting a lock of a mutex already locked will succeed and waiters will be unblocked only when the number of locks reaches zero.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api__test_mutex_recursive"
        }
      ],
      "name": "mutex_api__test_mutex_recursive",
      "summary": "Test recursive mutex."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api--test-mutex-reent-lock-no-wait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "While the mutex is held by another thread, a K_NO_WAIT lock attempt must return without blocking. Exercised on a run-time and a K_MUTEX_DEFINE() mutex.\n\n*See also:* k_mutex_lock()\n\n*See also:* k_mutex_unlock()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api__test_mutex_reent_lock_no_wait"
        }
      ],
      "name": "mutex_api__test_mutex_reent_lock_no_wait",
