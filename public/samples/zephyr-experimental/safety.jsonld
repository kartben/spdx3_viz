    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-queue-isr2thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Items are enqueued in thread context and dequeued from interrupt context (via irq_offload()), confirming k_queue_get() is ISR-safe and the ISR receives every item. Run against both an init()ed and a DEFINE()d queue.\nTest steps:\n- In thread context, insert items into the queue.\n- From an ISR, get all items and verify their addresses/order.\n- Repeat for a statically defined queue.\nExpected result:\n- The ISR dequeues every thread-enqueued item in the expected order.\nSee also: k_queue_append()\nSee also: k_queue_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "queue_api__test_queue_isr2thread"
        }
      ],
      "name": "queue_api__test_queue_isr2thread",
      "summary": "Verify data passes from a thread to an ISR through a queue."
    },
    {
      "type": "functionalsafety_RequirementVerification",
