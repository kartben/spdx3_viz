      "summary": "Verify a work queue processes work items in submission order."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-queue-yield",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A cooperative work queue with the default (yielding) policy runs two work items. The first item makes an equal-priority competitor thread runnable; because the queue yields between items, the competitor runs before the second item, producing the interleaving \"0C1\".\n\n*See also:* k_work_queue_start()\n\n*See also:* k_work_init()\n\n*See also:* k_work_submit_to_queue()\n\n*See also:* k_work_queue_drain()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work_1cpu__test_1cpu_queue_yield"
        }
      ],
      "name": "work_1cpu__test_1cpu_queue_yield",
      "summary": "Verify a work queue yields between processing successive work items."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-queued-cancel",
