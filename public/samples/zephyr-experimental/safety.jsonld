        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A helper thread calls k_condvar_wait() with a 0 tick timeout and returns -EAGAIN without blocking. Only afterwards does a second thread signal the condition variable. The test confirms the non-blocking wait result is unaffected by the later signal.\nExpected result:\n- k_condvar_wait() returns -EAGAIN (verified in condvar_wait_wake_task()).\n- k_condvar_signal() returns 0 with no waiter present.\nSee also: k_condvar_wait()\nSee also: k_condvar_signal()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "condvar_tests__test_condvar_nowait_returns_eagain"
        }
      ],
      "name": "condvar_tests__test_condvar_nowait_returns_eagain",
      "summary": "Verify a zero-timeout wait returns -EAGAIN even when a signal follows."
