    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-25-13",
      "requirementStatement": "The Zephyr RTOS shall handle message exchange via a mailbox object non-anonymously, allowing both the sending and receiving threads to know the identity of the other thread.",
