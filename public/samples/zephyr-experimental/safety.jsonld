    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-queued-flush",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Two items with delaying handlers are submitted to a cooperative queue so neither has started when the test flushes the second one. The flush must block until that item's handler has run, which also implies the item queued ahead of it completed first.\n\nTest steps:\n\n- Submit two work items with delaying handlers to the cooperative queue.\n- Verify both are still queued and no handler has run.\n- Call k_work_flush() on the second item.\n\nExpected result:\n\n- The flush returns only after both handlers have completed, in submission order.\n\n*See also:* k_work_flush()\n\n*See also:* k_work_submit_to_queue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work_1cpu__test_1cpu_queued_flush"
        }
      ],
      "name": "work_1cpu__test_1cpu_queued_flush",
      "summary": "Verify k_work_flush() waits for a queued item to complete."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-reentrant-queue",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Verify that if a work item is submitted while it is being run by a queue thread it gets submitted to the queue it's running on, to prevent reentrant invocation, at least on a single CPU.\n\n*See also:* k_work_init()\n\n*See also:* k_work_submit_to_queue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work_1cpu__test_1cpu_reentrant_queue"
        }
      ],
      "name": "work_1cpu__test_1cpu_reentrant_queue",
      "summary": "Verify a work item handler can resubmit the work item."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-running-cancel",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Single CPU test cancellation after work starts.\n\n*See also:* k_work_init()\n\n*See also:* k_work_submit_to_queue()\n\n*See also:* k_work_cancel()\n\n*See also:* k_work_cancel_sync()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work_1cpu__test_1cpu_running_cancel"
        }
      ],
      "name": "work_1cpu__test_1cpu_running_cancel",
      "summary": "Verify cancelling a work item whose handler is running."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-running-cancel-sync",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A work item whose handler blocks is started on a cooperative queue, then cancelled synchronously. Because the handler is already running the cancellation cannot take effect immediately: the call must report that waiting was required and return only after the handler has completed, while resubmission during cancellation is rejected.\n\nTest steps:\n\n- Submit a work item with a blocking handler and let it start running.\n- Call k_work_cancel_sync() on the running item from a timer-driven context that also releases the handler.\n- Attempt to resubmit the item while cancellation is in progress.\n\nExpected result:\n\n- k_work_cancel_sync() returns true (waiting was required), the resubmission is rejected with -EBUSY, and the item ends with no busy flags set.\n\n*See also:* k_work_cancel_sync()\n\n*See also:* k_work_busy_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work_1cpu__test_1cpu_running_cancel_sync"
        }
      ],
      "name": "work_1cpu__test_1cpu_running_cancel_sync",
      "summary": "Verify k_work_cancel_sync() waits for a running item to finish."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-running-flush",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Single CPU submit a work item and wait for flush after it's started.\n\n*See also:* k_work_init()\n\n*See also:* k_work_submit_to_queue()\n\n*See also:* k_work_busy_get()\n\n*See also:* k_work_flush()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work_1cpu__test_1cpu_running_flush"
        }
      ],
      "name": "work_1cpu__test_1cpu_running_flush",
      "summary": "Verify flushing a running work item waits for it to finish."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-simple-queue",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Basic single-CPU check submitting with a non-blocking handler.\n\n*See also:* k_work_init()\n\n*See also:* k_work_busy_get()\n\n*See also:* k_work_is_pending()\n\n*See also:* k_work_submit_to_queue()",
