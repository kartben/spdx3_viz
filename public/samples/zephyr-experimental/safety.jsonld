    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-6",
      "requirementStatement": "When a work queue is drained, the Zephyr RTOS shall accept an option that prevents further work items from being submitted to the work queue until it is explicitly unblocked.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
