          "identifier": "mem_protect_kobj__test_create_new_thread_from_user_invalid_stacksize"
        }
      ],
      "name": "mem_protect_kobj__test_create_new_thread_from_user_invalid_stacksize",
      "summary": "Test to validate user thread spawning with stack overflow."
    },
