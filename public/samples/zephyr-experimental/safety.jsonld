    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-system-schedule",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "*See also:* k_work_init_delayable()\n\n*See also:* k_work_delayable_busy_get()\n\n*See also:* k_work_schedule()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work_1cpu__test_1cpu_system_schedule"
        }
      ],
      "name": "work_1cpu__test_1cpu_system_schedule",
      "summary": "Scheduling a delayable work item on the system work queue."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-api--test-k-work-delayable-remaining",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Schedule a delayable work item for a future delay and verify k_work_delayable_remaining_get() reports a remaining time within the scheduled delay; an unscheduled (or cancelled) item reports zero remaining time.\n\n*See also:* k_work_schedule(), k_work_delayable_remaining_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_api__test_k_work_delayable_remaining"
        }
      ],
      "name": "workqueue_api__test_k_work_delayable_remaining",
      "summary": "Verify querying the remaining delay of a delayable work item."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-api--test-k-work-queue-priority",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Start a work queue with a specific priority and verify the queue's dedicated thread runs at that priority, as reported by k_thread_priority_get() on the queue's thread.\n\n*See also:* k_work_queue_start(), k_work_queue_thread_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_api__test_k_work_queue_priority"
        }
      ],
      "name": "workqueue_api__test_k_work_queue_priority",
      "summary": "Verify a work queue's dedicated thread runs at the configured priority."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-api--test-k-work-queue-run-stop",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_work_queue_run() turns the calling thread into a work queue's server thread. This test runs a queue from a dedicated thread, submits and drains work, and confirms the queue can then be stopped (and that stop is rejected while the queue is running and unplugged, and that submitting to a stopped queue fails).\n\nTest steps:\n\n- Start a thread that serves a work queue via k_work_queue_run().\n- Submit work items and wait for them to complete.\n- Confirm k_work_queue_stop() returns -EBUSY while running and unplugged.\n- Drain and plug the queue, then stop it.\n- Confirm submitting to the stopped queue and the server thread exiting both behave as expected.\n\nExpected result:\n\n- The queue stops cleanly once drained and plugged, submitting afterwards returns -ENODEV, and the server thread releases its completion semaphore.\n\n*See also:* k_work_queue_run()\n\n*See also:* k_work_queue_stop()\n\n*See also:* k_work_queue_drain()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_api__test_k_work_queue_run_stop"
        }
      ],
      "name": "workqueue_api__test_k_work_queue_run_stop",
      "summary": "Verify a work queue served by k_work_queue_run() can be stopped."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-api--test-k-work-queue-start-stop",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Start a work queue, submit and drain work items, and verify the queue's dedicated thread can be stopped with k_work_queue_stop() (and that stopping reports the appropriate error when the queue is uninitialized or still running).\n\n*See also:* k_work_queue_start()\n\n*See also:* k_work_queue_stop()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_api__test_k_work_queue_start_stop"
        }
      ],
      "name": "workqueue_api__test_k_work_queue_start_stop",
      "summary": "Verify starting and stopping a work queue's dedicated thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-api--test-k-work-queue-stop-sys-thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A work queue started with the essential configuration flag runs an essential thread that must not be torn down. This test confirms k_work_queue_stop() refuses to stop such a queue even after it has been drained and plugged.\n\nTest steps:\n\n- Start a work queue configured as essential.\n- Drain and plug the queue.\n- Attempt to stop the queue with k_work_queue_stop().\n\nExpected result:\n\n- k_work_queue_stop() returns -ENOTSUP.\n\n*See also:* k_work_queue_start()\n\n*See also:* k_work_queue_stop()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_api__test_k_work_queue_stop_sys_thread"
        }
      ],
      "name": "workqueue_api__test_k_work_queue_stop_sys_thread",
      "summary": "Verify an essential work queue thread cannot be stopped."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-api--test-workq-user-mode",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A user-mode work queue is started, the user thread is granted access to the objects it needs, and user work items are initialized, submitted and run to completion. The submission error paths are exercised as well: an item still pending on the queue cannot be queued twice, and submission fails when the thread resource pool is exhausted.\n\nTest steps:\n\n- Start a user-mode work queue with k_work_user_queue_start().\n- Grant the work queue thread access to a kernel object and verify a handler running on the queue can use it.\n- Initialize and submit user work items and wait for their handlers to run.\n- Resubmit an item that is still pending and verify it is not queued twice.\n- Exhaust the thread resource pool and verify submission fails.\n\nExpected result:\n\n- Submitted user work items execute exactly once, and both error paths (already pending, out of memory) refuse the submission.\n\n*See also:* k_work_user_queue_start()\n\n*See also:* k_work_user_init()\n\n*See also:* k_work_user_submit_to_queue()\n\n*See also:* k_work_user_is_pending()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_api__test_workq_user_mode"
        }
      ],
      "name": "workqueue_api__test_workq_user_mode",
      "summary": "Verify a user-mode work queue runs work submitted from user mode."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-delayed--test-delayed",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Multiple delayable work items are scheduled (and rescheduled) from preempt and co-op threads with increasing delays. Each item must be submitted to its work queue when its delay elapses and then have its handler invoked, so that every item completes.\n\nTest steps:\n\n- Initialize the delayable work items.\n- Schedule and reschedule them with staggered, increasing delays from two threads.\n- Wait for all delays to elapse.\n- Verify every item's handler ran.\n\nExpected result:\n\n- All delayable work items are submitted on delay expiry and processed.\n\n*See also:* k_work_schedule()\n\n*See also:* k_work_reschedule()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_delayed__test_delayed"
        }
      ],
      "name": "workqueue_delayed__test_delayed",
      "summary": "Verify delayable work items are submitted to their queue when their delay elapses."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-delayed--test-delayed-cancel",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A delayable work item is scheduled with a future delay and then cancelled (from both a preempt and a co-op thread) before the delay elapses. Because the item never reaches its work queue, its handler must not run.\n\nTest steps:\n\n- Schedule a delayable work item with a future delay.\n- Cancel it with k_work_cancel_delayable() before the delay elapses.\n- Repeat the schedule/cancel from a co-op thread.\n- Wait past the delay and confirm no handler ran.\n\nExpected result:\n\n- The handler is never invoked (zero results recorded).\n\n*See also:* k_work_schedule()\n\n*See also:* k_work_cancel_delayable()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_delayed__test_delayed_cancel"
        }
      ],
      "name": "workqueue_delayed__test_delayed_cancel",
      "summary": "Verify a scheduled delayable work item can be cancelled before it is submitted."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-delayed--test-delayed-pending",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_work_delayable_is_pending() reports whether a delayable work item is queued or waiting for its delay to elapse. This test confirms an uninitialized item is not pending, that scheduling it (immediately and with a delay) marks it pending, and that it stops being pending once processed.\n\nTest steps:\n\n- Initialize a delayable work item and confirm it is not pending.\n- Schedule it with K_NO_WAIT and confirm it becomes pending then clears once processed.\n- Schedule it with a delay and confirm it is pending until the delay elapses.\n\nExpected result:\n\n- k_work_delayable_is_pending() reflects the item's queued/waiting state at each step.\n\n*See also:* k_work_delayable_is_pending()\n\n*See also:* k_work_schedule()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_delayed__test_delayed_pending"
        }
      ],
      "name": "workqueue_delayed__test_delayed_pending",
      "summary": "Verify the pending status of a delayable work item."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-already-triggered",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "If the poll event of a triggered work item is already signalled before the item is submitted, the item must still run. This test raises the signals first and submits the items afterwards.\n\nTest steps:\n\n- Initialize the triggered work items and their poll signals/events.\n- Raise each signal before submitting.\n- Submit the items with k_work_poll_submit() and wait for them to run.\n\nExpected result:\n\n- Every triggered handler runs with a poll result of 0.\n\n*See also:* k_work_poll_init(), k_work_poll_submit()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_already_triggered"
        }
      ],
      "name": "workqueue_triggered__test_already_triggered",
      "summary": "Verify triggered (poll) work items run when their event is already signalled at submission."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-delayed-work-define",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A delayable work item can be defined statically with K_WORK_DELAYABLE_DEFINE() or initialized at run time with k_work_init_delayable(). This test confirms both produce a byte-for-byte identical delayable work item for the same handler.\n\nTest steps:\n\n- Define a delayable work item with K_WORK_DELAYABLE_DEFINE().\n- Initialize another with k_work_init_delayable() using the same handler.\n- Compare the two structures.\n\nExpected result:\n\n- The statically defined and run-time initialized items are identical.\n\n*See also:* K_WORK_DELAYABLE_DEFINE()\n\n*See also:* k_work_init_delayable()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_delayed_work_define"
        }
      ],
      "name": "workqueue_triggered__test_delayed_work_define",
      "summary": "Verify K_WORK_DELAYABLE_DEFINE() initializes a delayable work item identically to k_work_init_delayable()."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-resubmit",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A work item handler resubmits the same work item (with an incremented key) each time it runs, until a target count is reached. This confirms the work queue thread invokes the handler for every submission and that a completed work item may be submitted again from within its own handler.\n\nTest steps:\n\n- Initialize a work item whose handler resubmits itself until the target count is reached.\n- Submit the work item once and wait for all iterations to complete.\n- Verify the handler ran once per iteration in sequence.\n\nExpected result:\n\n- The handler is invoked for every (re)submission and all results are recorded in order.\n\n*See also:* k_work_submit()\n\n*See also:* k_work_schedule()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_resubmit"
        }
      ],
      "name": "workqueue_triggered__test_resubmit",
      "summary": "Verify a work item handler can resubmit its own work item."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-triggered",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Triggered work items are submitted against poll events and only run once the event becomes ready. This test submits the items, then raises their signals, and confirms each handler runs and observes a successful poll result.\n\nTest steps:\n\n- Initialize the triggered work items and their poll signals/events.\n- Submit the items with k_work_poll_submit() (K_FOREVER timeout).\n- Raise each signal and wait for the handlers to run.\n\nExpected result:\n\n- Every triggered handler runs with a poll result of 0.\n\n*See also:* k_work_poll_init(), k_work_poll_submit()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_triggered"
        }
      ],
      "name": "workqueue_triggered__test_triggered",
      "summary": "Verify triggered (poll) work items run once their event is signalled."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-triggered-cancel",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Cancelling a submitted triggered work item succeeds, while cancelling an item that is no longer cancellable, or a NULL item, must report an error. This test exercises each case in turn.\n\nTest steps:\n\n- Submit a triggered work item and cancel it with k_work_poll_cancel().\n- Cancel the same item again.\n- Cancel a NULL work item.\n\nExpected result:\n\n- The first cancel returns 0; the repeated cancel and the NULL cancel both return -EINVAL.\n\n*See also:* k_work_poll_cancel()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_triggered_cancel"
        }
      ],
      "name": "workqueue_triggered__test_triggered_cancel",
      "summary": "Verify k_work_poll_cancel() return values for triggered work items."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-triggered-from-msgq",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Regression test for issue #45267: when an object-availability event triggers a k_work_poll item, the triggering object's lock must no longer be held while the work callback runs, so the callback can safely access that object. The test arms a triggered work item on a K_POLL_TYPE_MSGQ_DATA_AVAILABLE event and has a provider thread put a message, whose handler then drains the queue.\n\nTest steps:\n\n- Initialize a message queue, a consumer work queue and a triggered work item armed on the message queue's data-available event.\n- Start a provider thread that puts a message into the queue.\n\nExpected result:\n\n- The triggered handler runs and consumes the message without deadlocking on the message queue lock.\n\n*See also:* k_work_poll_init()\n\n*See also:* k_work_poll_submit_to_queue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_triggered_from_msgq"
        }
      ],
      "name": "workqueue_triggered__test_triggered_from_msgq",
      "summary": "Verify a triggered (poll) work item can be triggered by a message queue becoming readable."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-triggered-no-wait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When a triggered work item is submitted with a K_NO_WAIT timeout and its poll event is already signalled, the item must run rather than expire. This test raises the signals first, then submits with K_NO_WAIT.\n\nTest steps:\n\n- Initialize the triggered work items.\n- Raise each signal, then submit the items with a K_NO_WAIT timeout.\n\nExpected result:\n\n- Every triggered handler runs with a poll result of 0.\n\n*See also:* k_work_poll_init(), k_work_poll_submit()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_triggered_no_wait"
        }
      ],
      "name": "workqueue_triggered__test_triggered_no_wait",
      "summary": "Verify triggered (poll) work items submitted with K_NO_WAIT run when already signalled."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-triggered-no-wait-expired",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When a triggered work item is submitted with a K_NO_WAIT timeout and its poll event is not signalled, the item must run immediately reporting an expired poll result. This test submits with K_NO_WAIT without raising any signal.\n\nTest steps:\n\n- Initialize the triggered work items.\n- Submit the items with a K_NO_WAIT timeout and do not raise their signals.\n\nExpected result:\n\n- Every triggered handler runs with a poll result of -EAGAIN.\n\n*See also:* k_work_poll_init(), k_work_poll_submit()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_triggered_no_wait_expired"
        }
      ],
      "name": "workqueue_triggered__test_triggered_no_wait_expired",
      "summary": "Verify triggered (poll) work items submitted with K_NO_WAIT expire when not signalled."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-triggered-resubmit",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A triggered work item handler resets its signal and resubmits the same item each time it runs, until a target count is reached. This confirms a triggered item may be resubmitted from within its own handler and re-runs each time its event is signalled.\n\nTest steps:\n\n- Initialize a triggered work item whose handler resubmits itself.\n- Submit it and repeatedly raise its signal up to the target count.\n\nExpected result:\n\n- The handler runs once per iteration and all results are recorded in order.\n\n*See also:* k_work_poll_init(), k_work_poll_submit()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_triggered_resubmit"
        }
      ],
      "name": "workqueue_triggered__test_triggered_resubmit",
      "summary": "Verify a triggered (poll) work item can resubmit itself from its handler."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-triggered-wait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When a triggered work item is submitted with a finite timeout and its poll event is signalled before the timeout elapses, the item must run reporting a successful poll result. This test raises the signals, then submits with a finite timeout.\n\nTest steps:\n\n- Initialize the triggered work items.\n- Raise each signal, then submit the items with a finite timeout.\n\nExpected result:\n\n- Every triggered handler runs with a poll result of 0.\n\n*See also:* k_work_poll_init(), k_work_poll_submit()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_triggered_wait"
        }
      ],
      "name": "workqueue_triggered__test_triggered_wait",
      "summary": "Verify triggered (poll) work items run when signalled before a finite timeout elapses."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-triggered--test-triggered-wait-expired",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When a triggered work item is submitted with a finite timeout and its poll event is never signalled, the item must not run until the timeout elapses, at which point it runs reporting an expired poll result. This test checks the items have not run before the timeout and have run (as expired) afterwards.\n\nTest steps:\n\n- Initialize and submit the triggered work items with a finite timeout.\n- Confirm none have run before the timeout elapses.\n- Wait past the timeout and confirm all have run.\n\nExpected result:\n\n- No handler runs before the timeout; afterwards every handler runs with a poll result of -EAGAIN.\n\n*See also:* k_work_poll_init(), k_work_poll_submit()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_triggered__test_triggered_wait_expired"
        }
      ],
      "name": "workqueue_triggered__test_triggered_wait_expired",
      "summary": "Verify triggered (poll) work items expire after a finite timeout when never signalled."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/workqueue-work-timeout--test-work",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A work queue configured with a work timeout monitors how long each work item handler runs. This test submits several short items (which must not trip the timeout) followed by a blocking item that runs forever, and confirms the work queue thread is aborted only when work timeout monitoring is enabled.\n\nTest steps:\n\n- Submit several work items that each run for less than the timeout.\n- Confirm the work queue thread is not aborted while processing them.\n- Submit a work item whose handler blocks forever.\n- Join the work queue thread.\n\nExpected result:\n\n- With CONFIG_WORKQUEUE_WORK_TIMEOUT enabled the thread is aborted (join returns 0); otherwise the join times out with -EAGAIN.\n\n*See also:* k_work_queue_start()\n\n*See also:* k_work_submit_to_queue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "workqueue_work_timeout__test_work"
        }
      ],
