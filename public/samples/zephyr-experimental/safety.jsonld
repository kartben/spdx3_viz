      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test validates k_heap_realloc() API by:\n\n- Allocating memory and reallocating to a larger size\n- Reallocating to a smaller size\n- Verifying data integrity after reallocation\n\n*See also:* k_heap_realloc()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_k_heap_realloc"
        }
      ],
      "name": "k_heap_api__test_k_heap_realloc",
      "summary": "Test k_heap_realloc() API functionality."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-k-heap-realloc-fail",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test validates that k_heap_realloc() returns NULL when trying to reallocate to a size larger than the heap.\n\n*See also:* k_heap_realloc()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_k_heap_realloc_fail"
        }
      ],
      "name": "k_heap_api__test_k_heap_realloc_fail",
      "summary": "Test k_heap_realloc() failure case."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-k-heap-realloc-null",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test validates that k_heap_realloc() behaves like k_heap_alloc() when called with a NULL pointer.\n\n*See also:* k_heap_realloc()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_k_heap_realloc_null"
        }
      ],
      "name": "k_heap_api__test_k_heap_realloc_null",
      "summary": "Test k_heap_realloc() with NULL pointer."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-k-heap-realloc-zero",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test validates that k_heap_realloc() behaves like k_heap_free() when called with size 0.\n\n*See also:* k_heap_realloc()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
