          "identifier": "ZEP-SRS-27-15"
        }
      ],
      "name": "ZEP-SRS-27-15: Resetting events before waiting",
      "summary": "Resetting events before waiting"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-27-2",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to initialize an event object at run time.",
