      "summary": "Test thread join."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-lifecycle--test-thread-join-deadlock",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "This test verifies the behavior of the k_thread_join API in scenarios that could lead to deadlocks. It includes the following checks:\n- Ensures that a thread cannot join itself, which would result in a self-deadlock. The API should return -EDEADLK in this case.\n- Creates two threads (deadlock1_thread and deadlock2_thread) and verifies that they can be joined successfully without causing a deadlock.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "threads_lifecycle__test_thread_join_deadlock"
        }
      ],
      "name": "threads_lifecycle__test_thread_join_deadlock",
      "summary": "Test case for thread join deadlock scenarios."
    },
