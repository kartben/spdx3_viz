    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/obj-core-stats-system--test-obj-core-stats-kernel-reset",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The kernel object core does not implement a statistics reset operation. Confirm that requesting a reset for the kernel object core is rejected.\n\nTest steps:\n\n- Call k_obj_core_stats_reset() for the kernel object core.\n\nExpected result:\n\n- The call returns -ENOTSUP.\n\n*See also:* k_obj_core_stats_reset()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "obj_core_stats_system__test_obj_core_stats_kernel_reset"
