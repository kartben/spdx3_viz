      "summary": "Querying a thread state"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-1-22",
      "requirementStatement": "Where multithreading is disabled, the Zephyr RTOS shall execute the application as a single thread of control.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-1-22"
        }
      ],
      "name": "ZEP-SRS-1-22: Single-thread operation",
      "summary": "Single-thread operation"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-1-23",
      "requirementStatement": "Where thread-local storage is enabled, the Zephyr RTOS shall give each thread its own instance of variables declared as thread-local.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-1-23"
        }
      ],
      "name": "ZEP-SRS-1-23: Thread-local storage",
      "summary": "Thread-local storage"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-1-24",
      "requirementStatement": "Where dynamic threads are enabled, the Zephyr RTOS shall provide a mechanism to allocate a thread stack at run time.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-1-24"
        }
      ],
      "name": "ZEP-SRS-1-24: Allocating a thread stack at run time",
      "summary": "Allocating a thread stack at run time"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-1-25",
      "requirementStatement": "Where dynamic threads are enabled, the Zephyr RTOS shall provide a mechanism to release a thread stack that was allocated at run time.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
