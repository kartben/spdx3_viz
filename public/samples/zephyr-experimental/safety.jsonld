    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api-1cpu--test-mutex-timeout-race-during-priority-inversion",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "- A low priority thread (Tlow) locks mutex A.\n- A high priority thread (Thigh) blocks on mutex A, boosting the priority of Tlow.\n- Thigh times out waiting for mutex A.\n- Before Thigh has a chance to execute, Tlow unlocks mutex A (which now has no owner) and drops its own priority.\n- Thigh now gets a chance to execute and finds that it timed out, and then enters the block of code to lower the priority of the thread that owns mutex A (now nobody).\n- Thigh tries to the dereference the owner of mutex A (which is nobody, and thus it is NULL). This leads to an exception.\n\n*See also:* k_mutex_lock()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api_1cpu__test_mutex_timeout_race_during_priority_inversion"
        }
      ],
      "name": "mutex_api_1cpu__test_mutex_timeout_race_during_priority_inversion",
      "summary": "Test fix for subtle race during priority inversion."
    },
