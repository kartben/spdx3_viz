    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/device--test-deinit-success-and-redeinit",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Verify device_deinit() succeeds for a device that provides a de-initialization function, and that a subsequent de-init is rejected.\n\n*See also:* device_deinit",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "device__test_deinit_success_and_redeinit"
        }
      ],
      "name": "device__test_deinit_success_and_redeinit",
      "summary": "Test de-initializing a device at runtime."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/device--test-device-init-level",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "After the defined device instances have initialized, we check the sequence number that each driver stored during initialization. If the sequence of initial level stored is corresponding with our expectation, it means assigning the level for driver instance works.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "device__test_device_init_level"
        }
      ],
      "name": "device__test_device_init_level",
      "summary": "Test initialization level for device driver instances."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/device--test-device-init-priority",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "After the defined device instances have initialized, we check the sequence number that each driver stored during initialization. If the sequence of initial priority stored is corresponding with our expectation, it means assigning the priority for driver instance works.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "device__test_device_init_priority"
        }
      ],
      "name": "device__test_device_init_priority",
      "summary": "Test initialization priorities for device driver instances."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/device--test-device-init-sub-priority",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "After the defined device instances have initialized, we check the sequence number that each driver stored during initialization. If the sequence of initial priority stored is corresponding with our expectation, it means using the devicetree for sub-priority sorting works.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "device__test_device_init_sub_priority"
        }
      ],
      "name": "device__test_device_init_sub_priority",
      "summary": "Test initialization sub-priorities for device driver instances."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/device--test-pre-kernel-detection",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Confirms check is correct.\n\n*See also:* k_is_pre_kernel()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "device__test_pre_kernel_detection"
        }
      ],
      "name": "device__test_pre_kernel_detection",
      "summary": "Test detection of initialization before kernel services available."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/device--test-sys-init-multiple",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Register the same initialization function multiple times with SYS_INIT() and SYS_INIT_NAMED() at the same initialization level but different priorities, and verify that every registered entry is invoked during system initialization.\n\n*See also:* SYS_INIT()\n\n*See also:* SYS_INIT_NAMED()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "device__test_sys_init_multiple"
        }
      ],
      "name": "device__test_sys_init_multiple",
      "summary": "Test registering multiple initialization functions."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/dynamic-thread-stack--test-dynamic-thread-stack-alloc",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "With CONFIG_DYNAMIC_THREAD_PREFER_ALLOC the stacks come from the heap instead of the fixed pool, so the number available is bounded by memory rather than by a compile-time count. Each allocated stack has to carry a running thread, and freeing them has to return the memory so the sequence can be repeated. Skipped when heap allocation is not the preferred allocator.\n\nTest steps:\n\n- Allocate stacks from the heap up to the test's limit.\n- Create and start a thread on each stack.\n- Join every thread and check the flag it raised.\n- Free all stacks.\n\nExpected result:\n\n- Every allocation succeeds, all threads run, and all stacks are freed without error.\n\n*See also:* k_thread_stack_alloc()\n\n*See also:* k_thread_stack_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "dynamic_thread_stack__test_dynamic_thread_stack_alloc"
        }
      ],
      "name": "dynamic_thread_stack__test_dynamic_thread_stack_alloc",
      "summary": "Verify that thread stacks can be allocated from the heap."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/dynamic-thread-stack--test-dynamic-thread-stack-permission",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A dynamically allocated stack is owned by the thread it was granted to, so k_thread_stack_free() must refuse a caller that was never given access to it. Two threads are started on two separately allocated stacks and one of them attempts to free the other's, which must fault rather than release memory still in use. Skipped when heap allocation is not the preferred allocator.\n\nTest steps:\n\n- Allocate two thread stacks and start a thread on each.\n- Have the second thread call k_thread_stack_free() on the first thread's stack, which it was not granted.\n- Observe that the violating thread does not run past that call.\n\nExpected result:\n\n- The attempt faults instead of freeing the stack, and the code after it is never reached.\n\n*See also:* k_thread_stack_free()\n\n*See also:* k_thread_stack_alloc()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "dynamic_thread_stack__test_dynamic_thread_stack_permission"
        }
      ],
      "name": "dynamic_thread_stack__test_dynamic_thread_stack_permission",
      "summary": "Verify that a thread cannot free a stack it does not own."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/dynamic-thread-stack--test-dynamic-thread-stack-pool",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "With CONFIG_DYNAMIC_THREAD_PREFER_POOL the allocator hands out stacks from a fixed pool of CONFIG_DYNAMIC_THREAD_POOL_SIZE entries. Allocating exactly that many stacks must succeed, and each one has to be usable as a real thread stack rather than merely being a non-NULL pointer, which is why a thread is run on every one of them. Skipped when the pool is not the preferred allocator.\n\nTest steps:\n\n- Allocate one stack per pool entry.\n- Create and start a thread on each stack.\n- Join every thread and check the flag it raised.\n- Free all stacks back to the pool.\n\nExpected result:\n\n- The pool satisfies every allocation, all threads run, and all stacks are freed without error.\n\n*See also:* k_thread_stack_alloc()\n\n*See also:* k_thread_stack_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "dynamic_thread_stack__test_dynamic_thread_stack_pool"
        }
      ],
      "name": "dynamic_thread_stack__test_dynamic_thread_stack_pool",
      "summary": "Verify that the thread stack pool serves and reclaims every slot."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/dynamic-thread-stack--test-dynamic-thread-stack-userspace-dyn-obj",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A user thread has no statically defined thread object or stack to hand to k_thread_create(), so both have to come from the dynamic allocators: the thread object from k_object_alloc() and the stack from k_thread_stack_alloc() with K_USER. The spawned thread raises a flag, so a pass proves the pair of dynamic objects really produced a runnable user thread. Skipped when userspace is not enabled.\n\nTest steps:\n\n- Allocate a thread object and a user-mode thread stack.\n- Create and start a user thread on them.\n- Join the thread with a timeout and check its flag.\n- Free the stack.\n\nExpected result:\n\n- Both allocations succeed, the thread runs and sets its flag, and the stack is freed without error.\n\n*See also:* k_thread_stack_alloc()\n\n*See also:* k_object_alloc()\n\n*See also:* k_thread_create()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "dynamic_thread_stack__test_dynamic_thread_stack_userspace_dyn_obj"
        }
      ],
      "name": "dynamic_thread_stack__test_dynamic_thread_stack_userspace_dyn_obj",
      "summary": "Verify that a user thread can create a thread from dynamic objects."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-event-post",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Exercises the posting system call without any waking or blocking, validating both the resulting set of posted events and the previous value each call returns. Runs as a user-mode test so the post system call is also exercised from an unprivileged thread.\n\nTest steps:\n\n- Empty the event object and confirm it holds no events.\n- Post a first set of events and verify it is stored verbatim and that the call reports no prior events.\n- Post an overlapping second set and verify the new bits are ORed into the stored set while the call returns the prior state of the posted bits.\n\nExpected result:\n\n- After each call the stored events (read via k_event_test()) are the union of everything posted so far, and each call returns the previous state of the affected bits.\n\n*See also:* k_event_post()\n\n*See also:* k_event_test()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_event_post"
        }
      ],
      "name": "events_api__test_event_post",
      "summary": "Verify k_event_post() ORs new events into the stored set."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-event-receive-existing",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Drives a receiver thread through a scripted sequence of synchronization points to validate the matching rules of the blocking event APIs against a pre-loaded event object: an any-match wait completes when at least one requested event is present, an all-match wait completes only when every requested event is present, and a completed wait reports exactly the matching events. No events are posted while the receiver is waiting.\n\nTest steps:\n\n- Pre-load the event object with a known set of events (0x1234) and start the receiver thread.\n- Walk the receiver through k_event_wait() and k_event_wait_all() calls that should miss (no overlap, incomplete overlap) and verify each reports no events.\n- Walk the receiver through a partially matching k_event_wait() and a fully matching k_event_wait_all() and verify the returned bits.\n\nExpected result:\n\n- Waits whose condition is not met return 0, a matching any-wait returns only the overlapping bits (0x0234), and a matching all-wait returns exactly the requested bits (0x1234).\n\n*See also:* k_event_wait()\n\n*See also:* k_event_wait_all()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_event_receive_existing"
        }
      ],
      "name": "events_api__test_event_receive_existing",
      "summary": "Verify any/all matching of a wait against already-posted events."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-event-reset-on-wait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Drives a receiver thread through waits issued with the reset flag set, posting fresh events after each wait has started. Because the event object is cleared when the wait begins, only the newly posted events can satisfy the wait condition, and threads whose condition is met by the post are woken while others time out.\n\nTest steps:\n\n- Pre-load the event object and start the receiver thread.\n- Have the receiver wait with reset=true while events that do not satisfy the condition are posted; verify the wait times out, the pre-existing events were discarded and only the new post remains stored.\n- Repeat with posts that fully or partially satisfy the condition and verify the receiver is woken with exactly the matching events.\n\nExpected result:\n\n- Each wait observes only events posted after it started (prior events are reset), unsatisfied waits time out, and satisfied waits wake the receiver and return the matching events.\n\n*See also:* k_event_post()\n\n*See also:* k_event_wait()\n\n*See also:* k_event_wait_all()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_event_reset_on_wait"
        }
      ],
      "name": "events_api__test_event_reset_on_wait",
      "summary": "Verify the reset option clears prior events before waiting."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-event-set",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Exercises the set system call without any waking or blocking, validating that the stored events are replaced (not merged) and that the previous set is returned. Runs as a user-mode test so the set system call is also exercised from an unprivileged thread.\n\nTest steps:\n\n- Empty the event object and post a known set of events.\n- Overwrite the events with k_event_set() and verify the stored set is exactly the new value while the call returns the prior set.\n- Set a second value and verify the first one is reported back.\n\nExpected result:\n\n- After each call the stored events (read via k_event_test()) match the set value exactly, and each call returns the complete previous set.\n\n*See also:* k_event_set()\n\n*See also:* k_event_test()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_event_set"
        }
      ],
      "name": "events_api__test_event_set",
      "summary": "Verify k_event_set() overwrites the stored set of events."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-event-set-masked",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Exercises the masked-set system call without any waking or blocking, validating that only the events selected by the mask are set or cleared, that all other events are untouched, and that the previous state of the masked events is returned. Runs as a user-mode test so the masked-set system call is also exercised from an unprivileged thread.\n\nTest steps:\n\n- Set a known pattern of events (0x33333333).\n- Clear one masked subset at a time and verify only those bits drop out while their prior state is returned.\n- Set masked subsets and verify only the masked bits change, including a mask that simultaneously sets some bits and clears others.\n\nExpected result:\n\n- After each call the stored events (read via k_event_test()) differ from the prior state only in the masked bits, and each call returns the previous state of the masked bits.\n\n*See also:* k_event_set_masked()\n\n*See also:* k_event_test()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_event_set_masked"
        }
      ],
      "name": "events_api__test_event_set_masked",
      "summary": "Verify k_event_set_masked() changes only the masked events."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-event-wait-timeout",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Focused test for the timeout behavior of the blocking event APIs: a wait whose condition is not satisfied within the given timeout returns no events, and only after the timeout has elapsed. Runs as a user-mode test so the wait system calls are also exercised from an unprivileged thread.\n\nTest steps:\n\n- Empty the event object.\n- Wait for events with K_NO_WAIT and verify the immediate no-event return.\n- Wait for events with a finite timeout and verify no events are returned and at least the timeout duration elapsed.\n- Post a partial match and verify an all-match wait still times out.\n\nExpected result:\n\n- Each unsatisfied wait returns 0, the timed waits only return once their timeout has expired.\n\n*See also:* k_event_wait()\n\n*See also:* k_event_wait_all()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_event_wait_timeout"
        }
      ],
      "name": "events_api__test_event_wait_timeout",
      "summary": "Verify waiting for events accepts and honors a timeout."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-event-wake-multiple",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Parks two threads on the same event object one waiting for any of its events, one waiting for all of them and wakes both with a single k_event_set() call. Each woken thread posts the events it received back to a second event object so the test can confirm both were unpended with their expected events.\n\nTest steps:\n\n- Empty both event objects and start the two waiter threads.\n- Give the waiters time to pend on the sync event object.\n- Deliver events matching both wait conditions with one k_event_set().\n- Collect the events each waiter reports back and join the waiters.\n\nExpected result:\n\n- Both waiting threads are woken by the single delivery and report exactly the events that matched their respective wait conditions.\n\n*See also:* k_event_set()\n\n*See also:* k_event_wait()\n\n*See also:* k_event_wait_all()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_event_wake_multiple"
        }
      ],
      "name": "events_api__test_event_wake_multiple",
      "summary": "Verify a single event delivery wakes all matching waiters."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-k-event-clear",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_event_clear() must reset exactly the requested events tracked by the event object, leave all other events untouched, report the prior state of the requested events, and be a no-op for events that are not currently set. Runs as a user-mode test so the clear system call is also exercised through its user-mode verifier.\n\nTest steps:\n\n- Verify the statically defined event object starts empty, then set a known pattern (0x33).\n- Clear a subset (0x11); verify the prior state of those events is returned and only the requested events are cleared (0x22 remains).\n- Clear the same subset again; verify it returns 0 (the events were no longer set) and nothing changes.\n- Clear all events; verify the event object ends up empty.\n\nExpected result:\n\n- Only the requested events are cleared, each call reports the prior state of the requested events, and clearing unset events changes nothing.\n\n*See also:* k_event_clear()\n\n*See also:* k_event_test()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_k_event_clear"
        }
      ],
      "name": "events_api__test_k_event_clear",
      "summary": "Verify k_event_clear() clears specified events."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-k-event-init",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "White-box test confirming that a freshly initialized event starts with no pending events and no threads parked on its wait queue, which is the precondition every other event operation relies on.\n\nTest steps:\n\n- Initialize a k_event object with k_event_init().\n- Read the head of the event wait queue.\n- Read the event's set of posted events.\n\nExpected result:\n\n- The wait queue head is NULL (no waiters).\n- The set of posted events is 0.\n\n*See also:* k_event_init()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_k_event_init"
        }
      ],
      "name": "events_api__test_k_event_init",
      "summary": "Verify that k_event_init() produces an empty, unowned event object."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-k-event-wait-all-safe",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The all-match \"safe\" wait variant returns and clears the requested bits only when every requested bit is present; a partial match returns nothing and leaves the object untouched. This test exercises both the no-match and the complete-match cases. Runs as a user-mode test.\n\nTest steps:\n\n- Set a known set of events on the object.\n- Wait-all for a set that is not fully present and verify 0 is returned.\n- Wait-all for a fully-present subset and verify exactly that subset is returned and consumed.\n- Repeat for the remaining bits.\n\nExpected result:\n\n- A partial match returns 0 and consumes nothing; a complete match returns the requested bits and removes them from the object.\n\n*See also:* k_event_wait_all_safe()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_k_event_wait_all_safe"
        }
      ],
      "name": "events_api__test_k_event_wait_all_safe",
      "summary": "Verify k_event_wait_all_safe() consumes bits only on a full match."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/events-api--test-k-event-wait-safe",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The \"safe\" wait variant atomically clears the events it reports so a caller never observes the same event twice. This test confirms that requested bits present in the object are returned and removed, and that a subsequent wait for the same bits returns nothing. Runs as a user-mode test.\n\nTest steps:\n\n- Set a known set of events on the object.\n- Wait (any-match) for a subset and verify exactly that subset is returned.\n- Wait again for the same subset and verify no events are returned (the bits were consumed).\n- Repeat for the remaining bits, including an all-ones request.\n\nExpected result:\n\n- Each call returns only the matching bits that were present and removes them, so re-waiting for already-consumed bits yields 0.\n\n*See also:* k_event_wait_safe()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "events_api__test_k_event_wait_safe"
        }
      ],
      "name": "events_api__test_k_event_wait_safe",
      "summary": "Verify k_event_wait_safe() consumes only the bits it returns."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fatal-exception--test-fatal-cpu-exception",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "An alternate thread executes an illegal instruction (architecture specific), which raises a CPU exception. The kernel's default exception handler reports K_ERR_CPU_EXCEPTION to the installed fatal error handler, which validates the reason code, and the offending thread is terminated while the test thread resumes.\n\nTest steps:\n\n- Create a cooperative thread whose entry point triggers a CPU exception.\n- Let the default exception handler run and deliver the reason code.\n\nExpected result:\n\n- The handler is invoked with K_ERR_CPU_EXCEPTION and the offending thread is terminated (rv is not TC_FAIL).\n\n*See also:* k_sys_fatal_error_handler()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fatal_exception__test_fatal_cpu_exception"
        }
      ],
      "name": "fatal_exception__test_fatal_cpu_exception",
      "summary": "Verify a CPU exception in a thread is caught by the default handler."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fatal-exception--test-fatal-cpu-exception-extended",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Same contract as test_fatal_cpu_exception() but using a second architecture specific trigger (e.g. divide-by-zero on x86/MIPS, a distinct illegal instruction elsewhere). This widens coverage of the default exception path across the trigger mechanisms a given architecture provides.\n\nTest steps:\n\n- Create a cooperative thread whose entry point triggers a CPU exception via the alternate mechanism.\n\nExpected result:\n\n- The handler is invoked with K_ERR_CPU_EXCEPTION and the offending thread is terminated (rv is not TC_FAIL).\n\n*See also:* k_sys_fatal_error_handler()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fatal_exception__test_fatal_cpu_exception_extended"
        }
      ],
      "name": "fatal_exception__test_fatal_cpu_exception_extended",
      "summary": "Verify an alternate CPU exception trigger is caught by the handler."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fatal-exception--test-fatal-except-reason-negative",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Companion to test_fatal_except_reason_positive() using a negative reason (-2) to confirm the reason code is delivered verbatim regardless of sign and is handled by the default fatal path.\n\nTest steps:\n\n- Create a thread that calls z_except_reason() with a negative reason.\n- Abort/join the thread and confirm it crashed as expected.\n\nExpected result:\n\n- The handler is invoked with the exact reason code supplied and the offending thread is terminated (rv is not TC_FAIL).\n\n*See also:* k_sys_fatal_error_handler()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fatal_exception__test_fatal_except_reason_negative"
        }
      ],
      "name": "fatal_exception__test_fatal_except_reason_negative",
      "summary": "Verify an arbitrary negative reason code is propagated to the handler."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fatal-exception--test-fatal-except-reason-positive",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "An alternate thread raises a fatal error with an application-defined reason (INT_MAX) via z_except_reason(). A reason code that has no dedicated handler must still reach the default fatal handler unchanged, confirming the reason code identifies the error to the handler.\n\nTest steps:\n\n- Create a thread that calls z_except_reason() with a positive reason.\n- Abort/join the thread and confirm it crashed as expected.\n\nExpected result:\n\n- The handler is invoked with the exact reason code supplied and the offending thread is terminated (rv is not TC_FAIL).\n\n*See also:* k_sys_fatal_error_handler()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fatal_exception__test_fatal_except_reason_positive"
        }
      ],
      "name": "fatal_exception__test_fatal_except_reason_positive",
      "summary": "Verify an arbitrary positive reason code is propagated to the handler."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fatal-exception--test-fatal-oops",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "An alternate thread calls k_oops(). This is the mechanism for code to flag a fatal error in the current context. The fatal handler receives K_ERR_KERNEL_OOPS and the offending thread is terminated, demonstrating both the trigger mechanism and that the application-supplied handler is consulted.\n\nTest steps:\n\n- Create a thread whose entry point calls k_oops().\n- Abort/join the thread and confirm it crashed as expected.\n\nExpected result:\n\n- The handler is invoked with K_ERR_KERNEL_OOPS and the offending thread is terminated (rv is not TC_FAIL).\n\n*See also:* k_oops()\n\n*See also:* k_sys_fatal_error_handler()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fatal_exception__test_fatal_oops"
        }
      ],
      "name": "fatal_exception__test_fatal_oops",
      "summary": "Verify k_oops() triggers a fatal error terminating the current thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fatal-exception--test-fatal-panic",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "An alternate thread calls k_panic(), the mechanism for code to signal an unrecoverable system error. The fatal handler receives K_ERR_KERNEL_PANIC. Because the test installs its own handler that returns, the offending thread is terminated and the test resumes.\n\nTest steps:\n\n- Create a thread whose entry point calls k_panic().\n- Abort/join the thread and confirm it crashed as expected.\n\nExpected result:\n\n- The handler is invoked with K_ERR_KERNEL_PANIC and the offending thread is terminated (rv is not TC_FAIL).\n\n*See also:* k_panic()\n\n*See also:* k_sys_fatal_error_handler()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fatal_exception__test_fatal_panic"
        }
      ],
      "name": "fatal_exception__test_fatal_panic",
      "summary": "Verify k_panic() triggers a fatal system error."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fatal-message-capture--test-fatal-message-capture",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When a fatal error is raised, the kernel prints diagnostic information about the offending thread (via EXCEPTION_DUMP()) before invoking the application fatal handler. Depending on configuration that dump is emitted through the logging subsystem or directly via printk(). Using the tc_capture helper the test records whichever output path is active, raises a fatal error with k_oops() from a cooperative thread, and asserts both that the \"Current thread:\" dump line was emitted and that the reason code reached k_sys_fatal_error_handler().\n\nTest steps:\n\n- Start test output capture.\n- Spawn a cooperative thread that calls k_oops() (K_ERR_KERNEL_OOPS).\n- Let the kernel dump the diagnostics and invoke the fatal handler, which returns so the offending thread is terminated.\n- Stop capture and inspect the recorded output.\n\nExpected result:\n\n- The captured output contains the \"Current thread:\" dump line.\n- The fatal handler observes K_ERR_KERNEL_OOPS (expected_reason cleared).\n\n*See also:* k_oops()\n\n*See also:* k_sys_fatal_error_handler()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fatal_message_capture__test_fatal_message_capture"
        }
      ],
      "name": "fatal_message_capture__test_fatal_message_capture",
      "summary": "Verify the fatal error path emits the offending thread dump."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-alloc-put",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Use k_fifo_alloc_put() to enqueue a data item that does not reserve space for the bookkeeping word, so the kernel allocates the container from the calling thread's resource pool. Verify the call succeeds and that the same data pointer is returned by a subsequent get.\n\n*See also:* k_fifo_alloc_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_alloc_put"
        }
      ],
      "name": "fifo_api__test_fifo_alloc_put",
      "summary": "Test enqueuing a data item to a FIFO with implicit memory allocation."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-define",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A FIFO created with K_FIFO_DEFINE() must be fully initialized at boot: empty and immediately usable for data passing without any run-time initialization call.\n\nTest steps:\n\n- Check the statically defined FIFO is empty.\n- Put an item and get it back, verifying the same item is returned.\n\nExpected result:\n\n- The statically defined FIFO accepts and delivers items as-is.\n\n*See also:* K_FIFO_DEFINE",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_define"
        }
      ],
      "name": "fifo_api__test_fifo_define",
      "summary": "Verify a FIFO defined at compile time is ready for use."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-get-fail",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When no data is queued, k_fifo_get() must return NULL rather than block indefinitely or return stale data. The contract is checked both with K_NO_WAIT (immediate) and with a finite timeout that is allowed to expire.\n\nTest steps:\n\n- Initialize an empty FIFO.\n- Call k_fifo_get() with K_NO_WAIT and verify it returns NULL.\n- Call k_fifo_get() with a finite timeout and verify it returns NULL.\n\nExpected result:\n\n- Both k_fifo_get() calls return NULL.\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_get_fail"
        }
      ],
      "name": "fifo_api__test_fifo_get_fail",
      "summary": "Verify k_fifo_get() on an empty FIFO returns NULL."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-is-empty-isr",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Same emptiness contract as the thread-context case, but the put/get/is_empty sequence is executed from interrupt context via irq_offload() to confirm k_fifo_is_empty() is ISR-safe.\n\nTest steps:\n\n- Initialize a FIFO and assert it is empty from thread context.\n- From an ISR, put items (not empty) then get them all (empty again).\n\nExpected result:\n\n- k_fifo_is_empty() reports the correct state when called from an ISR.\n\n*See also:* k_fifo_is_empty()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_is_empty_isr"
        }
      ],
      "name": "fifo_api__test_fifo_is_empty_isr",
      "summary": "Verify k_fifo_is_empty() tracks FIFO contents in ISR context."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-is-empty-thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_fifo_is_empty() must report true for a freshly initialized FIFO, false once items are enqueued, and true again after they are all dequeued. All operations run in thread context.\n\nTest steps:\n\n- Initialize a FIFO and assert it is empty.\n- Put items and assert it is not empty.\n- Get all items and assert it is empty again.\n\nExpected result:\n\n- k_fifo_is_empty() reflects the presence or absence of queued data.\n\n*See also:* k_fifo_is_empty()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_is_empty_thread"
        }
      ],
      "name": "fifo_api__test_fifo_is_empty_thread",
      "summary": "Verify k_fifo_is_empty() tracks FIFO contents in thread context."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-isr2thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Items are enqueued in thread context and dequeued from interrupt context (via irq_offload()), confirming k_fifo_get() is ISR-safe and the ISR receives every item in FIFO order. Run against both an init()ed and a DEFINE()d FIFO.\n\nTest steps:\n\n- In thread context, put items into the FIFO.\n- From an ISR, get all items, verify their order, and assert the FIFO is empty.\n- Repeat for a statically defined FIFO.\n\nExpected result:\n\n- The ISR dequeues every thread-enqueued item in order.\n\n*See also:* k_fifo_put()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_isr2thread"
        }
      ],
      "name": "fifo_api__test_fifo_isr2thread",
      "summary": "Verify FIFO data passing from a thread to an ISR."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-peek",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Enqueue two data items, then use k_fifo_peek_head() and k_fifo_peek_tail() to inspect the items at the front and back of the FIFO and verify the returned pointers match the first and last enqueued items without removing them (a subsequent get still returns both items in order). Peeking an empty FIFO returns NULL.\n\n*See also:* k_fifo_peek_head(), k_fifo_peek_tail()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_peek"
        }
      ],
      "name": "fifo_api__test_fifo_peek",
      "summary": "Test peeking at the front and back items of a FIFO."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-put-list-order",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_fifo_put_list() must transfer a caller-built singly-linked list to the back of the FIFO with its order preserved.\n\nTest steps:\n\n- Put one item so the FIFO is non-empty.\n- Link the items of an array into a list.\n- Put the list and confirm it lands behind the pre-existing item.\n- Get all items and verify list order is preserved.\n\nExpected result:\n\n- The pre-existing item is delivered first, then every list item in its original order.\n\n*See also:* k_fifo_put_list()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_put_list_order"
        }
      ],
      "name": "fifo_api__test_fifo_put_list_order",
      "summary": "Verify appending a singly-linked item list to the back of a FIFO."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-put-slist-order",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_fifo_put_slist() must move every node of a sys_slist to the back of the FIFO in list order and leave the source list empty.\n\nTest steps:\n\n- Put one item so the FIFO is non-empty.\n- Build a sys_slist with two nodes and put it on the FIFO.\n- Verify the source list is empty afterwards.\n- Get all items and confirm the nodes land behind the pre-existing item, in list order.\n\nExpected result:\n\n- The pre-existing item is delivered first, then every node in order, and the source list is emptied.\n\n*See also:* k_fifo_put_slist()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_put_slist_order"
        }
      ],
      "name": "fifo_api__test_fifo_put_slist_order",
      "summary": "Verify putting a sys_slist empties the list into the FIFO."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api--test-fifo-thread2isr",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Items are enqueued from interrupt context (via irq_offload()) and dequeued in thread context, confirming k_fifo_put() is ISR-safe and the thread receives every item in FIFO order. Run against both an init()ed and a DEFINE()d FIFO.\n\nTest steps:\n\n- From an ISR, put items into the FIFO and assert it is not empty.\n- In thread context, get all items and verify their order.\n- Repeat for a statically defined FIFO.\n\nExpected result:\n\n- The thread dequeues every ISR-enqueued item in order.\n\n*See also:* k_fifo_put()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api__test_fifo_thread2isr"
        }
      ],
      "name": "fifo_api__test_fifo_thread2isr",
      "summary": "Verify FIFO data passing from an ISR to a thread."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api-1cpu--test-fifo-cancel-wait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A thread blocked in k_fifo_get() with a long timeout must return immediately with NULL when another thread calls k_fifo_cancel_wait() on that FIFO, rather than waiting for its own timeout to expire. The test confirms both the NULL return and that it happened well before the 500 ms get timeout.\n\nTest steps:\n\n- Start a helper thread that sleeps briefly then calls k_fifo_cancel_wait().\n- In the main thread, call k_fifo_get() with a 500 ms timeout and time it.\n- Verify the get returned NULL and far sooner than its timeout.\n- Repeat for a statically defined FIFO.\n\nExpected result:\n\n- k_fifo_get() returns NULL promptly due to the cancel, not the timeout.\n\n*See also:* k_fifo_cancel_wait()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api_1cpu__test_fifo_cancel_wait"
        }
      ],
      "name": "fifo_api_1cpu__test_fifo_cancel_wait",
      "summary": "Verify k_fifo_cancel_wait() wakes a pending getter with NULL."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api-1cpu--test-fifo-loop",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Stresses the FIFO by cycling data through main-thread, ISR and spawned-thread contexts many times. Across every iteration the items must be passed without loss, duplication or reordering, exercising put/get stability when producers and consumers alternate between thread and interrupt context.\n\nTest steps:\n\n- For LOOPS iterations: put from the main thread, get then put from an ISR, and get from a spawned thread.\n- Verify each get returns the expected item.\n\nExpected result:\n\n- Data passes correctly and in order across all contexts on every iteration.\n\n*See also:* k_fifo_put()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api_1cpu__test_fifo_loop"
        }
      ],
      "name": "fifo_api_1cpu__test_fifo_loop",
      "summary": "Verify FIFO data integrity under repeated cross-context traffic."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-api-1cpu--test-fifo-thread2thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A consumer thread blocks on k_fifo_get() while the main thread enqueues items via the single, list and slist put APIs. The consumer must receive every item in FIFO order. The scenario is run against both a k_fifo_init()ed and a K_FIFO_DEFINE()d FIFO to confirm both initialization paths behave the same.\n\nTest steps:\n\n- Create a preemptible consumer thread that drains the FIFO.\n- From the main thread, put items using k_fifo_put(), k_fifo_put_list() and k_fifo_put_slist().\n- Synchronize on a semaphore once the consumer has read all items.\n- Repeat for a statically defined FIFO.\n\nExpected result:\n\n- The consumer dequeues every item in the order it was enqueued.\n\n*See also:* k_fifo_put()\n\n*See also:* k_fifo_put_list()\n\n*See also:* k_fifo_put_slist()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_api_1cpu__test_fifo_thread2thread"
        }
      ],
      "name": "fifo_api_1cpu__test_fifo_thread2thread",
      "summary": "Verify FIFO data passing between two threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-timeout--test-timeout-non-empty-fifo",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When data is already queued, k_fifo_get() must return it immediately regardless of the timeout argument. The contract is checked with both K_NO_WAIT and K_FOREVER, neither of which should block when data is present.\n\nTest steps:\n\n- Put an item, then k_fifo_get() with K_NO_WAIT and verify a non-NULL return.\n- Put an item, then k_fifo_get() with K_FOREVER and verify a non-NULL return.\n\nExpected result:\n\n- Both gets return the queued item without blocking.\n\n*See also:* k_fifo_get()\n\n*See also:* k_fifo_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_timeout__test_timeout_non_empty_fifo"
        }
      ],
      "name": "fifo_timeout__test_timeout_non_empty_fifo",
      "summary": "Verify k_fifo_get() returns queued data without waiting."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-timeout-1cpu--test-timeout-empty-fifo",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "On an empty FIFO, k_fifo_get() with a finite timeout must block for at least the requested duration and then return NULL, while K_NO_WAIT must return NULL immediately. The elapsed time is measured to confirm the full timeout elapsed.\n\nTest steps:\n\n- Call k_fifo_get() on an empty FIFO with a 10 ms timeout; measure the wait.\n- Verify it returned NULL and that at least the timeout elapsed.\n- Call k_fifo_get() with K_NO_WAIT and verify it returns NULL.\n\nExpected result:\n\n- The timed get returns NULL after the timeout; K_NO_WAIT returns NULL at once.\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_timeout_1cpu__test_timeout_empty_fifo"
        }
      ],
      "name": "fifo_timeout_1cpu__test_timeout_empty_fifo",
      "summary": "Verify k_fifo_get() timeout behavior on an empty FIFO."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-timeout-1cpu--test-timeout-fifo-thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A getter pending with a timeout must be woken as soon as a producer thread puts data, returning that data rather than timing out. The test also covers the K_NO_WAIT and K_FOREVER variants where a child thread conditionally supplies data based on availability on a second FIFO, exercising the interaction between blocking gets and producer timing.\n\nTest steps:\n\n- Pend on k_fifo_get() with a timeout while a child puts data in time; verify the data is returned within the timeout window.\n- With K_NO_WAIT, verify the child reports no data when the FIFO is empty and reports data when it has been pre-filled.\n- With K_FOREVER, verify the child retrieves pre-filled data.\n\nExpected result:\n\n- The getter receives data supplied in time; the reply flags reflect FIFO availability for each timeout variant.\n\n*See also:* k_fifo_get()\n\n*See also:* k_fifo_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_timeout_1cpu__test_timeout_fifo_thread"
        }
      ],
      "name": "fifo_timeout_1cpu__test_timeout_fifo_thread",
      "summary": "Verify k_fifo_get() wakes when a thread supplies data within timeout."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-timeout-1cpu--test-timeout-threads-pend-fail-on-fifo",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Several threads pend on the same FIFO with different timeouts; all but the last receive data in time (their timeouts are aborted), and the last one times out. This checks that removing satisfied waiters from the timeout queue leaves the remaining timeout computed correctly, so the final thread still times out as expected.\n\nTest steps:\n\n- Spawn threads pending on one FIFO with distinct timeouts.\n- Feed data so all but the last get it in queue order; the last gets none.\n- Verify each satisfied thread reports in order and the last times out.\n\nExpected result:\n\n- Satisfied threads report in queue order; the last thread times out cleanly.\n\n*See also:* k_fifo_get()\n\n*See also:* k_fifo_put()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_timeout_1cpu__test_timeout_threads_pend_fail_on_fifo"
        }
      ],
      "name": "fifo_timeout_1cpu__test_timeout_threads_pend_fail_on_fifo",
      "summary": "Verify timeout is recomputed when pending getters are satisfied early."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-timeout-1cpu--test-timeout-threads-pend-on-dual-fifos",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Extends the single-FIFO ordering check to threads distributed across two FIFOs: timeouts must still fire in ascending-timeout order across the combined set, confirming the kernel timeout queue is global and not per-FIFO.\n\nTest steps:\n\n- Spawn threads that pend on two different FIFOs with distinct timeouts.\n- Each reports back as it times out; collect the combined order.\n\nExpected result:\n\n- Threads time out in increasing-timeout order across both FIFOs.\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_timeout_1cpu__test_timeout_threads_pend_on_dual_fifos"
        }
      ],
      "name": "fifo_timeout_1cpu__test_timeout_threads_pend_on_dual_fifos",
      "summary": "Verify threads pending on two FIFOs time out in global timeout order."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-timeout-1cpu--test-timeout-threads-pend-on-fifo",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When several threads block on the same FIFO with different timeouts and no data arrives, each must time out in ascending-timeout order regardless of the order in which the threads were queued. This validates the timeout queue ordering for a single FIFO.\n\nTest steps:\n\n- Spawn several threads that pend on the same FIFO with distinct timeouts.\n- Each reports back as it times out; collect the order.\n\nExpected result:\n\n- Threads time out strictly in increasing-timeout order (within one tick).\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_timeout_1cpu__test_timeout_threads_pend_on_fifo"
        }
      ],
      "name": "fifo_timeout_1cpu__test_timeout_threads_pend_on_fifo",
      "summary": "Verify multiple threads pending on one FIFO time out in timeout order."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-usage--test-dual-fifo-play",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Two FIFOs are used as a request/response channel: the main thread puts to fifo2 and blocks getting from fifo1, while the child blocks getting from fifo2 and puts to fifo1. Control alternates between the threads each iteration, confirming blocking gets correctly serialize the exchange.\n\nTest steps:\n\n- Start the child, which loops getting from fifo2 and putting to fifo1.\n- Main thread loops putting to fifo2 and getting from fifo1.\n- Verify each item received on fifo1 matches the expected sequence.\n\nExpected result:\n\n- The threads alternate correctly and every item is received in order.\n\n*See also:* k_fifo_put()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_usage__test_dual_fifo_play"
        }
      ],
      "name": "fifo_usage__test_dual_fifo_play",
      "summary": "Verify ping-pong synchronization across two FIFOs."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-usage--test-isr-fifo-play",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Repeats the two-FIFO hand-off pattern but performs every k_fifo_put() and k_fifo_get() from interrupt context via irq_offload(), confirming the FIFO operations are ISR-safe end to end when both producer and consumer run in an ISR.\n\nTest steps:\n\n- Main thread (from an ISR) puts items into fifo2, then starts the child.\n- Child (from ISRs) gets from fifo2 and puts into fifo1, then signals.\n- Main thread (from an ISR) gets the items from fifo1.\n\nExpected result:\n\n- All ISR-context put/get operations succeed and items pass in order.\n\n*See also:* k_fifo_put()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_usage__test_isr_fifo_play"
        }
      ],
      "name": "fifo_usage__test_isr_fifo_play",
      "summary": "Verify producer/consumer exchange with all puts/gets in ISR context."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/fifo-usage--test-single-fifo-play",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Exercises a hand-off pattern on one FIFO: the main thread fills it, a child thread drains it and refills it with a second data set, and the main thread drains that. Confirms items survive a full round trip through both threads in the correct order.\n\nTest steps:\n\n- Main thread puts the first data set, then starts the child.\n- Child gets all items, puts the second data set, signals via a semaphore.\n- Main thread gets all items and verifies they match the second data set.\n\nExpected result:\n\n- The main thread reads back exactly the items the child enqueued, in order.\n\n*See also:* k_fifo_put()\n\n*See also:* k_fifo_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "fifo_usage__test_single_fifo_play"
        }
      ],
      "name": "fifo_usage__test_single_fifo_play",
      "summary": "Verify producer/consumer exchange over a single FIFO."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-bad-inputs",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "From user mode every futex argument is untrusted, so each way it can be wrong has its own error: memory the caller cannot access is -EACCES, an address that is not a futex kernel object is -EINVAL, a mismatched expected value is -EAGAIN, and a matching value with K_NO_WAIT times out with -ETIMEDOUT.\n\nTest steps:\n\n- Wait on and wake a futex the caller has no access to.\n- Wait on and wake two objects that are not futexes.\n- Wait with an expected value that does not match the futex.\n- Wait with the matching value and K_NO_WAIT.\n\nExpected result:\n\n- Each call fails with exactly the error its input deserves.\n\n*See also:* k_futex_wait()\n\n*See also:* k_futex_wake()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_bad_inputs"
        }
      ],
      "name": "futex__test_futex_bad_inputs",
      "summary": "Verify that futex calls reject invalid objects, values and states."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-independent-wait-wake",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Each futex has its own wait queue: a wake issued on one must resume only the thread waiting on that futex and not disturb waiters on any other. One waiter and one waker are paired per futex, and every futex's value must reach zero through its own pair.\n\nTest steps:\n\n- Block one user thread on each of several futexes.\n- Spawn one waker per futex, each waking only its own.\n- Yield, then check every futex's value.\n\nExpected result:\n\n- Every waiter is woken exactly by its own futex's wake.\n\n*See also:* k_futex_wake()\n\n*See also:* k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_independent_wait_wake"
        }
      ],
      "name": "futex__test_futex_independent_wait_wake",
      "summary": "Verify that independent futexes wake independently."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-locate-access",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "For that test kernel object which doesn't contain private kernel data will be used futex. Test performs handshaking between two user threads to test next requirements:\n\n- Place a futex simple_futex in user memory using ZTEST_BMEM\n- Show that user threads can write to futex value\n- Show that user threads can make wait/wake syscalls on it.\n\n*See also:* atomic_set(), atomic_sub(), k_futex_wake(), k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_locate_access"
        }
      ],
      "name": "futex__test_futex_locate_access",
      "summary": "Test kernel supports locating kernel objects without private kernel data anywhere in memory, control access with the memory domain configuration."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-multiple-threads-wait-wake",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "k_futex_wake() with wake_all set must resume every thread blocked on the futex, and its return value must count them all. Each waiter decrements the futex value once resumed, so a value of zero at the end means none of them was left behind.\n\nTest steps:\n\n- Block a batch of user threads on one futex, incrementing the value once per waiter.\n- Issue a single wake with wake_all from another thread and check it reports the full count.\n- Yield, then check the futex value reached zero.\n\nExpected result:\n\n- All waiters resume off one wake and the reported count matches.\n\n*See also:* k_futex_wake()\n\n*See also:* k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_multiple_threads_wait_wake"
        }
      ],
      "name": "futex__test_futex_multiple_threads_wait_wake",
      "summary": "Verify that a single wake-all resumes every waiter on one futex."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-wait-forever",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A futex wait whose expected value matches the futex must put the caller to sleep indefinitely: nothing wakes it, so the waiter's post-wait code an atomic decrement of the futex value must never run. The value still being non-zero after the waiter had time to run is what shows it stayed blocked.\n\nTest steps:\n\n- Set the futex value and spawn a user thread that waits on it with K_FOREVER and decrements the value after waking.\n- Yield so the waiter runs, then check the futex value.\n\nExpected result:\n\n- The value is unchanged: the waiter blocked and never woke.\n\n*See also:* k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_wait_forever"
        }
      ],
      "name": "futex__test_futex_wait_forever",
      "summary": "Verify that k_futex_wait() with K_FOREVER blocks while the value matches."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-wait-forever-wake",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The basic handshake: one thread blocks on the futex forever, another calls k_futex_wake(), and the wake must both return the number of threads woken and actually unblock the waiter, whose post-wait decrement is what the test observes.\n\nTest steps:\n\n- Set the futex value and spawn a user thread waiting with K_FOREVER.\n- Spawn a second user thread that wakes one waiter and checks the count.\n- Yield, then check the futex value.\n\nExpected result:\n\n- The wake reports one thread woken and the waiter resumed, so the value is zero.\n\n*See also:* k_futex_wake()\n\n*See also:* k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_wait_forever_wake"
        }
      ],
      "name": "futex__test_futex_wait_forever_wake",
      "summary": "Verify that k_futex_wake() wakes a waiter blocked with K_FOREVER."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-wait-forever-wake-from-isr",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Waking a futex is legal from an ISR, where the waker cannot block. A waiter blocked with K_FOREVER must be resumed by a wake issued through irq_offload() exactly as by one from a thread.\n\nTest steps:\n\n- Set the futex value and spawn a user thread waiting with K_FOREVER.\n- Issue k_futex_wake() from an ISR via irq_offload().\n- Yield, then check the futex value.\n\nExpected result:\n\n- The waiter is woken by the ISR and runs its post-wait code.\n\n*See also:* k_futex_wake()\n\n*See also:* irq_offload()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_wait_forever_wake_from_isr"
        }
      ],
      "name": "futex__test_futex_wait_forever_wake_from_isr",
      "summary": "Verify that k_futex_wake() works from interrupt context."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-wait-nowait",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A zero timeout turns the wait into a poll: the call must come back at once with -ETIMEDOUT instead of blocking. The waiter thread checks that return and then decrements the futex value, which is what the test observes.\n\nTest steps:\n\n- Set the futex value and spawn a user thread waiting with K_NO_WAIT.\n- Give it time to run, then check the futex value.\n\nExpected result:\n\n- The waiter returned immediately with -ETIMEDOUT and ran on.\n\n*See also:* k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_wait_nowait"
        }
      ],
      "name": "futex__test_futex_wait_nowait",
      "summary": "Verify that k_futex_wait() with K_NO_WAIT returns immediately."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-wait-nowait-wake",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A thread that polled with K_NO_WAIT is no longer waiting by the time a wake is issued, so the wake must report zero threads woken rather than counting the poller.\n\nTest steps:\n\n- Spawn a user thread that polls the futex with K_NO_WAIT and returns.\n- After it has finished, spawn a waker expecting to wake zero threads.\n\nExpected result:\n\n- The wake reports no threads woken.\n\n*See also:* k_futex_wake()\n\n*See also:* k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_wait_nowait_wake"
        }
      ],
      "name": "futex__test_futex_wait_nowait_wake",
      "summary": "Verify that a wake finds no waiter after a K_NO_WAIT poll."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-wait-timeout",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "With a finite timeout and no waker, the wait must end on its own once the timeout elapses, returning control to the waiter, which then decrements the futex value. The decrement having happened is what shows the timeout path completed.\n\nTest steps:\n\n- Set the futex value and spawn a user thread waiting with a 50 ms timeout.\n- Sleep past the timeout, then check the futex value.\n\nExpected result:\n\n- The waiter timed out and ran its post-wait code, so the value is zero.\n\n*See also:* k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_wait_timeout"
        }
      ],
      "name": "futex__test_futex_wait_timeout",
      "summary": "Verify that k_futex_wait() returns control after a finite timeout expires."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/futex--test-futex-wait-timeout-wake",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "When a waiter has a finite timeout and a wake arrives first, the wait must complete as a wake returning success to the waiter rather than waiting out the rest of the timeout.\n\nTest steps:\n\n- Set the futex value and spawn a user thread waiting with a 100 ms timeout.\n- Spawn a waker before the timeout can expire and let both run.\n- Check the futex value.\n\nExpected result:\n\n- The waiter was woken (returning 0, not -ETIMEDOUT) and ran its post-wait code before the timeout elapsed.\n\n*See also:* k_futex_wake()\n\n*See also:* k_futex_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "futex__test_futex_wait_timeout_wake"
        }
      ],
      "name": "futex__test_futex_wait_timeout_wake",
      "summary": "Verify that a wake arriving before the timeout ends the wait early."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/interrupt-feature--test-isr-offload-job",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate isr can offload workload to work queue, and the offload jobs could execute immediately base on it's priority. We test this by dynamic interrupt.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "interrupt_feature__test_isr_offload_job"
        }
      ],
      "name": "interrupt_feature__test_isr_offload_job",
      "summary": "Test interrupt offload work by dynamic interrupt."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/interrupt-feature--test-isr-offload-job-identi",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate isr can offload workload to work queue, and all the offload jobs use the same thread entry, and:\n\n- If the priority of the original thread < offload job, offload jobs could execute immediately.\n- If the priority of the original thread >= offload job, offload jobs will not execute immediately.\n\nWe test this by irq_offload().",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "interrupt_feature__test_isr_offload_job_identi"
        }
      ],
      "name": "interrupt_feature__test_isr_offload_job_identi",
      "summary": "Test interrupt offload work to identical jobs."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/interrupt-feature--test-isr-offload-job-multiple",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate isr can offload workload to multi work queue, and:\n\n- If the priority of the original thread < offload job, offload jobs could execute immediately.\n- If the priority of the original thread >= offload job, offload jobs will not execute immediately.\n\nWe test this by irq_offload().",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "interrupt_feature__test_isr_offload_job_multiple"
        }
      ],
      "name": "interrupt_feature__test_isr_offload_job_multiple",
      "summary": "Test interrupt offload work to multiple jobs."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/interrupt-feature--test-prevent-interruption",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "This routine tests if the kernel is capable of preventing interruption, by locking interrupts and busy-waiting to see if the system timer interrupt is serviced while interrupts are locked; in addition, this test also verifies that the system timer interrupt is serviced after interrupts are unlocked.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "interrupt_feature__test_prevent_interruption"
        }
      ],
      "name": "interrupt_feature__test_prevent_interruption",
      "summary": "Test interrupt prevention."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/interrupt-feature--test-static-shared-irq-write",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "This tests if interrupts are statically shared successfully (i.e: multiple ISR/arg pairs are called whenever the interrupt they were registered for is triggered).",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "interrupt_feature__test_static_shared_irq_write"
        }
      ],
      "name": "interrupt_feature__test_static_shared_irq_write",
      "summary": "Test writing to a vector using static shared interrupts."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/irq-offload--test-irq-offload",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Confirms that irq_offload() synchronously executes the supplied callback in ISR context on the IRQ stack and forwards the caller-provided parameter. Passing proves the offload mechanism transitions to interrupt context correctly and that nested irq lock/unlock key handling reports the right lock state.\n\nTest steps:\n\n- Nest arch_irq_lock() twice and assert the returned keys report unlocked then locked state, then unlock in reverse order.\n- Call irq_offload() with a known sentinel value as the parameter.\n- The callback asserts it runs in ISR context and stores the parameter.\n\nExpected result:\n\n- The sentinel global equals the value passed to irq_offload().\n\n*See also:* irq_offload()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "irq_offload__test_irq_offload"
        }
      ],
      "name": "irq_offload__test_irq_offload",
      "summary": "Verify irq_offload() runs a function in interrupt context and passes its argument."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-k-heap-aligned-alloc",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Allocates a block with a specific alignment from the heap and checks alignment, then tries oversize and invalid alignment.\n\n*See also:* k_heap_aligned_alloc()",
      "externalIdentifier": [
