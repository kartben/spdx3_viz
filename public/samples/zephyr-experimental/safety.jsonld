      "summary": "Mutex Kernel Object"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-10",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism for the owning thread to unlock a mutex.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-10"
        }
      ],
      "name": "ZEP-SRS-6-10: Unlocking a mutex",
      "summary": "Unlocking a mutex"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-11",
      "requirementStatement": "If a thread that does not own a mutex attempts to unlock it, then the Zephyr RTOS shall return an error and shall not release the mutex.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-11"
        }
      ],
      "name": "ZEP-SRS-6-11: Unlocking by a non-owner",
      "summary": "Unlocking by a non-owner"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-12",
      "requirementStatement": "While a higher-priority thread is blocked waiting on a mutex, the Zephyr RTOS shall raise the priority of the owning thread to that of the highest-priority waiting thread until the mutex is released.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-12"
        }
      ],
      "name": "ZEP-SRS-6-12: Priority inheritance",
      "summary": "Priority inheritance"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-13",
      "requirementStatement": "When a mutex is unlocked while one or more threads are waiting to lock it, the Zephyr RTOS shall grant ownership of the mutex to the highest-priority waiting thread.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-6-13"
        }
      ],
      "name": "ZEP-SRS-6-13: Highest-priority waiter acquires a released mutex",
      "summary": "Highest-priority waiter acquires a released mutex"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-6-2",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to define and initialize a mutex at compile time.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
