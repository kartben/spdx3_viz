          "externalIdentifierType": "other",
          "identifier": "work__test_drain_empty"
        }
      ],
      "name": "work__test_drain_empty",
      "summary": "Draining an empty work queue completes immediately."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work--test-null-queue",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "*See also:* k_work_init()\n\n*See also:* k_work_busy_get()\n\n*See also:* k_work_submit_to_queue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work__test_null_queue"
        }
      ],
      "name": "work__test_null_queue",
      "summary": "Submitting to a NULL work queue returns -EINVAL."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work--test-smp-running-cancel",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "On SMP the work queue runs the handler concurrently with the test thread. Once the item is observed running, a plain k_work_cancel() must report the item still busy, and k_work_cancel_sync() must wait for the handler to complete before returning.\n\nTest steps:\n\n- Submit a work item with a delaying handler and busy-wait until it is reported running on another CPU.\n- Call k_work_cancel() and check the returned busy state.\n- Call k_work_cancel_sync() and verify it reports having waited.\n\nExpected result:\n\n- The running item cannot be cancelled without waiting; after the synchronous cancel completes the item reports no busy flags.\n\n*See also:* k_work_cancel()\n\n*See also:* k_work_cancel_sync()\n\n*See also:* k_work_busy_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work__test_smp_running_cancel"
        }
      ],
      "name": "work__test_smp_running_cancel",
      "summary": "Verify cancelling a running item on SMP requires a synchronous wait."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work--test-smp-simple-queue",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "*See also:* k_work_init()\n\n*See also:* k_work_busy_get()\n\n*See also:* k_work_is_pending()\n\n*See also:* k_work_submit_to_queue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work__test_smp_simple_queue"
        }
      ],
      "name": "work__test_smp_simple_queue",
      "summary": "Work submitted to a queue runs on another CPU."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work--test-unstarted",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "*See also:* k_work_init()\n\n*See also:* k_work_busy_get()\n\n*See also:* k_work_submit_to_queue()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "work__test_unstarted"
        }
      ],
      "name": "work__test_unstarted",
      "summary": "Submitting to an unstarted work queue returns -ENODEV."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/work-1cpu--test-1cpu-basic-reschedule",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
