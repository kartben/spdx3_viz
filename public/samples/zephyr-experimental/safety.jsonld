      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test validates k_heap_free() API, by using below steps\n- allocate the memory from the heap,\n- free a NULL pointer (should have no effect)\n- free the allocated memory\n- allocate memory more than the first allocation. The allocation in the 4th step should succeed if k_heap_free() works as expected\nSee also: k_heap_alloc, k_heap_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_k_heap_free"
        }
      ],
      "name": "k_heap_api__test_k_heap_free",
      "summary": "Test k_heap_free() API functionality."
    },
    {
