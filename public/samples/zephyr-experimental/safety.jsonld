    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-complex--test-mutex-multithread-competition",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Define three threads, and set a higher priority for two of them, and set a lower priority for the last one. Then Add a delay between creating the two high priority threads. Test point:\n- Any number of threads may wait on a mutex locked by others simultaneously.\n- When the mutex is released, it is took by the highest priority thread that has waited longest.\nSee also: sys_mutex_lock(), sys_mutex_unlock()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_complex__test_mutex_multithread_competition"
        }
      ],
      "name": "mutex_complex__test_mutex_multithread_competition",
      "summary": "Test multi-threads to take mutex."
    },
