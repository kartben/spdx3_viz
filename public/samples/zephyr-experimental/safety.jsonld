    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-26",
      "requirementStatement": "Where workqueue work timeout monitoring is enabled, the Zephyr RTOS shall monitor the execution duration of each work item and, if a work item handler runs longer than the configured timeout, abort the work queue thread.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-26-26"
        }
      ],
      "name": "ZEP-SRS-26-26: Work item timeout monitoring",
      "summary": "Work item timeout monitoring"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-27",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to submit a work item that is processed when any of a specified set of poll events becomes ready or when a specified timeout elapses, and to report the triggering outcome to the work item handler.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-26-27"
        }
      ],
      "name": "ZEP-SRS-26-27: Submitting a triggered work item",
      "summary": "Submitting a triggered work item"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-28",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to cancel a submitted triggered work item before any of its poll events becomes ready.",
