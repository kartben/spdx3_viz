          "identifier": "mslab_api__test_mslab_alloc_free_thread"
        }
      ],
      "name": "mslab_api__test_mslab_alloc_free_thread",
      "summary": "Verify alloc and free of blocks from mem_slab."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-api--test-mslab-alloc-timeout",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Allocate 3 memory blocks from memory slab. Check allocation of another memory block with NO_WAIT set, since there are no blocks left to allocate in the memory slab, the allocation fails with return value -ENOMEM. Then the system up time is obtained, memory block allocation is tried with timeout of 2000 ms. Now the allocation API returns -EAGAIN as the waiting period is timeout. The test case also checks if timeout has really happened by checking delta period between the allocation request was made and return of -EAGAIN.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_api__test_mslab_alloc_timeout"
        }
      ],
      "name": "mslab_api__test_mslab_alloc_timeout",
      "summary": "Verify allocation of memory blocks with timeouts."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mslab-api--test-mslab-kdefine",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Initialize 3 memory blocks of block size 8 bytes using\n\n*See also:* K_MEM_SLAB_DEFINE() and check if number of used blocks is 0 and free blocks is equal to number of blocks initialized.",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mslab_api__test_mslab_kdefine"
        }
      ],
      "name": "mslab_api__test_mslab_kdefine",
      "summary": "Verify K_MEM_SLAB_DEFINE() with allocates/frees blocks."
    },
