      "summary": "Test mutex's priority inheritance mechanism."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api-1cpu--test-mutex-reent-lock-forever",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A thread holds the mutex while a second thread blocks on it with K_FOREVER; the waiter acquires the mutex once it is released. Exercised on both a run-time initialized mutex and a compile-time K_MUTEX_DEFINE() mutex.\nSee also: k_mutex_init(), k_mutex_lock(), k_mutex_unlock()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api_1cpu__test_mutex_reent_lock_forever"
        }
      ],
      "name": "mutex_api_1cpu__test_mutex_reent_lock_forever",
      "summary": "Verify reentrant locking with a waiter blocking forever."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api-1cpu--test-mutex-reent-lock-timeout-pass",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A lock attempt with a finite timeout must succeed when the holding thread releases the mutex before the timeout elapses.\nSee also: k_mutex_lock(), k_mutex_unlock()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api_1cpu__test_mutex_reent_lock_timeout_pass"
        }
      ],
      "name": "mutex_api_1cpu__test_mutex_reent_lock_timeout_pass",
      "summary": "Verify a timed lock succeeds once the mutex is released in time."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mutex-api-1cpu--test-mutex-timeout-race-during-priority-inversion",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "- A low priority thread (Tlow) locks mutex A.\n- A high priority thread (Thigh) blocks on mutex A, boosting the priority of Tlow.\n- Thigh times out waiting for mutex A.\n- Before Thigh has a chance to execute, Tlow unlocks mutex A (which now has no owner) and drops its own priority.\n- Thigh now gets a chance to execute and finds that it timed out, and then enters the block of code to lower the priority of the thread that owns mutex A (now nobody).\n- Thigh tries to the dereference the owner of mutex A (which is nobody, and thus it is NULL). This leads to an exception.\nSee also: k_mutex_lock()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mutex_api_1cpu__test_mutex_timeout_race_during_priority_inversion"
        }
      ],
      "name": "mutex_api_1cpu__test_mutex_timeout_race_during_priority_inversion",
      "summary": "Test fix for subtle race during priority inversion."
    },
