    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/irq-offload--test-irq-offload",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Confirms that irq_offload() synchronously executes the supplied callback in ISR context on the IRQ stack and forwards the caller-provided parameter. Passing proves the offload mechanism transitions to interrupt context correctly and that nested irq lock/unlock key handling reports the right lock state.\nTest steps:\n- Nest arch_irq_lock() twice and assert the returned keys report unlocked then locked state, then unlock in reverse order.\n- Call irq_offload() with a known sentinel value as the parameter.\n- The callback asserts it runs in ISR context and stores the parameter.\nExpected result:\n- The sentinel global equals the value passed to irq_offload().\nSee also: irq_offload()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "irq_offload__test_irq_offload"
        }
      ],
      "name": "irq_offload__test_irq_offload",
      "summary": "Verify irq_offload() runs a function in interrupt context and passes its argument."
    },
    {
      "type": "functionalsafety_RequirementVerification",
