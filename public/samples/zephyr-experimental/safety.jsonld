      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate countdown of time to expiration\nStarts a timer, busy-waits for half the DURATION, then checks the remaining time to expiration and stops the timer. The remaining time should reflect the passage of at least the busy-wait interval.\nSee also: k_timer_init(), k_timer_start(), k_timer_stop(), k_timer_remaining_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_remaining"
        }
      ],
      "name": "timer_api__test_timer_remaining",
      "summary": "Test accuracy of k_timer_remaining_get()."
    },
