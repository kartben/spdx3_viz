          "identifier": "timer_api__test_timeout_abs"
        }
      ],
      "name": "timer_api__test_timeout_abs",
      "summary": "Test absolute timeouts."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-cleanup",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Start and stop a timer so it has no pending waiters, then call k_timer_cleanup() and verify it succeeds (returns 0), indicating the timer's resources may be released.\n\n*See also:* k_timer_cleanup()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_cleanup"
        }
      ],
      "name": "timer_api__test_timer_cleanup",
      "summary": "Test releasing the resources associated with a timer."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-cleanup-pending",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Arm a timer with a far-future expiry and have a separate thread block on it via k_timer_status_sync(). While that thread is pending on the timer, call k_timer_cleanup() and verify it returns -EAGAIN, indicating the cleanup could not be performed. Then stop the timer to release the waiter.\n\n*See also:* k_timer_cleanup()\n\n*See also:* k_timer_status_sync()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_cleanup_pending"
        }
      ],
      "name": "timer_api__test_timer_cleanup_pending",
      "summary": "Test cleaning up a timer that still has waiting threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-duration-period",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validates initial duration and period of timer.\n\nIt initializes the timer with k_timer_init(), then starts the timer using k_timer_start() with specific initial duration and period. Stops the timer using k_timer_stop() and checks for proper completion of duration and period.\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_stop()\n\n*See also:* k_uptime_get()\n\n*See also:* k_busy_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_duration_period"
        }
      ],
      "name": "timer_api__test_timer_duration_period",
      "summary": "Test duration and period of Timer."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-expirefn-null",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validates timer without any expiry_fn(set to NULL). expiry_fn() is a function that is invoked each time the timer expires.\n\nIt initializes the timer with k_timer_init(), then starts the timer using k_timer_start(). Stops the timer using k_timer_stop() and checks for expire_cnt to zero, as expiry_fn was not defined at all.\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_stop()\n\n*See also:* k_uptime_get()\n\n*See also:* k_busy_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_expirefn_null"
        }
      ],
      "name": "timer_api__test_timer_expirefn_null",
      "summary": "Test Timer without any timer expiry callback function."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-expiry-in-isr",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Start a one-shot timer whose expiry callback records, via k_is_in_isr(), whether it executes in interrupt context. After the timer has expired, verify the callback ran and that it observed itself running in interrupt context.\n\n*See also:* k_timer_start()\n\n*See also:* k_is_in_isr()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_expiry_in_isr"
        }
      ],
      "name": "timer_api__test_timer_expiry_in_isr",
      "summary": "Test that a timer expiry function runs in interrupt context."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-init-runtime",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A timer initialized at run time with k_timer_init() must start out inactive no expiries recorded and no time remaining and be immediately usable: starting it as a one-shot makes it expire once.\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_status_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_init_runtime"
        }
      ],
      "name": "timer_api__test_timer_init_runtime",
      "summary": "Verify run-time initialization of a timer."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-k-define",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate statically defined timer init using K_TIMER_DEFINE\n\nIt creates prototype of K_TIMER_DEFINE to statically define timer init and starts the timer with k_timer_start() with specific initial duration and period. Stops the timer using k_timer_stop() and checks for proper completion of duration and period.\n\n*See also:* k_timer_start()\n\n*See also:* K_TIMER_DEFINE()\n\n*See also:* k_timer_stop()\n\n*See also:* k_uptime_get()\n\n*See also:* k_busy_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_k_define"
        }
      ],
      "name": "timer_api__test_timer_k_define",
      "summary": "Test statically defined Timer init."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-period-0",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validates initial timer duration, keeping timer period to zero. Basically, acting as one-shot timer. It initializes the timer with k_timer_init(), then starts the timer using k_timer_start() with specific initial duration and period as zero. Stops the timer using k_timer_stop() and checks for proper completion.\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_stop()\n\n*See also:* k_uptime_get()\n\n*See also:* k_busy_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_period_0"
        }
      ],
      "name": "timer_api__test_timer_period_0",
      "summary": "Test Timer with zero period value."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-period-k-forever",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validates initial timer duration, keeping timer period to K_FOREVER. Basically, acting as one-shot timer. It initializes the timer with k_timer_init(), then starts the timer using k_timer_start() with specific initial duration and period as zero. Stops the timer using k_timer_stop() and checks for proper completion.\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_stop()\n\n*See also:* k_uptime_get()\n\n*See also:* k_busy_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_period_k_forever"
        }
      ],
      "name": "timer_api__test_timer_period_k_forever",
      "summary": "Test Timer with K_FOREVER period value."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-periodicity",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Timer test to check for the predictability with which the timer expires depending on the period configured.\n\nIt initializes the timer with k_timer_init(), then starts the timer using k_timer_start() with specific period. It resets the timer\u2019s status to zero with k_timer_status_sync and identifies the delta between each timer expiry to check for the timer expiration period correctness. Finally, stops the timer using k_timer_stop().\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_status_sync()\n\n*See also:* k_timer_stop()\n\n*See also:* k_uptime_get()\n\n*See also:* k_uptime_delta()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_periodicity"
        }
      ],
      "name": "timer_api__test_timer_periodicity",
      "summary": "Test to check timer periodicity."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-remaining",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate countdown of time to expiration\n\nStarts a timer, busy-waits for half the DURATION, then checks the remaining time to expiration and stops the timer. The remaining time should reflect the passage of at least the busy-wait interval.\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_stop()\n\n*See also:* k_timer_remaining_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_remaining"
        }
      ],
      "name": "timer_api__test_timer_remaining",
      "summary": "Test accuracy of k_timer_remaining_get()."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-restart",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validates initial duration and period of timer. Start the timer with specific duration and period. Then starts the timer again, and check the status of timer.\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_stop()\n\n*See also:* k_uptime_get()\n\n*See also:* k_busy_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_restart"
        }
      ],
      "name": "timer_api__test_timer_restart",
      "summary": "Test restart the timer."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-status-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Timer test to validate timer status and next trigger expiry time\n\nIt initializes the timer with k_timer_init(), then starts the timer using k_timer_start() and checks for timer current status with k_timer_status_get() and remaining time before next expiry using k_timer_remaining_get(). Stops the timer using k_timer_stop().\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_status_get()\n\n*See also:* k_timer_remaining_get()\n\n*See also:* k_timer_stop()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_status_get"
        }
      ],
      "name": "timer_api__test_timer_status_get",
      "summary": "Test Timer status and time remaining before next expiry."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-status-get-anytime",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate timer status function using k_timer_status_get().\n\nIt initializes the timer with k_timer_init(), then starts the timer using k_timer_start() with specific initial duration and period. Checks for timer status randomly after certain duration. Stops the timer using k_timer_stop().\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_status_get()\n\n*See also:* k_timer_stop()\n\n*See also:* k_busy_wait()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_status_get_anytime"
        }
      ],
      "name": "timer_api__test_timer_status_get_anytime",
      "summary": "Test Timer status randomly after certain duration."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-status-sync",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate thread synchronization by blocking the calling thread until the timer expires.\n\nIt initializes the timer with k_timer_init(), then starts the timer using k_timer_start() and checks timer status with k_timer_status_sync() for thread synchronization with expiry count. Stops the timer using k_timer_stop.\n\n*See also:* k_timer_init()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_status_sync()\n\n*See also:* k_timer_stop()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "timer_api__test_timer_status_sync"
        }
      ],
      "name": "timer_api__test_timer_status_sync",
      "summary": "Test Timer thread synchronization."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/timer-api--test-timer-user-data",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Validate user-specific data associated with timer\n\nIt creates prototype of K_TIMER_DEFINE and starts the timer using k_timer_start() with specific initial duration, along with associated user data using k_timer_user_data_set and k_timer_user_data_get(). Stops the timer using k_timer_stop() and checks for correct data retrieval after timer completion.\n\n*See also:* K_TIMER_DEFINE()\n\n*See also:* k_timer_user_data_set()\n\n*See also:* k_timer_start()\n\n*See also:* k_timer_user_data_get()\n\n*See also:* k_timer_stop()",
