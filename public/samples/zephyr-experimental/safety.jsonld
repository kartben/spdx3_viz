    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-27-10",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism for a thread to wait until any of a specified set of events is tracked by an event object.",
