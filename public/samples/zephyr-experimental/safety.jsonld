      "summary": "Work item submission from threads and interrupt service routines"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-13",
      "requirementStatement": "When the work queue thread removes a work item from the queue, the work queue thread shall invoke that work item's handler function.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
