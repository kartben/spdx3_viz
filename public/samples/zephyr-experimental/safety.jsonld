      "summary": "Resubmission of an already queued work item"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-26-15",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism to wait until a submitted work item has been processed by its work queue.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
