    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-1",
      "requirementStatement": "The Zephyr RTOS shall support operation on more than one physical CPU sharing the same kernel state.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-1"
        }
      ],
      "name": "ZEP-SRS-34-1: Support operation on more than one CPU",
      "summary": "Support operation on more than one CPU"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-10",
      "requirementStatement": "Where symmetric multiprocessing is enabled, the Zephyr RTOS shall schedule the highest-priority ready threads to run concurrently across the available CPUs.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-10"
        }
      ],
      "name": "ZEP-SRS-34-10: Concurrent scheduling across CPUs",
      "summary": "Concurrent scheduling across CPUs"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-11",
      "requirementStatement": "When a scheduling change makes a thread eligible to run on a different CPU, the Zephyr RTOS shall signal that CPU to perform a reschedule, by an inter-processor interrupt where the hardware supports it.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-11"
        }
      ],
      "name": "ZEP-SRS-34-11: Inter-processor reschedule signaling",
      "summary": "Inter-processor reschedule signaling"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-12",
      "requirementStatement": "Where CPU affinity is enabled, the Zephyr RTOS shall provide a mechanism to pin a thread so that it runs on a single specified CPU.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-12"
        }
      ],
      "name": "ZEP-SRS-34-12: Pinning a thread to a CPU",
      "summary": "Pinning a thread to a CPU"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-13",
      "requirementStatement": "The Zephyr RTOS shall allow a thread's CPU affinity to be modified only while the thread is not runnable.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-13"
        }
      ],
      "name": "ZEP-SRS-34-13: Restriction on changing CPU affinity",
      "summary": "Restriction on changing CPU affinity"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-14",
      "requirementStatement": "Where deferred secondary CPU boot is enabled, the Zephyr RTOS shall not bring up the secondary CPUs during kernel initialization, leaving them to be started later at run time.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-14"
        }
      ],
      "name": "ZEP-SRS-34-14: Deferred secondary CPU boot",
      "summary": "Deferred secondary CPU boot"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-15",
      "requirementStatement": "Where single-CPU pin-only affinity is enabled, the Zephyr RTOS shall restrict each thread to run on a single assigned CPU.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-15"
        }
      ],
      "name": "ZEP-SRS-34-15: Single-CPU pin-only affinity",
      "summary": "Single-CPU pin-only affinity"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-16",
      "requirementStatement": "Where optimized inter-processor reschedule signaling is enabled, when a thread becomes ready to run the Zephyr RTOS shall signal only those CPUs that need to reschedule in response.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-16"
        }
      ],
      "name": "ZEP-SRS-34-16: Selective inter-processor reschedule signaling",
      "summary": "Selective inter-processor reschedule signaling"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-17",
      "requirementStatement": "Where the architecture supports directed inter-processor interrupts, the Zephyr RTOS shall send a reschedule signal to a specific target CPU instead of broadcasting it to all other CPUs.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-17"
        }
      ],
      "name": "ZEP-SRS-34-17: Directed inter-processor reschedule signaling",
      "summary": "Directed inter-processor reschedule signaling"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-18",
      "requirementStatement": "When a thread restricted by its CPU affinity to a subset of CPUs preempts a thread on one CPU, the Zephyr RTOS shall issue the additional reschedule signals needed for the highest-priority runnable threads to be selected across all CPUs.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-34-18"
        }
      ],
      "name": "ZEP-SRS-34-18: Reschedule signaling for affinity-constrained threads",
      "summary": "Reschedule signaling for affinity-constrained threads"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-34-19",
      "requirementStatement": "Where coherent memory placement is enabled on a cache-incoherent multiprocessor, the Zephyr RTOS shall place shared kernel data in cache-coherent memory.",
