    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-25-15",
      "requirementStatement": "When multiple threads of equal priority are waiting on an empty mailbox object, the Zephyr RTOS shall deliver the next message to the thread that has waited the longest.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-25-15"
        }
      ],
