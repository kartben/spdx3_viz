    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/poll-api--test-poll-signal-persist",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Raise a poll signal and verify it stays in the signaled state: it is reported signaled by k_poll_signal_check(), and because a signal is not consumed by polling it remains ready across repeated k_poll() calls. Only after k_poll_signal_reset() does it return to the unsignaled state.\n\n*See also:* k_poll_signal_raise(), k_poll_signal_check(), k_poll_signal_reset()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "poll_api__test_poll_signal_persist"
        }
      ],
      "name": "poll_api__test_poll_signal_persist",
