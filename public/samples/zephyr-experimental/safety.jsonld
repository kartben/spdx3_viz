          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mem_protect_kobj__test_create_new_thread_from_user_no_access_stack"
        }
      ],
      "name": "mem_protect_kobj__test_create_new_thread_from_user_no_access_stack",
