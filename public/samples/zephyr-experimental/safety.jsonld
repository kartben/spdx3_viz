          "identifier": "ZEP-SRS-1-27"
        }
      ],
      "name": "ZEP-SRS-1-27: Querying thread stack usage",
      "summary": "Querying thread stack usage"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-1-28",
      "requirementStatement": "Where thread runtime statistics are enabled, the Zephyr RTOS shall provide a mechanism to query per-thread runtime usage statistics.",
      "creationInfo": "zephyr:creationinfo",
