        }
      ],
      "name": "ZEP-SRS-1-25: Releasing a run-time allocated thread stack",
      "summary": "Releasing a run-time allocated thread stack"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-1-26",
      "requirementStatement": "Where thread monitoring is enabled, the Zephyr RTOS shall provide a mechanism to iterate over all threads in the system, invoking a caller-supplied function for each thread.",
