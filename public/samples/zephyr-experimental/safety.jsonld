        }
      ],
      "name": "threads_scheduling__test_sleep_wakeup_preemptible",
      "summary": "Validate k_wakeup()."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-scheduling--test-slice-perthread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "With CONFIG_TIMESLICE_PER_THREAD, a thread's individual time slice (k_thread_time_slice_set()) must expire after the configured number of ticks and invoke the registered expiry callback, which here suspends the thread. Requires CONFIG_TIMESLICING and CONFIG_TIMESLICE_PER_THREAD; otherwise the test skips.\n\nTest steps:\n\n- Create a busy-looping thread and set a per-thread slice with a callback.\n- Tick-align and start the thread.\n- Wait for the callback (which suspends the thread) and confirm it stopped.\n\nExpected result:\n\n- The per-thread slice expires, the callback runs, and the thread is suspended.\n\n*See also:* k_thread_time_slice_set()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "threads_scheduling__test_slice_perthread"
        }
      ],
      "name": "threads_scheduling__test_slice_perthread",
      "summary": "Verify a per-thread time slice expires and invokes its callback."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-scheduling--test-slice-reset",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Create multiple preemptive threads with few different priorities and few with same priorities and enable the time slice. Ensure that each thread is given the time slice period to execute.\n\nSkipped when CONFIG_TIMESLICING is disabled.\n\n*See also:* k_sched_time_slice_set(), k_sem_reset(), k_cycle_get_32(), k_uptime_get_32()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "threads_scheduling__test_slice_reset"
        }
      ],
      "name": "threads_scheduling__test_slice_reset",
      "summary": "Check the behavior of preemptive threads when the time slice is disabled and enabled."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/threads-scheduling--test-slice-scheduling",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Create multiple preemptive threads with same priorities and few with same priorities and enable the time slice. Ensure that each thread is given the time slice period to execute.\n\nSkipped when CONFIG_TIMESLICING is disabled.\n\n*See also:* k_sched_time_slice_set()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
