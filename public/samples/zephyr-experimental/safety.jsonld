      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "- Create a helper thread.\n- Busy loop for 2 ticks. Idle time should not increase.\n- Sleep for two ticks. Helper executes and busy loops. Idle time should not increase\n- Kill helper thread, and sleep for 2 ticks Idle time should increase\n- Busy loop for 3 ticks Idle time should not increase current, peak and average cycles should be different",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "usage_api__test_all_stats_usage"
        }
      ],
      "name": "usage_api__test_all_stats_usage",
      "summary": "Test the k_threads_runtime_stats_all_get() API."
    },
