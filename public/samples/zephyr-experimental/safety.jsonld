    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mheap-api--test-mheap-calloc",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test validates k_calloc() API. When requesting a huge size of space or a space larger than heap memory, the API will return NULL. The 8 blocks of memory of size 16 bytes are allocated by k_calloc() API. When allocated using k_calloc() the memory buffers have to be zeroed. Check is done, if the blocks are memset to 0 and read/write is allowed. The test is then teared up by freeing all the blocks allocated.\nSee also: k_calloc()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mheap_api__test_mheap_calloc"
        }
      ],
      "name": "mheap_api__test_mheap_calloc",
      "summary": "Test to demonstrate k_calloc() API functionality."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/mheap-api--test-mheap-malloc-align4",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The 8 blocks of memory of size 16 bytes are allocated by k_calloc() API. When allocated using k_calloc() the memory buffers have to be zeroed. Check is done, if the blocks are memset to 0 and read/write is allowed. The test is then teared up by freeing all the blocks allocated.\nSee also: k_malloc(), k_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "mheap_api__test_mheap_malloc_align4"
        }
      ],
      "name": "mheap_api__test_mheap_malloc_align4",
      "summary": "The test validates k_calloc() API."
    },
