    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-k-heap-alloc-pending",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "In main thread alloc a buffer from the heap, then run the child thread. If there isn't enough space in the heap, the child thread will wait timeout long until main thread free the buffer to heap.\nSee also: k_heap_alloc()\nSee also: k_heap_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_k_heap_alloc_pending"
        }
      ],
      "name": "k_heap_api__test_k_heap_alloc_pending",
      "summary": "Validate the k_heap support wait between different threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-k-heap-alloc-pending-null",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "In main thread alloc two buffer from the heap, then run the child thread which alloc a buffer larger than remaining space. The child thread will wait timeout long until main thread free one of the buffer to heap, space in the heap is still not enough and then return null after timeout.\nSee also: k_heap_alloc()\nSee also: k_heap_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_k_heap_alloc_pending_null"
        }
      ],
      "name": "k_heap_api__test_k_heap_alloc_pending_null",
      "summary": "Validate the k_heap alloc_pending_null support."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-k-heap-alloc-size",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Parameterized over a range of block sizes: sizes within HEAP_SIZE must allocate successfully and survive a write/read-back of a fill pattern; sizes beyond heap capacity must return NULL. Each (size, expectation) pair is reported as a separate named Twister case, so a failure pinpoints the exact size rather than a single aggregate result.\nTest steps:\n- Read the current (size, expect_success) parameter pair.\n- Call k_heap_alloc() for that size.\n- On a success case: assert non-NULL, write a per-byte pattern, read it back to confirm no corruption, then free the block.\n- On a failure case: assert the call returned NULL.\nExpected result:\n- In-capacity sizes allocate, preserve data, and free cleanly.\n- Over-capacity sizes return NULL.\nSee also: k_heap_alloc()\nSee also: k_heap_free()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "k_heap_api__test_k_heap_alloc_size"
        }
      ],
      "name": "k_heap_api__test_k_heap_alloc_size",
      "summary": "Verify k_heap_alloc() succeeds within capacity and fails beyond it."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/k-heap-api--test-k-heap-array-get",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "The test ensures that valid values are returned\nSee also: k_heap_array_get()",
