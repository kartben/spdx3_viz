          "externalIdentifierType": "other",
          "identifier": "queue_api__test_queue_alloc_append_null"
        }
      ],
      "name": "queue_api__test_queue_alloc_append_null",
      "summary": "Test k_queue_alloc_append() failure scenario."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-queue-alloc-append-user",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Appending items adds each to the tail, so reading the queue back returns them in insertion (FIFO) order. Exercised from a user-mode thread on an allocated queue object.\nTest steps:\n- Alloc-append a sequence of items 0..N-1 from a user thread.\n- Get all items and verify they come out in insertion order (0..N-1).\nExpected result:\n- Items are returned oldest-first (FIFO).\nSee also: k_queue_alloc_append()\nSee also: k_queue_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "queue_api__test_queue_alloc_append_user"
        }
      ],
      "name": "queue_api__test_queue_alloc_append_user",
      "summary": "Verify k_queue_alloc_append() yields FIFO order from user mode."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-queue-alloc-prepend-null",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Verify that the parameter of the API is NULL, what will happen.\nSee also: k_queue_alloc_prepend()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "queue_api__test_queue_alloc_prepend_null"
        }
      ],
      "name": "queue_api__test_queue_alloc_prepend_null",
      "summary": "Test k_queue_alloc_prepend() failure scenario."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-queue-alloc-prepend-user",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Prepending items pushes each to the front, so reading the queue back returns them in reverse insertion (LIFO) order. Exercised from a user-mode thread on an allocated queue object.\nTest steps:\n- Alloc-prepend a sequence of items 0..N-1 from a user thread.\n- Get all items and verify they come out in reverse order (N-1..0).\nExpected result:\n- Items are returned newest-first (LIFO).\nSee also: k_queue_alloc_prepend()\nSee also: k_queue_get()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "queue_api__test_queue_alloc_prepend_user"
        }
      ],
      "name": "queue_api__test_queue_alloc_prepend_user",
      "summary": "Verify k_queue_alloc_prepend() yields LIFO order from user mode."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/queue-api--test-queue-append-list-error",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "According to the API k_queue_append_list to design some error condition to verify error branch of the API.\n- Verify that the list's head is empty.\n- Verify that the list's tail is empty.\n- Verify that append list to the queue when a sub-thread is waiting for data.\nSee also: k_queue_append_list()",
