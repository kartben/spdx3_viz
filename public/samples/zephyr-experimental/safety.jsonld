        }
      ],
      "name": "ZEP-SRS-27-10: Waiting for any of a set of events",
      "summary": "Waiting for any of a set of events"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-27-11",
      "requirementStatement": "The Zephyr RTOS shall provide a mechanism for a thread to wait until all of a specified set of events are tracked by an event object.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
