    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/semaphore--test-sem-thread2isr",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A semaphore is given from interrupt context and taken from thread context, exercising both a run-time initialized semaphore and a compile-time defined one, to confirm a semaphore can be used to synchronize across the thread/ISR boundary.\nTest steps:\n- Initialize a semaphore at run time and give it from an ISR.\n- Take it from the thread and verify synchronization.\n- Repeat with a compile-time K_SEM_DEFINE() semaphore.\nExpected result:\n- The thread and ISR synchronize correctly using either semaphore.\nSee also: k_sem_init(), K_SEM_DEFINE(x)",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "semaphore__test_sem_thread2isr"
        }
      ],
      "name": "semaphore__test_sem_thread2isr",
      "summary": "Verify a semaphore synchronizes a thread with an ISR."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/semaphore--test-sem-thread2thread",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "A semaphore is used to hand off execution between two threads, exercising both a run-time initialized semaphore (k_sem_init()) and a compile-time defined one (K_SEM_DEFINE()). One thread gives the semaphore while the other takes it, confirming that a run-time defined semaphore is usable for synchronization.\nTest steps:\n- Initialize a semaphore at run time with k_sem_init().\n- Hand off between two threads via k_sem_give()/k_sem_take().\n- Repeat the hand off using a compile-time K_SEM_DEFINE() semaphore.\nExpected result:\n- Both threads synchronize correctly using either semaphore.\nSee also: k_sem_init(), K_SEM_DEFINE(x)",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "semaphore__test_sem_thread2thread"
        }
      ],
      "name": "semaphore__test_sem_thread2thread",
      "summary": "Verify a semaphore synchronizes two threads."
    },
    {
      "type": "functionalsafety_RequirementVerification",
      "spdxId": "zephyr:verifications/semaphore-1cpu--test-sem-multiple-take-and-timeouts",
      "functionalsafety_verificationMethod": [
        "spdx:FunctionalSafety/VerificationType/test"
      ],
      "creationInfo": "zephyr:creationinfo",
      "description": "Several threads block on the same semaphore with different timeouts. With none of them ever given the semaphore, they must time out (-EAGAIN) in ascending order of their timeout values; the observed order is recorded via a pipe and checked.\nTest steps:\n- Start threads that each take the semaphore with a distinct timeout.\n- Record each thread's timeout value as it expires.\n- Compare the expiry order against the expected ascending order.\nExpected result:\n- Threads time out with -EAGAIN in increasing timeout order.\nSee also: k_sem_take(), k_sem_reset()",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "ztest case",
          "externalIdentifierType": "other",
          "identifier": "semaphore_1cpu__test_sem_multiple_take_and_timeouts"
        }
      ],
      "name": "semaphore_1cpu__test_sem_multiple_take_and_timeouts",
      "summary": "Verify threads waiting on one semaphore time out in timeout order."
    },
    {
