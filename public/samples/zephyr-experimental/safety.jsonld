      "summary": "Semaphore acquisition mechanism"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-5-7",
      "requirementStatement": "While the semaphore's count is greater than zero, the requesting thread shall acquire\nthe semaphore and decrement its count.",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "comment": "StrictDoc requirement UID",
          "externalIdentifierType": "other",
          "identifier": "ZEP-SRS-5-7"
        }
      ],
      "name": "ZEP-SRS-5-7: Semaphore acquisition with count greater than zero",
      "summary": "Semaphore acquisition with count greater than zero"
    },
    {
      "type": "Requirement",
      "spdxId": "zephyr:requirements/ZEP-SRS-5-8",
      "requirementStatement": "While the semaphore's count is zero, the requesting thread shall be blocked until the semaphore is released by another thread.",
