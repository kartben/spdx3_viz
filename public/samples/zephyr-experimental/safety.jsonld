      ],
      "name": "Twister",
      "summary": "Zephyr twister test runner"
    },
    {
      "type": "Tool",
      "spdxId": "zephyr:tools/west-spdx",
      "creationInfo": "zephyr:creationinfo",
      "externalIdentifier": [
        {
          "type": "ExternalIdentifier",
          "externalIdentifierType": "packageUrl",
          "identifier": "pkg:generic/zephyr-spdx-builder@4.4.99"
        }
