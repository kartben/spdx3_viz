{
  "name": "spdx3-viz",
  "version": "0.6.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test",
    "pretest:coverage": "node -e \"require('node:fs').mkdirSync('coverage',{recursive:true})\"",
    "test:coverage": "node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "gen:icons": "node scripts/gen-node-icons.mjs",
    "gen:changelog": "node scripts/gen-changelog.mjs",
    "measure:nvd": "node --max-old-space-size=8192 scripts/measure-nvd-index.mjs",
    "measure:cve": "node --max-old-space-size=8192 scripts/measure-cve-affected-index.mjs",
    "build:cve-affected": "node --max-old-space-size=8192 scripts/build-cve-affected-index.mjs",
    "gen:functional-safety-sample": "node scripts/gen-functional-safety-sample.mjs",
    "gen:supply-chain-sample": "node scripts/gen-supply-chain-sample.mjs",
    "gen:paper-plane-sample": "node scripts/gen-paper-plane-sample.mjs"
  },
  "dependencies": {
    "@alpinejs/collapse": "^3.14.0",
    "alpinejs": "^3.14.0",
    "d3-color": "^3.1.0",
    "d3-drag": "^3.0.0",
    "d3-force": "^3.0.0",
    "d3-quadtree": "^3.0.1",
    "d3-selection": "^3.0.0",
    "d3-shape": "^3.2.0",
    "d3-transition": "^3.0.1",
    "d3-zoom": "^3.0.0",
    "highlight.js": "^11.11.1",
    "mermaid": "^11.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@material-design-icons/svg": "^0.14.15",
    "@material-symbols/svg-400": "^0.45.5",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.8.4",
    "svgpath": "^2.6.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.2"
  }
}
